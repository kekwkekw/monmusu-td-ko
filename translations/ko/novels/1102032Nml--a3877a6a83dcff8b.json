    {
      "command": "",
      "draft_row_sha256": "c82b9bd0e28ac4bb888c2764cd7d7232a914ecda96fe1abc452f5796bd2e7c25",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "んなもん、たまたま洞窟の中に落っこちてきたときに、　　　　　みょうちきりんな岩にひっかかってただけじゃん！　そこにお前が\n総統が来てくださったとか言ってたからノリを合わせただけじゃん！　",
