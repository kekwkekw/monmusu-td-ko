    {
      "command": "",
      "draft_row_sha256": "4017d098b215b9e75928ea2db6fa5296e4441c5593ff660ad22fe74ca8d12513",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "うわ～ん、もうすぐ年が明けるのに\nこんなじめじめしたところにいてごめんなさい！！\nこんなキノコ女、おみくじも凶ですよね！！",
      "jp_sha256": "793787305db541e70b1f4dca7fe24eab28a6bce802797d9de20d3a5ddd3f196f",
      "kind": "dialogue",
      "ko": "으아앙, 곧 새해가 밝는데\n이런 축축한 곳에 있어서 죄송해요!!\n이런 버섯 여자는 오미쿠지도 흉이겠죠!!",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 37,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b016-20261109-0cc9675e465a",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "4c483cb9ca35ff4092e105850fa1ccd48d434380c918afcb981ecf44c8e357fe:000002_488355142422993287:g0:r36",
      "row_index_0based": 36,
      "serialized_row_index": 36,
      "source_cells": [
