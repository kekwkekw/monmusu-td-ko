      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "シジメの住処はこの辺りですからね。\n本当に不運としか――。",
      "jp_sha256": "31bde539f87213ca18309c947005dbde59015ced279a42406a93a54868abadaa",
      "kind": "dialogue",
      "ko": "시지메의 거처는 이 근처니까요.\n정말 불운했다고밖에는――.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 46,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
