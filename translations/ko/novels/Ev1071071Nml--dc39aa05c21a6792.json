      "row_index_0based": 8,
      "serialized_row_index": 8,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "あ、危なかった……！\nもう少しで凶のおみくじを受け取るところでした。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
