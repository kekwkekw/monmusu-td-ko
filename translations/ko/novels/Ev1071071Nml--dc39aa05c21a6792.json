    {
      "command": "",
      "draft_row_sha256": "0b7ace15b670b72dd79d0b88d76a15405b4fe8cf8758d5f19405a1a98eecd2b9",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
