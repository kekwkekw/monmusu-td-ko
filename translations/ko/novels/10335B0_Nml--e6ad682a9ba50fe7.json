      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "う……先生。\nだめ、今のわたしに近づいちゃ……。",
      "jp_sha256": "af97942364647c37f5f7654adf42eb820bf8c02f1b44021496c00680d3658a3f",
      "kind": "dialogue",
      "ko": "으…… 선생님.\n안 돼, 지금 내게 가까이 오면…….",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 9,
