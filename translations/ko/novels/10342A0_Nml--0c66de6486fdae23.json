      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あれ、今日は１発で僕のことがわかりましたね。\n前は勘違いして岩に話しかけていたのに。",
      "jp_sha256": "da3ad9b2ed8a92a40621dea2b2288683c5ed5de554a64a305c6329be1658210e",
      "kind": "dialogue",
      "ko": "어라, 오늘은 한 번에 저인 줄 아셨네요.\n전에는 착각해서 바위에 말을 거셨는데.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 23,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b008-20261106-451bb6a2fb2c21c5",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "dc8b9cd21e27bbb582b9ece2aebb9f0524bed2e74ccf8e54bb07ea8b07f725c5:000002_7336031546730644735:g0:r22",
      "row_index_0based": 22,
      "serialized_row_index": 22,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "あれ、今日は１発で僕のことがわかりましたね。\n前は勘違いして岩に話しかけていたのに。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "9fa6beb8b22a5067008422767c1a5db1effc9d8ee699cf8289c149e2975fe3e8",
