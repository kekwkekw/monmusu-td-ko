      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ええそうよ！　刺激的なこのお口、実はちょっと、\n変わったことがあるのよぉ。",
      "jp_sha256": "93a7ab05ce2c693f49fb84657c8aa44c33ff7d0f597bd7b66a3bdcb19fca4163",
      "kind": "dialogue",
      "ko": "그래, 맞아! 자극적인 이 입은 사실 조금\n달라진 점이 있단다.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 33,
