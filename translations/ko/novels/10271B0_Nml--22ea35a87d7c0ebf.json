      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ビーチバレーも楽しいけれど、\nずっと浜辺にいると体温が上がって来てしまうわね。",
      "jp_sha256": "5ab961786fa3accebd726eb364073b6083b4c9eb6461f053d21f2a2469c1f0bf",
      "kind": "dialogue",
      "ko": "비치발리볼도 즐겁지만\n계속 해변에 있으니 체온이 올라오네.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 20,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
