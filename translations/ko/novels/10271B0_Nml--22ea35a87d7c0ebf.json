      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "う、ううぅ……あまり見ないでもらえるかしら。\n今、すっごい不格好になってしまっているから……。",
      "jp_sha256": "9aed2a04509ee6f4e03046d947562aebef88a5fcdc92289f7f59c4f257940406",
      "kind": "dialogue",
      "ko": "으, 으으……너무 보지 말아 줄래?\n지금 굉장히 볼품없는 꼴이 됐으니까…….",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 78,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
