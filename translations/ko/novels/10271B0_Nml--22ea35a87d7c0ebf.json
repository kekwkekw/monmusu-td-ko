      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "意外ですね……。\n泳ぎがこんなにも苦手だなんて。",
      "jp_sha256": "2b6422ef5742530fcac64dfaf62a6f27be7fb28e432312e24803bd3f9583de90",
      "kind": "dialogue",
