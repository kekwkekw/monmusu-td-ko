      "kind": "dialogue",
      "ko": "하지만 그러려면 다른 몬스터 소녀들이\n비밀로 감춘 비문의 내용이 필요했다.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 15,
