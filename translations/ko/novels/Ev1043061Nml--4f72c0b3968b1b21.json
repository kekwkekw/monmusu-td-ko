      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "まあ、そう結論を急ぐものでないぞ、ご主人クン。\n何事にも順序というものがあるからな。",
      "jp_sha256": "a738bd1ba9955a0f927b866c6e83aa6ca19b57b6891647d20ad41fd77a003f79",
      "kind": "dialogue",
      "ko": "그렇게 성급히 결론을 내리지 말게, 주인 군.\n무슨 일이든 순서가 있는 법이니까.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 9,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
