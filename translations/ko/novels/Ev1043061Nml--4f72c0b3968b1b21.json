      "jp": "まずはリッチクンの考察とやらを聞こうじゃないか。",
      "jp_sha256": "7569286f4a3b8526d9e06892b93aa28905f2f87bdce030a395a3c7426eb591c8",
      "kind": "dialogue",
      "ko": "우선 리치 군의 고찰이라는 걸 들어 보자고.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 10,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
