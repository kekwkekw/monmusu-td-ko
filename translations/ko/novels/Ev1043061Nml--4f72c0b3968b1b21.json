      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "少年に碑文を解読させる、もしくは、その内容を伝えることで、\n不老不死が完成する、というのは……、\nただの憶測に過ぎませんかな？",
      "jp_sha256": "ca1619bcec84b6e31bfea6a68eec055bab04a41dea926b626a904583bb6719cf",
      "kind": "dialogue",
      "ko": "소년에게 비문을 해독하게 하거나 그 내용을 전함으로써\n불로불사가 완성된다는 건……,\n그저 억측에 불과합니까?",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 16,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
      "review_note": "",
      "review_status": "reviewed",
