      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "その通りです。まずは今、島中に散らばってしまっている\nヴェラートゥたちとも合流し、全員の意見をまとめてから\nどうするのかを考えても遅くないのでは？",
      "jp_sha256": "8c8af4e15a639f0045b5b6d073124ab4d11300a20a11861370ad05adfe5af7a5",
      "kind": "dialogue",
      "ko": "맞습니다. 우선 지금 섬 곳곳에 흩어진\n베라투 일행과도 합류하고, 전원의 의견을 정리한 뒤\n어떻게 할지 생각해도 늦지 않지 않을까요?",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 20,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "d0da4d841d10f35446596017e52f89948aa4f452553886cda1a7f73d768baef3:000002_3193305989811870905:g0:r19",
      "row_index_0based": 19,
      "serialized_row_index": 19,
      "source_cells": [
