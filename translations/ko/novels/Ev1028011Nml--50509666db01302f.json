      ],
      "speaker": "ビビ神",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "a86dace2cd8cfc9a855d5e580de9c9580e09c9c3d90f281b67fb46837d05e41c",
