      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "16609d8f04e9a01ee35c6d74c7ea5bf9bafc17e11785f7eed1cf31c3df4c9554",
