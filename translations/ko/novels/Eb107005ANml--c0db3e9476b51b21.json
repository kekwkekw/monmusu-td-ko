      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "な、なんでペロロスさんが、\nあの２人の間で、不穏な歌を唄って……。",
      "jp_sha256": "11e11b553f58b7519e528c7a78e9a26de1ee341764036645ad18f6ccd009d07c",
      "kind": "dialogue",
      "ko": "왜, 왜 페로로스 씨가,\n저 두 사람 사이에서 불길한 노래를…….",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 22,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b013-20261109-same-model-pass2-5adf61fa",
