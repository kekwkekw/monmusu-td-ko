      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "このまま放っておくと、\n２人はバチバチにやり合っちゃうかもしれないんだよ。\nクリスマスが血の惨劇になっちゃうんだよ。",
      "jp_sha256": "f9a3b5a8b31aac1535620868acc964a421e128686b4223738431f49b2384c94e",
      "kind": "dialogue",
      "ko": "이대로 내버려 두면,\n둘이 불꽃 튀게 싸울지도 몰라.\n크리스마스가 피의 참극이 될 거야.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 30,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
