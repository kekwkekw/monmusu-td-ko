      "review_status": "reviewed",
      "row_id": "7591dffdba224ef54a1fc5c6fe4ce3d6e0e4907e499c92ad6a17616080215bc4:000000_-8513998060070046391:g0:r8",
      "row_index_0based": 8,
      "serialized_row_index": 8,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "地図だとこの辺りで間違いなさそうだけど……。\n……うわっ！？　これは……？"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "e374a2d94d850e2c7222a18075f77fa5ca85b7cee5989425ad63394a0c08bcfe",
      "grid_index": 0,
      "grid_message_index_0based": 2,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "木々をかき分けて進むと広場のような場所に出た。\nそこには木製の人形のようなものや、\n金属の重りのようなものがたくさん並んでいる。",
      "jp_sha256": "8b37a7ee98a120057e098825e234d050f76a60873f32f8172470ba64443ebf07",
      "kind": "dialogue",
      "ko": "나무들을 헤치고 나아가자 광장 같은 곳이 나왔다.\n그곳에는 나무 인형 같은 것과,\n금속 추 같은 것이 잔뜩 늘어서 있었다.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
