      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "主！　これから貴様を徹底的に鍛える！\nこの島の守護者に相応しい力をつけてもらうためにな！",
      "jp_sha256": "244675d858c31dd350cc240b17aea2168409e99798d921b4c25c3e95c107e08d",
      "kind": "dialogue",
      "ko": "주인! 지금부터 네놈을 철저히 단련한다!\n이 섬의 수호자에게 어울리는 힘을 갖추게 하려고 말이지!",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 18,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
