      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ええと、レティアさん。ここは何なんです？\nというか、ここに呼び出した用件は一体……？",
      "jp_sha256": "5c92b7ac7d5bc8439af2c853b51dd1f8235efa9c8f83bfe866313aa687f1279c",
      "kind": "dialogue",
      "ko": "저기, 레티아 씨. 여기는 뭐 하는 곳이에요?\n그보다 저를 여기로 부른 용건은 대체……?",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 16,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
