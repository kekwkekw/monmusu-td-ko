      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "早速ネガティブなことばかり言うルルクアさん。\n深海の引きこもり系モンスター娘の中でも、\n特に彼女は酷いと聞いたのでよかれと思って誘ったんだけど――。",
      "jp_sha256": "064edcd9fcf54291d7301541194233f58a9a39f37edb7005e11b8f331d12d59d",
      "kind": "dialogue",
      "ko": "루루쿠아 씨는 시작부터 부정적인 말만 했다.\n심해의 은둔형 몬스터 소녀 중에서도,\n특히 그녀는 심하다고 들어서 잘되라고 권한 건데――.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 26,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
