    {
      "command": "",
      "draft_row_sha256": "432e9b42f365d77670bf25bc86f876d84949b99f1072068de35ed1f207c8943d",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ちょっとだけ！　さきっちょだけですわ！\nあぁ、ここの見開き、センス爆発しすぎですわ……！！",
      "jp_sha256": "7798f72de85bef98465b8c2f0090cc6e7ff021d0479ee1ba7a296ce9c5c0f2e4",
      "kind": "dialogue",
      "ko": "조금만! 끝부분만 볼게요!\n아아, 여기 펼침면은 센스가 너무 폭발했어요……!!",
      "message_index_0based": 10,
