      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "深海ネット掲示板で見た情報より遙かに凶悪……！\nああ、やはり地上なんて出てくるべきじゃなかったですわ……！",
      "jp_sha256": "1f2646a69c6b75f74553d9df6fff0d5f0ee714589848b001f80d012b0fa0f68a",
      "kind": "dialogue",
      "ko": "심해 인터넷 게시판에서 본 정보보다 훨씬 흉악해요……!\n아아, 역시 지상 따위로 나오는 게 아니었어요……!",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 25,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
