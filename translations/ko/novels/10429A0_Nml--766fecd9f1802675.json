      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あ、あの、ルルクアさん？\nせっかく外に来たのに、あまり本ばかり読んでいるのも……。",
      "jp_sha256": "903679f88f7e6ca4d1d3091d26c8c4a4326905ba6db1c0a2fa20c176dfc4f9fe",
      "kind": "dialogue",
      "ko": "저, 저기, 루루쿠아 씨?\n모처럼 밖에 나왔는데 책만 읽는 것도 조금…….",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 40,
