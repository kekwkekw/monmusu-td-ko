        "",
        "",
        ""
      ],
      "speaker": "デイン",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "61edb38c0414e380f0d1918a96b311262aa863c1e563edc5c2cdde16281c4f3f",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なっ、なんですの！\n姫様がわざわざ持ってきましたのに無礼ではありませんこと！？",
      "jp_sha256": "c27df97edf436cfe21bc2737a91fe9e58efe9fd23e70955c1b3e462080d4f4f2",
      "kind": "dialogue",
      "ko": "뭐, 무엇이옵니까!\n공주님께서 친히 가져오셨는데 무례하지 않사옵니까!?",
      "message_index_0based": 11,
