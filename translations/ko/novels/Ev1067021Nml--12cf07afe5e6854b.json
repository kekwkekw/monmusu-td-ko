      "row_index_0based": 8,
      "serialized_row_index": 8,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "……うーん、絞ってジュースにするなら、\nもっと数が要りますよね。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "c57a1db071bf41ca6fdd4e37529e4783bef0f20c50f7a3091b7cb609d0e23150",
      "grid_index": 0,
      "grid_message_index_0based": 2,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ええ、全然足りませんね。\nこれだと飲むどころか、ちょろっと舐めて終わりです。",
      "jp_sha256": "7a6ed9170ec5d87204bf5a14b0545737bfa28f19440f9b6f349c86397418bbd1",
      "kind": "dialogue",
      "ko": "네, 전혀 부족합니다.\n이래서는 마시기는커녕 살짝 핥고 끝이겠군요.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 10,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
