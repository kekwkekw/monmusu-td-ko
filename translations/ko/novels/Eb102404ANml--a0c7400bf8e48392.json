    {
      "command": "",
      "draft_row_sha256": "78ed5365ff46e5a58beb3c0a8a8446fbb4b7599b31433fde510c721790969fab",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なんて情けない姿でしょうか、ご主人さま。\nたかが尻尾にこうもあっさり陥落するとは。\n私の猫しっぽではご不満なのですね。",
      "jp_sha256": "a8ac139c9ef3bf5af566713152f01c93f156b5063304dc3dbb7fc4d73aadf779",
      "kind": "dialogue",
      "ko": "얼마나 한심한 모습인가요, 주인님.\n고작 꼬리에 이렇게도 쉽게 함락되다니.\n제 고양이 꼬리로는 불만인 거군요.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 21,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
      "review_status": "reviewed",
