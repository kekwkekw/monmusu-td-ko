    {
      "command": "",
      "draft_row_sha256": "3f75c31d69ca38e611bcb8446792944f46e1a94f974969d5910f41371ee646fe",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なんという体たらくでしょうか、ご主人さま。\nどんなモンスター娘もよりどりみどりのあなたが、\nまさかたった２本の尻尾にだらしなくおねだりなど……。",
      "jp_sha256": "5ea523644e2901cf33f246c12f5f3e12f1b31f62ac493e0de820a15b14ecbbe5",
      "kind": "dialogue",
      "ko": "얼마나 한심한 꼴인가요, 주인님.\n어떤 몬스터 소녀든 골라잡을 수 있는 당신이,\n설마 고작 꼬리 두 개에 흐물흐물 조르다니…….",
      "message_index_0based": 11,
      "page_ctrl": "",
      "physical_line_1based": 30,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
