      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "75b08da335242d6e6a07a9a359db29fe1ddd3cd2b60dea86a0e4e192178c5c90",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ふわぁ……尻尾……ふわふわ……ハッ！\nいやいやいや、僕は撫でられたりなんかしません。\nこれは病気なんです、きつねさん。正気に戻ってください！",
      "jp_sha256": "a14347f29b6107b9bbe90c71b357f8e9ab60bc592c80166251bf725f0a2ed84f",
      "kind": "dialogue",
      "ko": "후와아…… 꼬리…… 푹신푹신…… 핫!\n아니 아니 아니, 전 쓰다듬어지지 않을 거예요.\n이건 병이에요, 여우 씨. 제정신으로 돌아오세요!",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "3520dc9eed07d389246edae558e80a62f1181d9e6f9c03798d91c76f1e197e02:000000_-5915064980826486612:g0:r12",
      "row_index_0based": 12,
      "serialized_row_index": 12,
      "source_cells": [
        "",
        "",
        "主人公",
        "<Off>",
        "",
        "",
        "",
        "",
        "",
        "ふわぁ……尻尾……ふわふわ……ハッ！\nいやいやいや、僕は撫でられたりなんかしません。\nこれは病気なんです、きつねさん。正気に戻ってください！"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
