      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ほらほら、尻尾だよ？\nふわふわの尻尾で優しく撫で撫でしてあげちゃうよ？",
      "jp_sha256": "4afcd4c21a7888e3ae1629c2349fc814b7f6fad24fa4614f824e5e581e2de76b",
      "kind": "dialogue",
      "ko": "자자, 꼬리야?\n푹신푹신한 꼬리로 부드럽게 쓰다듬어 줄게?",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 12,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "3520dc9eed07d389246edae558e80a62f1181d9e6f9c03798d91c76f1e197e02:000000_-5915064980826486612:g0:r11",
      "row_index_0based": 11,
      "serialized_row_index": 11,
      "source_cells": [
