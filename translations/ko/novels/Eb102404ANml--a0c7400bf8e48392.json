      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "6247357d228860c059e36c04d1623b54328e15e5c85f11a5a3ca1f939cb3e532",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "え、いやそういうわけでは……。\nなんか、すみませんでした。",
      "jp_sha256": "089450701c9827f9879dc5b79e978c5bf579927960c40d4e1ce0c8c2ee138f60",
      "kind": "dialogue",
      "ko": "네, 아니, 그런 뜻은…….\n왠지 죄송했습니다.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 22,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
