    {
      "command": "",
      "draft_row_sha256": "0cd3168d8adab7b21eec908624a4e875febf4959f58d32ef9ca6868a36aafabc",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "当ったり前っち！\nワーラット娘は盗みを働いてナンボ、\n盗まざる者食うべからずだっち！",
      "jp_sha256": "0350af9f9b6d8c1f7a954c5f5eb80e4abbfdcf0f5c52c5510fe09defa7d54ee1",
      "kind": "dialogue",
      "ko": "당연하다 찍!\n웨어랫 소녀는 훔쳐야 제맛,\n훔치지 않는 자 먹지도 말라 찍!",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 48,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
