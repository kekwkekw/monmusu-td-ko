    {
      "command": "",
      "draft_row_sha256": "3df9bf17c8eee0cacb3404f05d3f681c8244f14484bab766b382b2f04b44763c",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "……ふぅ、やっと追いつきました。\n美味しいおせちとは、\n貴殿の足元に落ちているソレのことですな。",
      "jp_sha256": "46d2ae955723cc8a03744d79067750f1d940fcb88cc547ee63104ee2c2782861",
      "kind": "dialogue",
