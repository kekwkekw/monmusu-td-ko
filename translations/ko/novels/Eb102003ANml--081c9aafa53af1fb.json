      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そんな、まさか……。\n何でも願いを叶える宝って、そんな都合の良い物ありませんよ。\nあるのは美味しいおせち料理くらいです。",
      "jp_sha256": "e28cf292634521765d2ca369f4824a5fa79502b467c3f1f3d9393b4fa0e3a1ec",
      "kind": "dialogue",
      "ko": "그럴 리가…….\n무슨 소원이든 이뤄 주는 보물 같은 편리한 물건은 없어요.\n있는 건 맛있는 오세치 요리 정도예요.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 22,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "b24de44fd2d2fd5df1b22b630037bdc13269d8244cc3eec04f8d02c1b970a79e:000002_5917689858974891191:g0:r21",
      "row_index_0based": 21,
      "serialized_row_index": 21,
      "source_cells": [
