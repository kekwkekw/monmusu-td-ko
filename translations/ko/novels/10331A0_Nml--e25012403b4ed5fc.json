      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "我は夫君の妻だぞ。\n暇ができたのでな、会いに来るのは当然だろう。",
      "jp_sha256": "e644eaf0e240cfc0e0086f623a9f5789a1d797cf7e4357fae38bfb65b2a76502",
      "kind": "dialogue",
      "ko": "나는 부군의 아내다.\n시간이 났으니 만나러 오는 게 당연하지 않느냐.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
