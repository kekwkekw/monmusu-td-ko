    {
      "command": "",
      "draft_row_sha256": "f6aa2686c8190d44faad8bd4b17b5d22d25cf8b898cb78c91218f75f4e15ea42",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "いや、そういうわけじゃないですけど……。\nていうか、なんですかその生き物！？",
      "jp_sha256": "311215b2b1c7f14122916eb9318584b4d076fa3c9888d2f61543ab858a1e7f40",
      "kind": "dialogue",
      "ko": "아니, 그런 건 아닌데요…….\n그보다 그게 무슨 생물이에요!?",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 21,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
