      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "6b35ee1ec663900adccfbe482365cdd7099f6472462f1fabc0425e168cd3a658",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あぁ、うん。\n別に理由があってこんな気分になっているわけじゃないから。\nそんなに心配しなくても大丈夫だよ。",
      "jp_sha256": "844095c031f5f5b17c60a42df342fb86d8944a17ef892dc0acbf387b2756c58d",
      "kind": "dialogue",
      "ko": "아아, 응.\n딱히 이유가 있어서 이런 기분인 건 아니니까.\n그렇게 걱정하지 않아도 괜찮아.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 24,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
