      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ああ……そうなんですね。\n……そうだ、気分転換でもどうです？\n僕、今日は一日あいているので、一緒にお散歩しましょうよ！",
      "jp_sha256": "bb404715915d16e05218013aa05bf064594a4ff2746ca1e5ef3c7743f6fc3221",
      "kind": "dialogue",
      "ko": "아아…… 그렇군요.\n……그렇지, 기분 전환은 어때요?\n나, 오늘 하루는 비었으니 같이 산책하죠!",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 25,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
