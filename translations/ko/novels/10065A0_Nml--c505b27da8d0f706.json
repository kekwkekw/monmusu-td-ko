      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あ、あの……困っていることとか、\n悩み事とかあったら、何でも相談してくださいね？",
      "jp_sha256": "68bd5a0fa147c4765c3afff2fdd53dd152b04b149914ad25973f642cdc983bb0",
      "kind": "dialogue",
      "ko": "저, 저기…… 곤란한 일이나,\n고민이 있으면 뭐든 상담해 주세요?",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 23,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
