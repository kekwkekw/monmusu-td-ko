    {
      "command": "",
      "draft_row_sha256": "85009ed4510622d9c7303640a0cd2b3eeda61209a851c279d95300ca221e93b5",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "「楽になりたい」というのはニグリュさんの口癖だ。\n彼女はどこか人生に達観した雰囲気があり、\nえん世的な言動が特徴的なモンスター娘なのである。",
      "jp_sha256": "2f3bddc8427779d54af8176740e8b2388951cdd75fb8d125eaf8910772bf418d",
      "kind": "dialogue",
      "ko": "‘편해지고 싶다’는 니그류 씨의 말버릇이다.\n그녀는 어딘가 인생을 달관한 분위기가 있고,\n염세적인 언행이 특징인 몬스터 소녀였다.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 22,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "31251835facc21592ca6c7a3a827378f07ad258ea836fc02aa39178a4aaa7b1e:000002_2738130307920651167:g0:r21",
