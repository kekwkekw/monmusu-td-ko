      "draft_row_sha256": "bf27e90bc532cf71d043064fdd6c7ad6290d64d63de05aa7e752fdca6cc78734",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "むう……確かにそれもそうだペン。\nヌシ釣りが目的なら、仲間割れしてる現状はありがたいペン！\nどうせこんなうるさい場所ならヌシもすぐに逃げるペン！",
