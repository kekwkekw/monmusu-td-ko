      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "うおおお！　止めるんじゃねえペン！\nご主人たま、もうここまで来たら暴力で分からせるんだペン！",
      "jp_sha256": "1278b23b578f3814db26f0c627dca0bc6883f24783d0256c45d3c5f2abf11684",
      "kind": "dialogue",
      "ko": "우오오오! 말리지 마라 펭!\n주인니임, 이쯤 됐으면 폭력으로 알아듣게 하는 거다 펭!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 11,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
