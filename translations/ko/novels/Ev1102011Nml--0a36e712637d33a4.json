      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "さらには異世界の住人たちも巻き込み――。",
      "jp_sha256": "ef673cc44a256621e718ee5e27d1117b843e358f2279507e23c95d75fe0798a9",
      "kind": "dialogue",
      "ko": "나아가 이세계의 주민들까지 휘말리게 하며――.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 44,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b016-20261109-0cc9675e465a",
      "review_note": "",
      "review_status": "reviewed",
