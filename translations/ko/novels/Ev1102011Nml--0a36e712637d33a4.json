      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "モンスター娘を巻き込み、密猟者も巻き込み、\n",
      "jp_sha256": "b39a9c7ccf31c8f281c2954877117833214e8c3e74abfa1ec20d98a6c06db20e",
      "kind": "dialogue",
      "ko": "몬스터 소녀를 휘말리게 하고, 밀렵꾼도 휘말리게 하고,\n",
      "message_index_0based": 3,
      "page_ctrl": "Next",
      "physical_line_1based": 31,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b016-20261109-0cc9675e465a",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "3c849ca00dc580abc326ff784acd9ccd98c9c4e3113f22bdf0fbf66ef380d988:000002_4790578574724603248:g0:r30",
      "row_index_0based": 30,
      "serialized_row_index": 30,
      "source_cells": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "モンスター娘を巻き込み、密猟者も巻き込み、\n",
        "Next"
      ],
      "speaker": "",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
