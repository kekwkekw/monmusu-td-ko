    {
      "command": "",
      "draft_row_sha256": "b0d733d19103ee426ba5f4e079668216bf5bd3d471df61245f0048b7a109aaad",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "はい、そうなんです……。\nわたくし、いつも少しだけ浮いているので、\nたまには地面に降り立ってみたくなるんです。",
      "jp_sha256": "5bd602fa5096c8f0242de0cd38cf135a32693e9ac10099cfa15bfd60fa0bd1a5",
      "kind": "dialogue",
      "ko": "네, 맞아요…….\n저는 언제나 조금 떠 있으니까,\n가끔은 땅에 내려서 보고 싶어지거든요.",
      "message_index_0based": 11,
      "page_ctrl": "",
      "physical_line_1based": 21,
