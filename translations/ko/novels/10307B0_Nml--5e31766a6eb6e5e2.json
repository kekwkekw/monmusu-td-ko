      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あっ、ルイシャさんの足元のそれ、\nその模様を調べに来たんです。",
      "jp_sha256": "00a32d11067a06e7d4e7585077a09a31e3b9c46ad44dc3d4d41eda0637723f9b",
      "kind": "dialogue",
      "ko": "앗, 루이샤 씨 발밑의 그거,\n그 무늬를 조사하러 왔어요.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
