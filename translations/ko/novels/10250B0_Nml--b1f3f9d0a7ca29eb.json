      "speaker": "",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "b60a65d28bcf6f33f278291dcbdbb9e56823db8d02fae9ef8224c43f9acfa904",
