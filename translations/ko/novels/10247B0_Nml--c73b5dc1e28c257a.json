      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "さっきみたいに――ご主人はいつも――\nモンスター娘に――狙われ――襲われる――。\nその理由が――ご主人自身にあると気づいている――か？",
      "jp_sha256": "8c5982a4efdf76ecc32b5e53732f67c95c4fe43be1f8f27e5257d46ded771a97",
      "kind": "dialogue",
      "ko": "아까처럼――주인은 늘――\n몬스터 소녀에게――노려지고――습격당한다――.\n그 이유가――주인 자신에게 있다는 걸 알고――있나?",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 37,
