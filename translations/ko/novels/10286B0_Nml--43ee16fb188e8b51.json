      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ちょろちょろ逃げ回ってご苦労だけど、\nいい加減に大人しくしてよ――ねっ！",
      "jp_sha256": "86a589b5a34b9d3f3e4024dd350984273c355bc1b177724fc74b8d51e67724d2",
      "kind": "dialogue",
      "ko": "요리조리 도망 다니느라 수고는 많지만,\n이제 그만 얌전히 있어 줘―― 얍!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 16,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
