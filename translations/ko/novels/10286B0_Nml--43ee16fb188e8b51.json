    {
      "command": "",
      "draft_row_sha256": "c0810be493cdb33e412a89ce6062c84b85d8f58dc56262fe4f7fec9c51db1fbf",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ま、待ってくれ！　今すぐ島から出ていくよ。\nもう密猟なんて２度と考えないから……\n頼むから許してくれ！　な？",
      "jp_sha256": "e341c1a317b75e96684dde30bbc1cd8057aa085a950daf854747af24af0ed778",
      "kind": "dialogue",
      "ko": "자, 잠깐만! 지금 당장 섬에서 나갈게.\n밀렵 같은 건 두 번 다시 생각하지 않을 테니까……\n제발 용서해 줘! 응?",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 34,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
