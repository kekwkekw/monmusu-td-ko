      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "できるだけ他人を傷つけたくはありません。\n素直に帰って、心を入れ替えてくれるならそれが１番ですよ。",
      "jp_sha256": "8f3e0373f907d835c8cd3655abc1730a04cccde760f3acf0986333a8615edb27",
      "kind": "dialogue",
      "ko": "되도록 다른 사람을 다치게 하고 싶지 않아요.\n순순히 돌아가서 마음을 고쳐먹는다면 그게 가장 좋잖아요.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 39,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
