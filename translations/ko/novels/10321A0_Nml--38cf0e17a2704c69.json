      "kind": "dialogue",
      "ko": "우와, 눈이 엄청나네.\n이렇게 많이 쌓이는 건 좀 드문 일일지도.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 9,
