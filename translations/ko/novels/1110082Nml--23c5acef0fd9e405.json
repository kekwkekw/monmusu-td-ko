    {
      "command": "",
      "draft_row_sha256": "81da39327e5ccb53b1756b5f94ddfab06d253a6e5e462f124f02ba031fba9876",
      "grid_index": 0,
      "grid_message_index_0based": 25,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "症状としては、ゾンビ化した上にいやらしい症候群を\n発症しており、ご主人たちはショッピングモールに立てこもり、\n患者と戦ったり治療したりすることになるのだが……。",
      "jp_sha256": "ae4c4fa60b76be8606ee5e8670e8e41c3feb36aa826c944f0c83a4f2089e0d5d",
      "kind": "dialogue",
      "ko": "증상은 좀비가 된 데다 음란 증후군까지\n발병하는 것으로, 주인 일행은 쇼핑몰에 틀어박혀\n환자와 싸우고 치료하게 되지만…….",
      "message_index_0based": 25,
      "page_ctrl": "",
      "physical_line_1based": 183,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
