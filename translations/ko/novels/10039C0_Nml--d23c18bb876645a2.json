      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "……って、だめだめ！　チャンピオンみたいになるんだもん！\nさびしいからってめげてちゃ、いつまで経っても追いつけない！\nがんばるぞ～っ！　あちょ～っ！！",
      "jp_sha256": "397fbae4753a12c13fa63a34fdba9da8e84d91a19e1324e4d074a2eb71fb79b6",
      "kind": "dialogue",
      "ko": "……아니, 안 돼, 안 돼! 챔피언처럼 될 거야!\n외롭다고 기죽으면 언제까지고 따라잡을 수 없어!\n힘내자～! 아쵸～!!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 11,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
