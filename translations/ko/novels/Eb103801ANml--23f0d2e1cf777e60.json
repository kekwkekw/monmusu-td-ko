      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ダメダメ！　電気でビリビリ～ってして\nしびしびにさせるのがいいよ！　しびしびになって、\n自分じゃどうしようもなくなってる姿が一番いいんだから！",
      "jp_sha256": "64dbf771ca1245ec8a726a14d00771d09b06b22eb623eb659f2939c532b1b355",
      "kind": "dialogue",
      "ko": "안 돼, 안 돼! 전기로 찌릿찌릿~하게 해서\n저릿저릿하게 만드는 게 좋아! 저릿저릿해져서\n자기 힘으로는 어쩌지 못하는 모습이 제일 좋다니까!",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 11,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
