    {
      "command": "",
      "draft_row_sha256": "b23721f852c24408f486224922881baf61a23fcd68b3d6b2757d14a14e33abbb",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そんな風に笑わせるのは違うと思う！",
      "jp_sha256": "411c8facce5a9e60f66aa84742ed36b58dadf07134536689befab75401c89cd4",
