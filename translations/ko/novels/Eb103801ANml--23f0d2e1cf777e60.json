    {
      "command": "",
      "draft_row_sha256": "967dab5151b16b167acab5a6b6440343022677fb46ab3b2a4ec8dfabfe505fdc",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "やっぱりくすぐりだよな！　電気でビリビリとか、暴力と違って、\nくすぐってピクピクさせれば気持ちよく笑ってご主人も楽しい！\nそれを見ているアタシも楽しい！　ウィンウィンだ！",
      "jp_sha256": "717290724bfae151a4d57c677ac8302685b4f73179ef231d12648d474b122300",
      "kind": "dialogue",
      "ko": "역시 간지럽히기지! 전기로 찌릿찌릿하게 하거나 폭력을 쓰는 것과 달리\n간지럽혀서 부들부들하게 만들면 주인도 기분 좋게 웃고 즐거워!\n그걸 보는 나도 즐거워! 윈윈이야!",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 20,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
