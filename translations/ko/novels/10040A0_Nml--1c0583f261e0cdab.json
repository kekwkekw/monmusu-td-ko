    {
      "command": "",
      "draft_row_sha256": "df71589389071d17648bd42ba8c8394f201602805f73c19f2210d9761aa7b0de",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "フフフ、その怯えた表情も可愛いわね。\nここには今、私とマスターの２人きり……。\n誰にも邪魔されず、あなたをじっくり味わえる好機かしら？",
      "jp_sha256": "53156f68f7387a0c0d20edd794bd0a85fee10b813e6a9ed1916bc331dac845b4",
      "kind": "dialogue",
      "ko": "후후후, 그렇게 겁먹은 표정도 귀엽네.\n지금 여기에는 나와 마스터 둘뿐…….\n아무에게도 방해받지 않고 당신을 천천히 맛볼 좋은 기회일까?",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 55,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
