    },
    {
      "command": "",
      "draft_row_sha256": "f2ae2ecb2abfd78565710a980eb510b6654e32d37bfafcfb09ee4e4ec4af6ee0",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
