      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "ee46b3c2c00df72b21c6fa51d2b45e7dfdad04a476416f2fba1313080cf6f5e4",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そう、太陽を真正面に受けるのはナンセンス。お肌にも敵よ。\n主さまの頬っぺたがカリカリになったら、あたし泣いちゃうもの。",
      "jp_sha256": "0164d57b1dd8d25146279c4706c73faa2f48470630b862a25c780a6612948aa8",
      "kind": "dialogue",
      "ko": "그래, 태양을 정면으로 받는 건 센스가 없단다. 피부의 적이기도 하고.\n주인님의 볼이 바삭바삭해지면 나는 울어 버릴 테니까.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 18,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b008-20261106-451bb6a2fb2c21c5",
