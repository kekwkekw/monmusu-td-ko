      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それにしても、ミスレナさんまでカッツォに乗っていたんですね。",
      "jp_sha256": "5b728e7831008ad04b70c2fa6dd0205616ce0829ecff818e0a2cc3141ab9f9db",
      "kind": "dialogue",
      "ko": "그런데 미스레나 씨도 카초에 타고 계셨군요.",
      "message_index_0based": 10,
