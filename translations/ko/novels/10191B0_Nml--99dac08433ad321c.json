      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "今から森に散歩に出かけましょう。\n今日も朝からずっといい天気ですし\nどう考えても雨になるとは思えない空模様ですよ。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
