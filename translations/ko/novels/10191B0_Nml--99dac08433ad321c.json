      "grid_message_index_0based": 12,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "雨の日に、脛こすり娘が出てくるんじゃにゃい。\nうちが出ていくと、その日は雨ににゃるのよ。",
      "jp_sha256": "680701ff58cadd9c389a72872426c8e1a1eb563a25be447b6b63e76d5cf20f8a",
      "kind": "dialogue",
      "ko": "비 오는 날 스네코스리 아가씨가 나타나는 게 아니야.\n내가 밖에 나가면 그날 비가 오는 거야.",
      "message_index_0based": 12,
      "page_ctrl": "",
      "physical_line_1based": 30,
