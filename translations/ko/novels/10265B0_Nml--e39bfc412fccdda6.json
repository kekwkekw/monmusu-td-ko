      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "これは……一体何でこんなことが……。\n誰か！　怪我した人はいませんか！？\nみなさん！　大丈夫ですか！？",
      "jp_sha256": "27276e2714a0c522fe76173a449cd13514a4c5830d804f3969806f7dfeb3d7a9",
      "kind": "dialogue",
      "ko": "이건…… 대체 왜 이런 일이…….\n누구 다친 사람은 없습니까!?\n여러분! 괜찮아요!?",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 20,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
