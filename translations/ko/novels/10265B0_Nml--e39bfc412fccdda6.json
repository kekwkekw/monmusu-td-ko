      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そんなに大騒ぎをするな。\n怪我人は出ていないから心配無用だ。",
      "jp_sha256": "968d896c90190f5d54215498c7df7e6b5dd81279b580e883ccf23d4407a7ec53",
      "kind": "dialogue",
      "ko": "그렇게 호들갑 떨지 마라.\n다친 사람은 없으니 걱정할 필요 없다.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 24,
