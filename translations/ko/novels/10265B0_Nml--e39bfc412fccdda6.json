      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "もうもうと立ち込める煙の中から、\nさっそうと現れたのは科学部部長のリコさんだった。",
      "jp_sha256": "1d09781a6b69e4fc26e86f40753e05d51463a8e9fdfcc96b2e4a79d32952b659",
      "kind": "dialogue",
      "ko": "자욱하게 피어오르는 연기 속에서\n의연하게 나타난 것은 과학부 부장 리코 씨였다.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 25,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
