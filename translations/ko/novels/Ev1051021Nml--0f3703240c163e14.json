    {
      "command": "",
      "draft_row_sha256": "7457cc36fa9130383473d12a64d3eef895f3dca708ebfb3b2b414ed694dc18d9",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そんなこと言ってる場合ですか！\n今すぐ助けてあげないと！",
      "jp_sha256": "4298d662620ae4c79a0b78d1c95cbb9dc3063e351ce68a22eca63b6aa68d43fc",
      "kind": "dialogue",
      "ko": "그런 말 할 때예요!?\n지금 당장 구해 줘야죠!",
