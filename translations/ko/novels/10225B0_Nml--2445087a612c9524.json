      "review_status": "reviewed",
      "row_id": "56a5637d3e4da5a64b8a4d19dd4f360bce82a801bee51e24b700b8a06fc2b146:000002_6141401545007667475:g0:r13",
      "row_index_0based": 13,
      "serialized_row_index": 13,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "いらっしゃい。リュプチェさんの方こそ、\nこの前に会ったときよりもずっと顔色がよくなりましたね。\nもう断食は終わったんですか？"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "5a0391caace00d202c6687dfa20ba990589f56e93b324f6579799cec17f552b1",
