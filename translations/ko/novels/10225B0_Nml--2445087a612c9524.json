      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "リュプチェさん曰く、\nカリュブディス娘はクリスマスの期間中に\n断食を行うのが習わしだという。",
      "jp_sha256": "c7a87caef8d6adf33aa04df543830da774b57141b28f6d8f857d5d9bc1bd36d3",
      "kind": "dialogue",
      "ko": "류프체 씨의 말에 따르면,\n카리브디스 소녀는 크리스마스 기간에\n단식을 하는 게 관습이라고 한다.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 15,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b005-20261106-resume-same-model-pass2-r1",
