      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "いらっしゃい。リュプチェさんの方こそ、\nこの前に会ったときよりもずっと顔色がよくなりましたね。\nもう断食は終わったんですか？",
      "jp_sha256": "450612408c38046b87980c98c21af413206353ec24402b89562a4b7e6e293b18",
      "kind": "dialogue",
      "ko": "어서 와요. 류프체 씨야말로,\n지난번 만났을 때보다 안색이 훨씬 좋아졌네요.\n이제 단식은 끝난 건가요?",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b005-20261106-resume-same-model-pass2-r1",
