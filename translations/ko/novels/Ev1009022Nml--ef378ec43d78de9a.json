      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あーもー、ヤダ。モンスターって言葉が通じなくて、\nテティちゃんのキャワワなおねだりも意味がないから、\n拳で殴って落ち着かせるしかないのよね。",
      "jp_sha256": "9de33d3bd405cdfac5803eb27d1174b281f0b8b7bb4153aeddc87f8b48bc9179",
      "kind": "dialogue",
      "ko": "아ー 정말 싫어. 몬스터는 말이 통하지 않아서\n테티 쨩의 캬와와한 부탁도 아무 소용이 없으니\n주먹으로 때려 진정시키는 수밖에 없단 말이지.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 28,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
      "review_note": "",
      "review_status": "reviewed",
