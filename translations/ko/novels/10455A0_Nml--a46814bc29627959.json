      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ならば私たちが婚姻関係を築いても問題あるまい。\nというわけで結婚だ！",
      "jp_sha256": "767fccb9c33a1def3fc529cc3bd17d515f07753dd088eea97354e2da3c6f610d",
      "kind": "dialogue",
      "ko": "그렇다면 우리도 혼인 관계를 맺어도 문제없을 터.\n그러니 결혼이다!",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 19,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
