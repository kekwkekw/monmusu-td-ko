      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "い、いや、やっぱりいきなりすぎます！\nというか、ルキーナさんは僕と結婚して何がしたいんですか……？",
      "jp_sha256": "5ab59c29069dab41658a2d40620948fa3bcddcb28aceede96334a36e97284f57",
      "kind": "dialogue",
      "ko": "아, 아니, 역시 너무 갑작스러워요!\n그보다 루키나 씨는 저와 결혼해서 뭘 하고 싶으신 건데요……?",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 20,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b010-20261107-same-model-pass2-r1",
