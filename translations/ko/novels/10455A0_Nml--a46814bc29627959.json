      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "とある昼下がり、僕はいきなり、\nルキーナさんに求婚された。",
      "jp_sha256": "51c0e9d10248f8aba546f3300bbf2bf39f24cdb7f744961f38e00b4bf05f606c",
      "kind": "dialogue",
      "ko": "어느 오후, 나는 갑자기\n루키나 씨에게 청혼을 받았다.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 16,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b010-20261107-same-model-pass2-r1",
