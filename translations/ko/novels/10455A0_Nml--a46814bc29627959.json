      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "c36d08544a4aed4bcb265d37c44968bf10c1867c5a35c4efcd18ca8e1de01107",
      "grid_index": 0,
      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "何を驚く、ご主人？\nこの星では人間、動物問わず、殆どの個体が、\n婚姻関係を築くのだろう？",
      "jp_sha256": "f45ebad82e3ccef619e2a4057ea7ecc8b30743c81e50816dc8f713458324465b",
      "kind": "dialogue",
      "ko": "뭘 그리 놀라나, 주인?\n이 별에서는 인간과 동물을 가리지 않고 거의 모든 개체가\n혼인 관계를 맺는 것이겠지?",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b010-20261107-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "dca44e0024e0d4fb0bab21090c50bdc0ab8a6b1599aeb4f26a96562bec9e16dd:000000_-3225722777800586650:g0:r16",
      "row_index_0based": 16,
      "serialized_row_index": 16,
      "source_cells": [
        "",
        "",
        "ルキーナ",
        "Emt1_Nor",
        "layer_中",
        "",
        "",
        "0.3",
        "",
        "何を驚く、ご主人？\nこの星では人間、動物問わず、殆どの個体が、\n婚姻関係を築くのだろう？",
        "",
        "ch_10455/R18/10455A0_10455_Nml/10455A0_10455_002",
        "",
        ""
      ],
