      "review_status": "reviewed",
      "row_id": "dca44e0024e0d4fb0bab21090c50bdc0ab8a6b1599aeb4f26a96562bec9e16dd:000000_-3225722777800586650:g0:r19",
      "row_index_0based": 19,
      "serialized_row_index": 19,
      "source_cells": [
