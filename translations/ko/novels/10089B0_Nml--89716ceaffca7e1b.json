    {
      "command": "",
      "draft_row_sha256": "2d7183157380413b9457a0d70b72b3e58eb74407c1a1386038418e9b7a270b46",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "イヤじゃないですっ！　で、デート……行きましょう！\nそうだ！　顔の墨を落としつつ、海底で珊瑚を眺めましょう！\n水棲モンスター娘の人気デートスポットなんです！",
      "jp_sha256": "dcdf5f739347083c1124d31d26de6f435fcff2ad6af835075626217855267cba",
      "kind": "dialogue",
      "ko": "싫지 않아요!　데, 데이트…… 가요!\n그래요!　얼굴의 먹물도 씻을 겸, 해저에서 산호를 구경해요!\n수생 몬스터 소녀들에게 인기 있는 데이트 장소거든요!",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 32,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
