      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なるほど、それで僕を呼び出したんですね。\nわかりました！　じゃあ今日は一日、デートしましょうか！",
      "jp_sha256": "ce767d8530f59ecbf70816051bce586bb01c05c78013f3a49200840b40b798ed",
      "kind": "dialogue",
      "ko": "그렇군요, 그래서 저를 부르신 거네요.\n알겠습니다!　그럼 오늘 하루, 데이트할까요!",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 26,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
