      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "って、貴方はっ！\n死んだなんてウソだったのね？\nやっぱり、やっぱり生きて――っ！",
      "jp_sha256": "b313eff2570acbfd8e502f3fb82b7d75294f96a954d3b8d921ac5709ff33c99f",
      "kind": "dialogue",
      "ko": "아니, 당신은!\n죽었다는 건 거짓말이었구나?\n역시, 역시 살아――!",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
