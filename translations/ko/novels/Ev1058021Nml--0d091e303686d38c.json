      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "薄幸そうな美女は主人公をギュっと抱きしめた。",
      "jp_sha256": "498090b040e942124498db089a0a47de99f14b8d57a3b38ac1442f3f7c36bd7f",
      "kind": "dialogue",
      "ko": "박복해 보이는 미녀가 주인공을 힘껏 끌어안았다.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 20,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
      "review_note": "",
      "review_status": "reviewed",
