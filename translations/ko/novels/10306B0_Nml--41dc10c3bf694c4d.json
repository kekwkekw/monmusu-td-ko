    {
      "command": "",
      "draft_row_sha256": "0cb0f03686d1da2592d30843804175dfdb13cf545321827b442b86751df0f8e6",
      "grid_index": 0,
      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そうです。お上手です！\nでは「こんばんは」を言ってみましょう。\nツツートン、ツツツー。",
      "jp_sha256": "b1f674ca17a876738e8653401dadc91c9167e1aa06fa53ef2044880e81833723",
      "kind": "dialogue",
      "ko": "그렇습니다. 잘하셨습니다!\n그럼 ‘좋은 저녁’을 말해 보지요.\n츠츠―톤, 츠츠츠―.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 11,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
