    {
      "command": "",
      "draft_row_sha256": "dcc51132b90c9eb4027a19ae8e72cd16041265172cda02c165150f00fc5dfec6",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なるほど、勉強になりました。\nそうだ、言葉以外にも、月の文明について知りたいです！",
      "jp_sha256": "55f6f9d329f4a6dcc35e8b9745f68418034fa8ba406a94277a7b38d0156c785a",
      "kind": "dialogue",
      "ko": "그렇군요, 공부가 됐어요.\n참, 말 이외에도 달의 문명에 관해 알고 싶어요!",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 16,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
