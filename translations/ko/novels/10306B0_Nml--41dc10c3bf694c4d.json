      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そう言ってフィーユェさんが取り出したのは、\nいつも持っている玉の枝だった。",
      "jp_sha256": "ea45ac4c1e73715ddf6823d8e2c5bee1010507b88c665b5c04c27f7bb0b36984",
      "kind": "dialogue",
      "ko": "그렇게 말하며 피위에 씨가 꺼낸 것은,\n언제나 지니고 다니는 옥가지였다.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 23,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
