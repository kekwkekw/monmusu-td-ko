      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ええと、まずはおさらいです。「おはよう」ですね。\nこれは簡単です。ツツートン、ツツー。",
      "jp_sha256": "ec73bbe04cceee103150d2747b84cf5d7d0897690ab2e3d1269f91b7a1e056be",
      "kind": "dialogue",
      "ko": "음, 우선 복습입니다. ‘좋은 아침’이지요.\n이건 간단합니다. 츠츠―톤, 츠츠―.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 9,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
