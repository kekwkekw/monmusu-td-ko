    {
      "command": "",
      "draft_row_sha256": "22fe04e42053783f230ad7ccd0fe7a9aadeec0ea169d9631446c99442c9bd2b5",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "幾星霜の時が流れ、妾に残されたのは、\n家宝である玉の枝と月の言語だけでしたから。",
      "jp_sha256": "b5f2cc488adaff33e9aad519daaa5721888d3a1013b7bc8ea014f075b9cd4cda",
      "kind": "dialogue",
      "ko": "기나긴 세월이 흐르고 소첩에게 남은 것은,\n가보인 옥가지와 달의 언어뿐이었으니까요.",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 19,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
