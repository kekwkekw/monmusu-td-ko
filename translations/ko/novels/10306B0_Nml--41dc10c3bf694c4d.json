    {
      "command": "",
      "draft_row_sha256": "d30bcff109cb6d23e4095f7516c12ee698a17a3b7ce33eba26b9589b19cb8e4e",
      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "よくぞお気づきで！　あの日の月の晩、\n妾がうっかり口にした月の言語になります。",
      "jp_sha256": "1b2042dc6c4f5a4e189607c3cd52b9639688a96f1e1bdeec5e46262d567812a5",
      "kind": "dialogue",
      "ko": "잘 알아차리셨습니다! 그날 달이 뜬 밤,\n소첩이 무심코 입에 담았던 달의 언어입니다.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
