        "",
        "",
        "",
        "",
        "",
        "",
        "なるほど、勉強になりました。\nそうだ、言葉以外にも、月の文明について知りたいです！"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "dd27424a6e357d3b197a1bc807c9101f2322e981242cd41a45583afc2e37da9d",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そ、それは……。\n妾にも正直よくわかっていないのです。",
      "jp_sha256": "119d537df0962913409c5b8e29bdecde88b40c4cc6c92dfe9fec1a42ded5472f",
      "kind": "dialogue",
      "ko": "그, 그것은…….\n소첩도 솔직히 잘 알지 못합니다.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
