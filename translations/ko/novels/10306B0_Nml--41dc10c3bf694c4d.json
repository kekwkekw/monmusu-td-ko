      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そういえば、これについてまだお話していなかったですね。\n月の文明の、ある品について――。",
      "jp_sha256": "6c84670c9b044d9b2ab4a63b6f722c9714e55bf41af209c95ed8908f3a80087c",
      "kind": "dialogue",
      "ko": "그러고 보니 이것에 관해서는 아직 말씀드리지 않았군요.\n달 문명의 어떤 물건에 관하여――.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 20,
