      "kind": "dialogue",
      "ko": "그리하여 소인은 간켄 소녀로 진화한 것입니다!\n한층 세련된 개그 기술로, 게스원 우승은 소인이 차지할 것이오!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 6,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
