    {
      "command": "",
      "draft_row_sha256": "10f56e2dec3e18b571c301c68f250fa1597ec51b19d700ef5442ff5b407e1839",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "テルルさんの制止を振り切って、\nケィナさんは木の陰から飛び出してゆく。",
      "jp_sha256": "4a3f0b58bfa7e2886ef9e2672a39fa1af356b15501c9646450c19864893b675e",
      "kind": "dialogue",
      "ko": "테루루 씨의 만류를 뿌리치고,\n케이나 씨는 나무 뒤에서 뛰쳐나갔다.",
      "message_index_0based": 10,
