    {
      "command": "",
      "draft_row_sha256": "05254c310842ad139097e7ec4c5153bdb2654d16362130da92dec469dc1824e8",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "お忘れですか、ご主人さま。\nいつも出てきてはやられて、お仕置きされては改心して、\nそしてまた懲りずに悪行を繰り返す「小悪党マスター」ですよ。",
      "jp_sha256": "f7c594859951c5b2806796ca40c89238e58c2343cede4087c667ef1a0238741a",
      "kind": "dialogue",
      "ko": "잊으셨습니까, 주인님.\n늘 나타났다 당하고, 벌을 받고는 개심했다가\n또 질리지도 않고 악행을 되풀이하는 「소악당 마스터」입니다.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 29,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "393df0eb2f3c1794c54d663adbfd450bf8dc038dd9f7f5f1de008c0c0b668b73:000001_-520219274555922732:g0:r28",
