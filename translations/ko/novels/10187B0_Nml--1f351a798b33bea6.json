      "jp": "頭を下げつつ、僕はシロタエさんの手元を覗き込む。",
      "jp_sha256": "63c3bb66d04c430d535844dca3f053ae4950ae6ebcb35af26418fd80d4431b33",
      "kind": "dialogue",
      "ko": "고개를 숙이면서 나는 시로타에 씨의 손을 들여다본다.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 9,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
