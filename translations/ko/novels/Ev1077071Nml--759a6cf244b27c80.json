      ],
      "speaker": "",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "98ffb22f88724b252f6947ffa722402733df8de97daeca5f5e1bf79ec4fdf3dc",
