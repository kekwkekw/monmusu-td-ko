      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "違いますよ！　ただ、ロトーナさんやアメリさんは、\nどこに消えたんだろう、って考えていただけです。",
      "jp_sha256": "2508bf5a5713bf35f2e5bdceba2a8bcc30c9ca27f0d3f44b89d34bd5036533f2",
      "kind": "dialogue",
      "ko": "아니에요! 그냥 로토나 씨와 아메리 씨는\n어디로 사라졌을까 생각하고 있었을 뿐이에요.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 5,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "844662ae31b36c9035543666315f16e85cc2c6e2ebed2873920c1a196c50d91a:000002_7109173208027823321:g0:r4",
      "row_index_0based": 4,
      "serialized_row_index": 4,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "違いますよ！　ただ、ロトーナさんやアメリさんは、\nどこに消えたんだろう、って考えていただけです。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
