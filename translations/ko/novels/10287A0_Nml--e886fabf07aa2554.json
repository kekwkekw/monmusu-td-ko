      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なるほど……ナルケパフネさんは優しいですね。\nけど、せっかく来たんですから、\nみんなと一緒に遊んだらいいのでは？",
      "jp_sha256": "aa3b3dbc8fa036db09699e5cd90fab4e360e9d07a3c22831dce261391d20c2ee",
      "kind": "dialogue",
      "ko": "그렇군요…… 나르케파프네 씨는 상냥하시네요.\n하지만 모처럼 오셨으니,\n다들하고 함께 노는 게 어떨까요?",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 41,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "5ec5cf0486a1483459b266feed49e29bbec64a936deb404d1e426abeae2b6e6b:000002_460613971177390405:g0:r40",
      "row_index_0based": 40,
      "serialized_row_index": 40,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "なるほど……ナルケパフネさんは優しいですね。\nけど、せっかく来たんですから、\nみんなと一緒に遊んだらいいのでは？"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "3882830efac0592f0ddd9c02f419ce82deea43b351d73a16ec968b505ec51e3a",
