      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "砂浜に水着姿で座っている、\nナルケパフネさんを発見した。",
      "jp_sha256": "bb0c28ea29e3a7d1f4cd8be0e1f0080eb5002c6b9d7040057c5921455ed88b28",
      "kind": "dialogue",
      "ko": "모래사장에 수영복 차림으로 앉아 있는\n나르케파프네 씨를 발견했다.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 10,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "5ec5cf0486a1483459b266feed49e29bbec64a936deb404d1e426abeae2b6e6b:000002_460613971177390405:g0:r9",
      "row_index_0based": 9,
      "serialized_row_index": 9,
      "source_cells": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "砂浜に水着姿で座っている、\nナルケパフネさんを発見した。"
      ],
      "speaker": "",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "32698d5cab083aad61ed8620b6a2a5299eac6ee47e8ad0a8c53a71961a001367",
