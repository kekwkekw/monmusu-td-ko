      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "えっ、驚かせてごめんなさい……？\n水着を着ていますし、海に遊びにきたんですか？",
      "jp_sha256": "87ad029eca0e2377d450dc1709362cf123b9b59eb162d2572ad8bd4afe89189f",
      "kind": "dialogue",
      "ko": "네, 놀라게 해서 미안해요……?\n수영복도 입으셨고, 바다에 놀러 오신 건가요?",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
