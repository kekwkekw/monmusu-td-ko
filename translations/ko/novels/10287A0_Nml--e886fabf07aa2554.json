    {
      "command": "",
      "draft_row_sha256": "144b6b55bae6e322df999d0e4de9493dd5ccf5b8330c9eacdaa6c155a164268a",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ち、違うよ。遊びにきたのは私じゃなくてスゥノちゃん……！\nほら、あそこでみんなと遊んでいるでしょ？",
      "jp_sha256": "dcfce4631a0e8e5a221a39627a8ad42a41ba1a71d60e959ba9c597fd7b3d313c",
      "kind": "dialogue",
      "ko": "아, 아니야. 놀러 온 건 내가 아니라 스우노……!\n봐, 저기서 다들하고 놀고 있지?",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 18,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
