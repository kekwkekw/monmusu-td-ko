      "speaker": "",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "c80d8fbbfc6de573377ec0c93c973a7c8cb5f559309f7f9f5bbe63523bfde04d",
