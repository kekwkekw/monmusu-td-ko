      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "勝手に話を進めないでください！\nプラチナさんこそ、こんなところで何を？",
      "jp_sha256": "45d6a50ae0661c8b4c96090d58ab520d17d863e7085f368252a505b3e5f598e4",
      "kind": "dialogue",
      "ko": "멋대로 이야기를 진행하지 마세요!\n플라티나 씨야말로 이런 데서 뭘 하세요?",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
