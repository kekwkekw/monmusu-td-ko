      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "e811814003b7e3e3a534d31508999c1b4846afb1a92c388f001904b6060106a4",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それがしですか？\nそれがしは修行の旅で出会った愛馬、\nコショタ・パワーを可愛がっていたのです。",
      "jp_sha256": "b4473a2aa3a809bdd3cc3deac8f47d33b1f110b5552702e5999375b10dd16f99",
      "kind": "dialogue",
      "ko": "소인 말입니까?\n소인은 수련 여행에서 만난 애마,\n코쇼타 파워를 귀여워하고 있었습니다.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
