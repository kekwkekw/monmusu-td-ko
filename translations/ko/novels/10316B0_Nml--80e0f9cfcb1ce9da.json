      "review_status": "reviewed",
      "row_id": "f5de30621dbce57ca14ef6aa97dc83fcb31829345ff243c444db678abef0eede:000001_-2180755339050073708:g0:r13",
      "row_index_0based": 13,
      "serialized_row_index": 13,
      "source_cells": [
