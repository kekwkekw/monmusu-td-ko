    {
      "command": "",
      "draft_row_sha256": "60f63e29376ae679a744fa700c272293461c7cf47ed4fb6c4a640d9259ea3863",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "だから、今日はこの前食べれなかったジャイアントかき氷を、\nご主人さまに作ってあげようと思って……ほら、見て！",
      "jp_sha256": "836ab243ed8739cae5620c4f0528f6076b6d62a1b11bfb5055e3a61c4d557d02",
      "kind": "dialogue",
      "ko": "그래서 오늘은 지난번에 못 먹은 자이언트 빙수를,\n주인님에게 만들어 주려고…… 자, 봐!",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 12,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
