      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "092ea05f565e1c4f64958e429a68011ede05ea3e881936e8cdd8b329b4d2ac8d",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "うん、ちゃーんと穴がないのをちゃんと確認したから、\n今度こそ溶けないよ。",
      "jp_sha256": "f5effe85d2038182001289fe92f514c45e8eda3aee82009a8ca85061e7def66e",
      "kind": "dialogue",
      "ko": "응, 구멍이 없는지 제대로 확인했으니까,\n이번에야말로 녹지 않아.",
      "message_index_0based": 7,
      "page_ctrl": "",
