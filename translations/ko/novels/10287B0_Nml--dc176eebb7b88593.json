    {
      "command": "",
      "draft_row_sha256": "4c388ffe04b1fbd00949468dffb657ff686af270b853cf03475980f0e6b3ae59",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あ、それにかき氷にかけようかなと思って、\n牧場のミルクも持ってきたんだ。絶対おいしいよね！",
      "jp_sha256": "de50777b45a0ed684587deaf3549bc29e3f4cc7e6213bba957a9744084fc559c",
      "kind": "dialogue",
      "ko": "아, 그리고 빙수에 뿌리려고,\n목장의 우유도 가져왔어. 분명 맛있겠지!",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 21,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
