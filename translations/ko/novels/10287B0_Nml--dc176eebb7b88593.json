      "jp": "ある日、僕はナルケパフネさんに海に呼び出された。",
      "jp_sha256": "4ebbb0717f77f194dd9346a6ede659621aed3842c12d86453340ca2d21691ff8",
      "kind": "dialogue",
      "ko": "어느 날, 나는 나르케파프네 씨에게 바다로 불려 나왔다.",
      "message_index_0based": 0,
      "page_ctrl": "",
      "physical_line_1based": 8,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
