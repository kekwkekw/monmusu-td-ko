      "kind": "dialogue",
      "ko": "어느 날 밤, 주인공이 산책하던 중\n어딘가에 모여 있는 일행과 마주쳤다.",
      "message_index_0based": 0,
      "page_ctrl": "",
      "physical_line_1based": 8,
