      "kind": "dialogue",
      "ko": "있지 있지, 주인 군.\n우리와 이세계팀의 연계가 좋아진 것 같지 않아?",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 38,
