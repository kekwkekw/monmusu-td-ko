      "kind": "dialogue",
      "ko": "고마워요.\n평소와 다른 풍경을 볼 수 있어서…… 신선하고 즐거워요.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 18,
