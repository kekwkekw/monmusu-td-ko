      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "悪魔モンスター娘にとっちゃ、契約ってのは大事なもんで、\n契約をした場合にはそれを絶対に裏切れねえんです。\nその代わり、契約履行した際には魂を頂くってもんで。",
      "jp_sha256": "0146df416a4750b1af32a64e706ecac28b79d60f0cc3eb73ea1c59c62eb19e3e",
      "kind": "dialogue",
      "ko": "악마 몬스터 소녀에게 계약은 중요한 것이고\n계약을 맺으면 절대로 배신할 수 없습니다요.\n그 대신 계약을 이행하면 영혼을 받아 가는 거죠.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 49,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
