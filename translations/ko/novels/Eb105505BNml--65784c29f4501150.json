      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "大丈夫！　私、あのひとたちの居場所分かるよ！\n逃げ回りながら、拠点っぽい場所を覚えたから！",
      "jp_sha256": "8a973dc4de77e0f2956ab516407a4a7daef95ab555c8fb683b0ac51e405dab3d",
      "kind": "dialogue",
      "ko": "괜찮아! 나, 저 사람들 있는 곳 알아!\n도망다니면서 거점 같은 곳을 외웠거든!",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 29,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
