    {
      "command": "",
      "draft_row_sha256": "f92fa7e8f26cee8d584fd74a129009ff02406daeb61031c144c760dd31b08d1f",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "な、なんとあなたは先ほどの卑猥なドスケベ変態キノコ！！\nまさかこんな場所まで追いかけてくるとは……。\nしかも……うぅう……なんて、ひどい……。",
      "jp_sha256": "7eb63fff7274a3abae8576447fd57567a49243547055cef1f51298b6832f6bba",
      "kind": "dialogue",
      "ko": "뭐, 당신은 아까 그 외설적인 호색 변태 버섯!!\n설마 이런 곳까지 쫓아오다니…….\n게다가…… 으으…… 너무해…….",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 71,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
