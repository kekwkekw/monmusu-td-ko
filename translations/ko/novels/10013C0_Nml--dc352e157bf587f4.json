    {
      "command": "",
      "draft_row_sha256": "a351d181126576019e99670cfaf2199706f692f68fd118d7bf70bc230ee4b3a1",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "大きなキノコ頭のモンスターは、その頭部から\n真っ白な胞子を噴き出しながらこちらへ近づいてくる。\nその胞子の影響か、周囲の淫臭が濃くなっていた。",
      "jp_sha256": "a78c3bddf3fd294b9a2d794a550cbd2dc33b7bd145877cbee4b0a766377a1a16",
      "kind": "dialogue",
      "ko": "커다란 버섯 머리의 몬스터는 머리에서\n새하얀 포자를 뿜으며 이쪽으로 다가온다.\n그 포자의 영향인지 주변의 음란한 냄새가 짙어졌다.",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 72,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
