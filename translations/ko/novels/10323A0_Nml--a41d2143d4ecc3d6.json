      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "シジメさん？\nもしかしてチョコをつくっているんですか？",
      "jp_sha256": "4031df16f70ada8b72250ff065fe083e719ff0a246a1856f9dad3b5ff8632129",
      "kind": "dialogue",
      "ko": "시지메 씨?\n혹시 초콜릿을 만들고 계세요?",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 11,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "1b338bc037eee0b31b391a067667dee0580f72296bf8d88c909dcd979697c2cb:000000_-8079075207968447896:g0:r10",
      "row_index_0based": 10,
      "serialized_row_index": 10,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "シジメさん？\nもしかしてチョコをつくっているんですか？"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "4f69e6e2886ae102ff9a989154e586900f295b2512f97d9b7d2f95ceba43af4f",
      "grid_index": 0,
      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ひゃああああ！　ご、ご主人さま！？\nあわわっ！　わ、私みたいな変態キノコが、\nこんなあまーい食べ物を作っててごめんなさい……！",
      "jp_sha256": "c44f85817744b6c4194a258ac9f6f55b490430782f48870932e404c8420ae29d",
      "kind": "dialogue",
      "ko": "히아아아! 주, 주인님!?\n아와와! 저 같은 변태 버섯이,\n이렇게 달콤한 음식을 만들고 있어서 죄송해요……!",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
