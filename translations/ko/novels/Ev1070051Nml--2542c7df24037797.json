      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "――ん？　そういえば、\n何やら森の方から不穏な……これは歌声ですか？",
      "jp_sha256": "29b1c71392a1b6fd0c122a34b0ab9aa589e8c75a14f17c15dbba0024693425a9",
      "kind": "dialogue",
      "ko": "――음? 그러고 보니\n숲 쪽에서 뭔가 불온한……이건 노랫소리인가요?",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 27,
