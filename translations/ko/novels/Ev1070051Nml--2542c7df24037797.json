    {
      "command": "",
      "draft_row_sha256": "155a441326d0b967fd09d826eceb3fa63fe044600bdfe7e4a7ffa3cb6df4f5fb",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "にゅるーん。とっても切ないんだよ。\nご主人くんは大人にならないで欲しいんだよ……。\n永遠のショタでいいんだよ。",
      "jp_sha256": "a4dd4281550f9bda99744f6ea0ae6bdd6a6aa732d01d029b09ddca494007d45e",
      "kind": "dialogue",
      "ko": "뉴루웅. 너무 슬픈 이야기야.\n주인 군은 어른이 되지 않았으면 해…….\n영원한 쇼타면 돼.",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 23,
