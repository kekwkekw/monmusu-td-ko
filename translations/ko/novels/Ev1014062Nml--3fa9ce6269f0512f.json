      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "私たちの死角になる岩礁に、\n逃走用の船を準備していたみたいよ、プロデューサー！\nさっきの海賊の女も逃げていったわ。",
      "jp_sha256": "d86eb35cd8f51f83e57b00428e24769fca430ef26f2a9dcb95ce38a6e46ba616",
      "kind": "dialogue",
      "ko": "우리의 사각이 되는 암초에,\n도주용 배를 준비해 둔 모양이야, 프로듀서!\n아까 그 해적 여자도 도망쳤어.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 28,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
