    {
      "command": "",
      "draft_row_sha256": "4f61bc918d038a196e1115877e2980ffbcecdc606f04f994754ecd429af33c1c",
      "grid_index": 0,
      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "珍しく、カリスさんが僕の部屋を訪ねてきた。\n予想外の来客に嬉しく思ったが、なにやら彼女の表情は暗い。",
      "jp_sha256": "cce8bd794a67a44ee1aa76980c84acb24225873a87f2765c9e70fe942821bec8",
      "kind": "dialogue",
      "ko": "드물게 카리스 씨가 내 방을 찾아왔다.\n뜻밖의 방문이 기뻤지만 어쩐지 그녀의 표정이 어둡다.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 11,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
