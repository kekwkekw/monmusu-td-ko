      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "コカトリス娘はね、成長すると、無精卵を産むようになるの……。\nわたし、他の子と比べると初産卵が遅くて……。\nぴぅぅ……恥ずかしぃ……。",
      "jp_sha256": "e672f11b4ffde4d17bc4bfbd1013ee6c73294ac4c5d16433bf71055ed92019bb",
      "kind": "dialogue",
      "ko": "코카트리스 소녀는 말이야, 다 자라면 무정란을 낳게 돼…….\n나는 다른 애들보다 첫 산란이 늦어서…….\n삐우우……부끄러워…….",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 41,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "0cb395035e6f8f49720e206b7d829df4e77b55ca7787c810d81ff641ae8d8d6b:000002_8562228967815182967:g0:r40",
      "row_index_0based": 40,
      "serialized_row_index": 40,
      "source_cells": [
