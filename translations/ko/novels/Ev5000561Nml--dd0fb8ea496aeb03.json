      "kind": "dialogue",
      "ko": "주인공 일행이 미래에서 왔다는 사실은\n괜한 문제를 일으킬 수 있다는 이유로\n아직 인간들에게 알리지 않았다.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 60,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
