      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "バウさん、どうしたんだろう。\n僕、何か悪いことをしちゃったのかな……。",
      "jp_sha256": "a54a1a8f99f5fed98c6929db5330f3a453c80065959c5a29db0206e64ea45e7e",
      "kind": "dialogue",
