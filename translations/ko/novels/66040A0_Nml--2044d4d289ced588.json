    {
      "command": "",
      "draft_row_sha256": "0f8881e5dbeb58ff9b75db59921c5ffdd41ba6f48104bd62c4d169f14ffb7a47",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ありましたよ！！！\nなんですか、あの札は！　それに派手なデザインは！",
      "jp_sha256": "c3532700a83452efbafb8fd80a596a76b67dfc3b0bad8c5eb4a0e3fd8785451e",
      "kind": "dialogue",
      "ko": "있었고말고요!!!\n그 팻말은 뭔데요! 게다가 그 화려한 디자인은요!",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
