    {
      "command": "",
      "draft_row_sha256": "cae80c7815330eee5597ac0a34433a011b694485750c9dc1f0ba9cb14bbea325",
      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "どんな勘違いですか！\nそれよりもどうなってるんですか、保健室は！",
      "jp_sha256": "e039f74528fd9b5c3867cd2015633217eb0439ab750e76b5ed960257232ceb4a",
      "kind": "dialogue",
      "ko": "무슨 착각이에요!\n그보다 보건실이 어떻게 된 거예요!",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b011-20261107-ff47d2c5b69e",
