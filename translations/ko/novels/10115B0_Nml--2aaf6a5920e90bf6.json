    {
      "command": "",
      "draft_row_sha256": "c629ce30af08c1f6c87b37f7ac1d91067a10ce41008289c15e648e604668f049",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "どっちも同じく首をはねるってことですよね！？\nそんなことしなくても、ちゃんと返します！\nというか、さっきそこで拾ったんですよ！",
      "jp_sha256": "2f649012fefb0c28f27504488f1ff37789212fa5dde9433cdd60a1db1af1c90a",
      "kind": "dialogue",
      "ko": "둘 다 똑같이 목을 자른다는 거잖아요!?\n그럴 필요 없이 제대로 돌려드릴게요!\n그리고 방금 저기서 주운 거예요!",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 40,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b004-20261105-same-model-pass2-r1",
