      "kind": "dialogue",
      "ko": "내가 그것을 주운 지 잠시 뒤\n부스럭부스럭 풀숲을 헤치며\n무언가를 필사적으로 찾는 레프 씨와 마주쳤다.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 33,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
