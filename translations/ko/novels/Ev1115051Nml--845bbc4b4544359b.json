    {
      "command": "",
      "draft_row_sha256": "1a46914ecf96080e4be59e79cfe8e6a168a4860d990e56017381c302a41ffa0d",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "う～ん、難しい話みたいなんだよ。\nネルにはよくわからないんだよ。",
      "jp_sha256": "67728a5dca855d7a85059933fe698ecb9931b4ce8a474c32d1b7b3129adc10f6",
      "kind": "dialogue",
      "ko": "으음, 어려운 이야기인 것 같은 거야.\n넬은 잘 모르겠는 거야.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 81,
