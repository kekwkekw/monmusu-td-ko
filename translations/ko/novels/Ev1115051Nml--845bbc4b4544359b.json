    {
      "command": "",
      "draft_row_sha256": "2bf6e373964ae5c15836fd793e1f038bfef07af726d0746e5a50a8d3d8da6368",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "イッヒッヒッヒッヒ！\n面白い表現を使うねぇ、ルネルカ。\nまるでオマエの師匠みたいだ。",
      "jp_sha256": "d4f3ccfab8db7115cc473ae1260f31342d4ba519c3c942d03aae241bcf765af0",
      "kind": "dialogue",
      "ko": "이히히히히!\n재미있는 표현을 쓰는구나, 루네르카.\n마치 네 스승 같아.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 74,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
