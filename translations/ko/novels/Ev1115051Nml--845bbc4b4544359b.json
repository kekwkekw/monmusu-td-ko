      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そんな簡単に魔法が創造されてたら、\n今頃この島なんて魔法の重さで沈んじゃってるんじゃない？",
      "jp_sha256": "ed772bf266fb6774f9134eb3ba402a81ef4bfc6293fa8ce5b3d56d151cd62b7f",
      "kind": "dialogue",
      "ko": "그렇게 쉽게 마법이 창조된다면\n지금쯤 이 섬은 마법의 무게 때문에 가라앉았을걸?",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 44,
