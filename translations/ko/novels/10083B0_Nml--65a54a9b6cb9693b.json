    {
      "command": "",
      "draft_row_sha256": "4f3d3e4f3b66dcc0fcb6efc5eba1beea2f7cf9b39c579a1d2d3b42b02e7e20d8",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ふふ、この私にかかれば料理なんて簡単なことよ。\n特別に煎じたお茶も持ってきたわ。\nさ、お腹が空いているのでしょう？　遠慮せず食べなさい。",
      "jp_sha256": "0158f8a2929fa476635d9f406e3b508b9a3233eb32d6b731594a4b7dfe8493c3",
      "kind": "dialogue",
      "ko": "후후, 이 몸에게 요리 따위는 간단한 일이지.\n특별히 달인 차도 가져왔어.\n자, 배가 고프다며? 사양하지 말고 먹어.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 24,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
