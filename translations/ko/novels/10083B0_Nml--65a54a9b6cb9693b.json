      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "おぉぉ……これはすごい！\nローストした赤身のお肉に、こっちはレモンのサラダですか。\n野菜が多めで、とても健康的ですね！",
      "jp_sha256": "1924b0f644b0342154beda58383a850a7d0b4d2798e0c3d773d5deac5a3ca9ae",
      "kind": "dialogue",
      "ko": "오오오…… 이건 굉장해요!\n구운 붉은 살코기에, 이쪽은 레몬 샐러드인가요.\n채소도 많아서 아주 건강하네요!",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 23,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
