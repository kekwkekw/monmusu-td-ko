    {
      "command": "",
      "draft_row_sha256": "d95e77798dc8f4d3179990264cbaa9ae93b308b22dcfa856337e4ce4b57ad8d3",
      "grid_index": 0,
      "grid_message_index_0based": 20,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ヴェラートゥさん……もしかして、寂しかったんですか？\nそれで、今度こそは僕とお近づきになるために、\nこんな豪華なお弁当まで用意して――……。",
      "jp_sha256": "c14f743e4dfc06b6ddc19703689ce49bf791c0644c25d93536f28f79907f8f3f",
      "kind": "dialogue",
      "ko": "베라투 씨…… 혹시 외로웠던 건가요?\n그래서 이번에야말로 저와 가까워지려고,\n이렇게 호화로운 도시락까지 준비해서――…….",
      "message_index_0based": 20,
      "page_ctrl": "",
      "physical_line_1based": 40,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
