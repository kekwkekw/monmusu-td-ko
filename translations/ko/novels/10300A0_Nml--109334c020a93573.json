      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "5e71d4a3cafd0e82538364c76c8d410253b415c6b2d538a0f9f97780223f5cc8:000000_-8887853306296033234:g0:r12",
      "row_index_0based": 12,
      "serialized_row_index": 12,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "え、ティッカさん？\nもしかして今来たんですか！？"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
