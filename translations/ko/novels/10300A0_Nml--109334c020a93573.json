      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あ～、遅刻するっ、遅刻しちゃう～！\n早く助けに行かないと、少年が首を刎ねられちゃう～。",
      "jp_sha256": "3c8e95a5fb9b0d608e36bed5a2ff0c446ae2d2d9545165e3db887557bdc7a5dd",
      "kind": "dialogue",
      "ko": "아, 지각하겠다, 지각하겠어!\n빨리 구하러 가지 않으면 소년의 목이 잘려 버려!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 12,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
