      "kind": "dialogue",
      "ko": "티카 씨는 전혀 미안한 기색이 없다.\n솔직히 그녀가 이렇게 크게 지각한 건 처음이 아니다.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 19,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
