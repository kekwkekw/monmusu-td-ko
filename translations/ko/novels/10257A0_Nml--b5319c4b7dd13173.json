      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "すげーな。まるで岩の山だな！\nこれじゃ誰も通れないぜ、ご主人。\n早く何とかしてあげないと！",
      "jp_sha256": "666fe13cea69e71226414528c55d31d0becebd48dcb038ee53bd0995b4b1baa2",
      "kind": "dialogue",
      "ko": "굉장하네. 완전히 바위산이잖아!\n이래선 아무도 못 지나가겠어, 주인.\n빨리 어떻게든 해 줘야 해!",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 11,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
