    {
      "command": "",
      "draft_row_sha256": "6cbc9c90391a51fea0a82bade87c1dcc601160c765d1132f877c157924f82423",
      "grid_index": 0,
      "grid_message_index_0based": 2,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "うわー……。これは話に聞いていた以上にひどいですね。\nたくさんの岩で、完全に道が塞がっちゃってますよ。",
      "jp_sha256": "9f326e26cd567a280efff050e9e6e44763d51ad2efe02e172587031388a6b372",
      "kind": "dialogue",
      "ko": "우와…… 듣던 것보다 훨씬 심하네요.\n수많은 바위가 길을 완전히 막아 버렸어요.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 10,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b006-20261106-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "290f893ff744be93d0a5588f0fb1422e14d665985a978934bc7a6338ab1a5616:000001_-2083967802287108795:g0:r9",
      "row_index_0based": 9,
      "serialized_row_index": 9,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "うわー……。これは話に聞いていた以上にひどいですね。\nたくさんの岩で、完全に道が塞がっちゃってますよ。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "b31d638978656d533b5cbc10f415dfe3035dce2818eefc4848c7cd4060706ff5",
