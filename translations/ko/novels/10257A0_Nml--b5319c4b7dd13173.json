      "row_id": "290f893ff744be93d0a5588f0fb1422e14d665985a978934bc7a6338ab1a5616:000001_-2083967802287108795:g0:r8",
      "row_index_0based": 8,
      "serialized_row_index": 8,
      "source_cells": [
