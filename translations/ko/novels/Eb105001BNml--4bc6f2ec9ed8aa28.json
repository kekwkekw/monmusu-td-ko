      "draft_row_sha256": "4831bc3f3ebc5029bb45c74d39c6d8f60c1b14b094fc1d082d52df933d58eda8",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ええ、その通りよ。まずは\n母親に抱かれていた頃を思い出してみることね。",
      "jp_sha256": "7640185a94429bcadd400f2b7dec8f035c538b1581d78461e724a1987aa0b1a5",
      "kind": "dialogue",
      "ko": "그래, 맞아. 우선\n어머니 품에 안겨 있던 때를 떠올려 봐.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 15,
