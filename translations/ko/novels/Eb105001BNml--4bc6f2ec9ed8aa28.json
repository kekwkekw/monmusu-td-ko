      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "784c5ec1a61fc710b7df6d342cc08c9319439489de131e061a46543972320271",
      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "たったひとりを愛するんじゃなくて、\nたくさんのファンを愛する――そう、まるで母親のような\n無償の愛を捧げることが、重要なのよ。",
      "jp_sha256": "91bc6f93daf52c29c8739e7ea1ec77da7ff2ea3b742e494c65510a4b5cf8bfc0",
      "kind": "dialogue",
      "ko": "단 한 사람만 사랑하는 게 아니라,\n수많은 팬을 사랑한다――그래, 마치 어머니 같은\n무상의 사랑을 바치는 게 중요해.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 11,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
      "review_status": "reviewed",
