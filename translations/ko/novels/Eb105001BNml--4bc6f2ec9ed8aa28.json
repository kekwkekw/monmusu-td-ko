    {
      "command": "",
      "draft_row_sha256": "27c7df14c42a4325fe101bb68b9d8493c7c8d2a30544fe155fb00d1f92874bd3",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それよ。ご主人のため、だけじゃダメなのよ。\nアイドルはファンを楽しませること、夢を与えることが\n何よりも大事なの。",
      "jp_sha256": "0e22bfabb55612c76ab338cde1d12ec2e3d171b5971f8476f50a65350e7967e8",
      "kind": "dialogue",
      "ko": "바로 그거야. 주인을 위해서만 해선 안 돼.\n아이돌은 팬을 즐겁게 하고 꿈을 주는 게\n무엇보다 중요해.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 10,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "a2b3b2dd9cb1b7992d009878f973bac904f8ab9b0c593d34c8ff79de798c0fec:000002_5883090659623556050:g0:r9",
      "row_index_0based": 9,
      "serialized_row_index": 9,
      "source_cells": [
