    {
      "command": "",
      "draft_row_sha256": "84678a87445d14a1bd1a138b0f7625c4abc83bc0d4dba461793006fd9a857e14",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なるほど、分かったよ！\nご主人くん、いや、プロデューサーくん。\nボクに名案があるんだけど、聞いてくれるかい？",
      "jp_sha256": "19517eb13b372a097c1265eaf3f73530b6fadbf2029f3fa2cd0377da08c3d469",
      "kind": "dialogue",
      "ko": "그렇구나, 알았어!\n주인군, 아니, 프로듀서군.\n내게 좋은 생각이 있는데 들어 줄래?",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 20,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "a2b3b2dd9cb1b7992d009878f973bac904f8ab9b0c593d34c8ff79de798c0fec:000002_5883090659623556050:g0:r19",
