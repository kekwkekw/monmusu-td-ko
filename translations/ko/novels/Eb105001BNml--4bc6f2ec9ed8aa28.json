      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "まずはエンキ神殿へ向かおう。\nそこにボクらが真のアイドルになるための\n必要な答えがあるはずさ。",
      "jp_sha256": "8fd8e93506387fb660f341aaef0dc415945203f47fdfa44cfd48088f9a9a2c35",
      "kind": "dialogue",
      "ko": "우선 엔키 신전으로 가자.\n거기에 우리가 진정한 아이돌이 되기 위해\n필요한 답이 있을 거야.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 22,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
