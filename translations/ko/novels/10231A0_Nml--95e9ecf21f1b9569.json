      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "い、言わないでください！　……あ、あのすいません……、\n腰が抜けてしまって……起こして貰えますか？",
      "jp_sha256": "69b4dbc310475edf414a228672ea2eb3c19792559681862d0a46f09608b21d0d",
      "kind": "dialogue",
