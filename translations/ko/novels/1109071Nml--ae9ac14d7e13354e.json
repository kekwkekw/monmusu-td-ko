    {
      "command": "",
      "draft_row_sha256": "746a4e7221c74d95b131d72ea271e1acc71ef5b1119aaaf9dc8761ee71794d30",
      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "だから、申し上げただろ、“はぐれ”悪魔モンスター娘だって。\n魔界からあぶれ出て、流れ流れて、何の因果か\n今や教会の走狗になっちまってるって訳でございます。",
      "jp_sha256": "d89a670861fc22fd495247dc07713c1a031319b015cec4e626ed4f5b071adf2e",
      "kind": "dialogue",
      "ko": "그러니까 말씀드렸잖아, ‘떠돌이’ 악마 몬스터 소녀라고.\n마계에서 흘러나와 이리저리 떠돌다가 무슨 인연인지\n지금은 교회의 앞잡이가 되어 버린 셈이옵니다.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 25,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b011-20261107-ff47d2c5b69e",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "e8336bb63d786f714bb56d081dd8101157423265dd365070cfff1ea7b0a55fed:000000_-6000639316690115741:g0:r24",
      "row_index_0based": 24,
      "serialized_row_index": 24,
      "source_cells": [
