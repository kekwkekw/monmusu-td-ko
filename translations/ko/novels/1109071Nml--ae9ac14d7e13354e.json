    {
      "command": "",
      "draft_row_sha256": "85cff296a3cee5e1fb5c6f976e420b241d23732c298594e2a40d331e1785afaa",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "悪魔モンスター娘は、通常、魔界かそれに\n類する場所にしかいないレアで、強力なモンスター娘です。\nよもや、こんな場所で遭遇しようとは……。",
      "jp_sha256": "de7b1f73d20ea9b8445ddbaae8174cf93bded6d1c8002bc8d62b23ce3c749f1c",
      "kind": "dialogue",
      "ko": "악마 몬스터 소녀는 보통 마계나 그와\n비슷한 장소에만 존재하는 희귀하고 강력한 몬스터 소녀입니다.\n설마 이런 곳에서 마주칠 줄이야…….",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 22,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b011-20261107-ff47d2c5b69e",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "e8336bb63d786f714bb56d081dd8101157423265dd365070cfff1ea7b0a55fed:000000_-6000639316690115741:g0:r21",
      "row_index_0based": 21,
      "serialized_row_index": 21,
      "source_cells": [
        "",
        "",
        "ビビ神",
        "Emt12",
        "layer_中",
        "",
        "",
        "0.3",
        "",
        "悪魔モンスター娘は、通常、魔界かそれに\n類する場所にしかいないレアで、強力なモンスター娘です。\nよもや、こんな場所で遭遇しようとは……。",
        "",
        "ch_30005/Main/1109/1109_30005_305",
        ""
      ],
      "speaker": "ビビ神",
      "translation_status": "translated",
      "voice": "ch_30005/Main/1109/1109_30005_305"
