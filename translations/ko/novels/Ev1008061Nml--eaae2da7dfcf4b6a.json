      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "薄く頬を染めたワエマワの身体がバチバチと帯電し始めると、\n主人公は先の経験からとっさに距離を取った。\nこれで、ひと安心――そう、主人公が息をついた瞬間。",
      "jp_sha256": "904667ab6d5430da91fafa2677ae69d53421b3628b6dade01162a57b473f06eb",
      "kind": "dialogue",
      "ko": "살짝 뺨을 붉힌 와에마와의 몸이 파직파직 대전되기 시작하자\n주인공은 앞선 경험을 살려 재빨리 거리를 벌렸다.\n이제 안심―― 그렇게 주인공이 숨을 내쉰 순간.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 63,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
