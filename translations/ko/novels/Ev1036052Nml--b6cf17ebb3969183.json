      "row_index_0based": 25,
      "serialized_row_index": 25,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "それなら安心ですね。\n……まあ、色々と大変でしたけど\nあの大きなヌシを釣る瞬間、楽しみですね。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "521b5b2c806ebcad07ff17d82cd4e88b0d40f8e5ec51e878701161843424efe7",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "私も、あの巨大なヌシを釣り上げる瞬間は楽しみだペン！\nああ、楽しみで仕方ないペン！　さあ、ご主人たま！　行くペン！",
      "jp_sha256": "47f670a009f973ef057f56a7af53352caf864c192546bdef408fffdaad3d6776",
      "kind": "dialogue",
      "ko": "나도 그 거대한 대어를 낚아 올리는 순간이 기대된다 펭!\n아아, 너무 기대돼서 견딜 수 없다 펭! 자, 주인니임! 간다 펭!",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 29,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
