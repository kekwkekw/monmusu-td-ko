      "kind": "dialogue",
      "ko": "그런데 괜찮아?\n또 이 앞에서 다른 몬스터 소녀와 엮이는 거 아닐까?",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 24,
