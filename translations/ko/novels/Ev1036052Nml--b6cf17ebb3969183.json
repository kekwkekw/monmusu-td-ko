    {
      "command": "",
      "draft_row_sha256": "e08f5234581af56641f7f2d7b8449bb397eb93695168c4dfefcd968d3c873213",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それなら安心ですね。\n……まあ、色々と大変でしたけど\nあの大きなヌシを釣る瞬間、楽しみですね。",
      "jp_sha256": "b9ef3ccc2803fcc80870e1c5f867421cc1cb8814362fac263b4ba3b183aa7f53",
      "kind": "dialogue",
      "ko": "그렇다면 안심이네요.\n……뭐, 여러모로 힘들긴 했지만\n그 커다란 대어를 낚는 순간이 기대되네요.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 26,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
