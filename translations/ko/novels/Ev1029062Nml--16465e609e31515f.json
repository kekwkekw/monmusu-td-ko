      ],
      "speaker": "",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "0b821cb60481cb6e7c98b2ae2716c393595605df43daa39f3b86487475d2c7f6",
