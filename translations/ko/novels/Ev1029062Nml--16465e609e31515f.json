      "row_index_0based": 9,
      "serialized_row_index": 9,
      "source_cells": [
        "",
        "",
        "主人公",
        "<Off>",
        "",
        "",
        "",
        "",
        "",
        "まさか、あの大穴の下に、こんな洞窟が広がっているなんて……。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "2291e23f3e155ffa9c1bd5ea597d5ca74b4a3af8037400086332acd36ae6e92b",
