      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "まさか、あの大穴の下に、こんな洞窟が広がっているなんて……。",
      "jp_sha256": "2947c59c7ea032d4fc3de4aaea3e12a35612a438afa3a0121999d4dd165b464c",
      "kind": "dialogue",
      "ko": "설마 저 큰 구멍 아래에 이런 동굴이 펼쳐져 있다니…….",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 10,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
      "review_note": "",
      "review_status": "reviewed",
