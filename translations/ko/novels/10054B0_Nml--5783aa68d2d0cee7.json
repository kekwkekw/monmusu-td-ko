    {
      "command": "",
      "draft_row_sha256": "690c6d45e38a5a64b9c820c9b5410a0f44fc237ef7537ef8b6eaa8fa8f93da1d",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "はっ、はいっ！",
      "jp_sha256": "4c97ad2c050ad78306e63cde7c7683c050ae2657078c29f4952f57e3b8ae952b",
      "kind": "dialogue",
      "ko": "네, 네!",
      "message_index_0based": 9,
      "page_ctrl": "",
