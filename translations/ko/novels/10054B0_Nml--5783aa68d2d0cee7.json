      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "えぇっ、僕ですか！？\nそんなことをいきなり言われても困りますよ！",
      "jp_sha256": "02dd812990b217b77b6ac2fd251d3072f27fb8b2d8a67fbe6b21e063c9c86c2b",
      "kind": "dialogue",
      "ko": "네엣, 제가요!?\n그런 말을 갑자기 들어도 곤란해요!",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 55,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
