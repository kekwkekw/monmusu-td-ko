    },
    {
      "command": "",
      "draft_row_sha256": "4aaf821b3f00ce2d48bec674cc8ffd9602b557f792656e2fad482915e1707729",
      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "僕の言葉に頷くティアさん。\n素直に他人の意見を受け入れられるのは彼女の美徳である。\nしかし――。",
      "jp_sha256": "4ccff7f95309df7d4c4546d25a0b4e92867833a60083a203167bebeccc54ab4d",
      "kind": "dialogue",
      "ko": "내 말에 고개를 끄덕이는 티아 씨.\n솔직하게 남의 의견을 받아들이는 것은 그녀의 미덕이다.\n하지만――.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 25,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "3ce670f509895fdc6fd42792605df1854973ffab038f144aedca4399e196494e:000002_8176857975305187342:g0:r24",
      "row_index_0based": 24,
      "serialized_row_index": 24,
      "source_cells": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "僕の言葉に頷くティアさん。\n素直に他人の意見を受け入れられるのは彼女の美徳である。\nしかし――。"
      ],
      "speaker": "",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "1eb7de1ee10c27e362eb74ba026660774b1a214006084ccff95122b9799d356c",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "じゃあ、プロデューサーよろしくね。\n何か刺激的なこと、体験させて頂戴！",
      "jp_sha256": "b4d8ce6deafae9be4bf0a3dff9b36eaecdf7da547a9767596f4210832d11c9d0",
      "kind": "dialogue",
      "ko": "그럼 프로듀서, 잘 부탁해.\n뭔가 자극적인 걸 체험하게 해 줘!",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 54,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
