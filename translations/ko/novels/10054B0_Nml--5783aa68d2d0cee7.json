    {
      "command": "",
      "draft_row_sha256": "ce52a54499e1348819b1e2bef4968073ddf7726bca9865adcddcb8d973db877a",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "彼女の声に急き立てられ、僕は走り出す。\nさてはて、どうしたものか……。\n走りながら彼女の気分転換について考えるのだった。",
      "jp_sha256": "0eae6e679d5fe535eb1c984ef6c7edefd5a49333011b9a1c55b13d577dfffa91",
      "kind": "dialogue",
      "ko": "그녀의 목소리에 재촉받아 나는 달려 나갔다.\n자, 어떻게 해야 할까…….\n달리면서 그녀의 기분 전환에 대해 생각했다.",
      "message_index_0based": 10,
      "page_ctrl": "",
