      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そうよ。\nこういう小さな遺跡なんかは特に……誰も見に来ないしね。",
      "jp_sha256": "1fd53826350174e4d8363df350835be2fbeb7a8d6c2c97b4518a26df5584a5f5",
      "kind": "dialogue",
      "ko": "그래.\n이런 작은 유적은 특히…… 아무도 보러 오지 않으니까.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
