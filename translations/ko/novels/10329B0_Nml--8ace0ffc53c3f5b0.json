      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "……あ、少年くん。\n私に見せたいものというのは――。",
      "jp_sha256": "ea641fcb4c6ad39379a38d355278c5f96c753f4c3d7499b519a55f1c20293411",
      "kind": "dialogue",
      "ko": "……아, 소년 군.\n제게 보여 주고 싶다는 것은――.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 10,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
