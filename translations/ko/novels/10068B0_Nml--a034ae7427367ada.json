      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ある夜のこと――。\n自室でくつろいでいると、僕を訪ねる声が聞こえた。",
      "jp_sha256": "a5044f36ba1a044445cad23ee2b86a80beb14c4172b520cc7f5bb2b04105c494",
      "kind": "dialogue",
      "ko": "어느 날 밤――.\n내 방에서 쉬고 있는데, 나를 찾아온 목소리가 들렸다.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 11,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
