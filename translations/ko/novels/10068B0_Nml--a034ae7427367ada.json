      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あれ、カヅネさん？　どうしたんですか。\nなんだか元気がないみたいですけれど。",
      "jp_sha256": "39ebf285b8f179f0d7f5176fa7c499db5550900d79529eb80d70576617cd41da",
      "kind": "dialogue",
      "ko": "어라, 카즈네 씨? 무슨 일이세요?\n왠지 기운이 없어 보이는데요.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
