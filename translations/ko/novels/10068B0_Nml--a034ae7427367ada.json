    {
      "command": "",
      "draft_row_sha256": "fdc6e2407a4d359ab4c348912af15245d5658f7c4b480862ebe8bb52037b9441",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "――先日のこと、と言われて僕は思い返す。\nカヅネさんに洞窟へ連れ込まれ、強引に迫られたのだった。",
      "jp_sha256": "ff5375b806712c9b57cb42b3f47532f92489842f2299c1bd38f53fc41b570956",
      "kind": "dialogue",
      "ko": "――지난번 일이라는 말을 듣고 나는 떠올렸다.\n카즈네 씨에게 동굴로 끌려가 억지로 덮쳐질 뻔했던 일이었다.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 38,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
