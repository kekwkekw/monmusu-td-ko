      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "私、夜の森なんて初めてです。\n思ったより暗くないんですね！",
      "jp_sha256": "868f0ca4b759a241e22b2e67a3651f10e3964882acbc155e0285fd0342b90561",
      "kind": "dialogue",
      "ko": "저, 밤의 숲은 처음이에요.\n생각보다 어둡지 않네요!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 37,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
