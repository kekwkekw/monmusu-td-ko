    {
      "command": "",
      "draft_row_sha256": "a3d0170e3355f9ae6ccd306185fb8d0c77a15945ad89ccd88992473f1a5b2ac1",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そんなわけないだろう。私の戦闘に勝手に便乗して、\n解放教会に所属していない者を無差別に襲っているのだ。",
      "jp_sha256": "eca89474237942949b603ed39947b893faff2786c4d212f9485c355cc521321b",
      "kind": "dialogue",
      "ko": "그럴 리가 있나. 내 전투에 멋대로 편승해,\n해방 교회에 소속되지 않은 자를 무차별로 습격하는 거다.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 15,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
