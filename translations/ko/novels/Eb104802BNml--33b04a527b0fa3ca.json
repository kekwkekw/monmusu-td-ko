    {
      "command": "",
      "draft_row_sha256": "fba518abc3836a89a21f1815cd3ee3d87c8c17be79c6f22dcc799fa65ea3ac7c",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なんでも「いやらしい症候群」は解放のための試練であり、\n四獣神の光は真なる解放を望んだ我々のものだとかいって――、\nまあ簡単に言うと、出世街道から外れた危険で哀れな集団だ。",
      "jp_sha256": "8d46f48fc277841aa78fe2e4a08ba3d349fc22f14bf41e92dd5e75079158d725",
      "kind": "dialogue",
      "ko": "듣자 하니 『음란 증후군』은 해방을 위한 시련이고,\n사수신의 빛은 진정한 해방을 바란 우리 것이라느니――\n뭐, 쉽게 말해 출세 가도에서 벗어난 위험하고 가엾은 집단이다.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 16,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
