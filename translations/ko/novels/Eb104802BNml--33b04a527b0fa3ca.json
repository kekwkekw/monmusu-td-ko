      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "え、そうだったんですか？\nてっきり、アルコスさんのお付きの人かと思っていました。",
      "jp_sha256": "47a0e05b019115b82d3aba611a6a2ab233077cda6491525a378f5b218bee1e5d",
      "kind": "dialogue",
      "ko": "어, 그랬나요?\n당연히 알코스 씨의 수행원인 줄 알았어요.",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 14,
