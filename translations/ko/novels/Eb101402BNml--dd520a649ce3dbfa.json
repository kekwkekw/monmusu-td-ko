      "row_id": "4e109483a4110048c6925cb2d6c976afdec1db16519d44aab9234901cdcfefcb:000002_8210796178355903917:g0:r2",
      "row_index_0based": 2,
      "serialized_row_index": 2,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
