      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なんだか一生分の愛の言葉を叫んでいた気がする……。\nごめんね、ルルゥ。迷惑かけちゃって。",
      "jp_sha256": "6f22c989c084e20ef3ba30d152b31710dda8e37feef69e03955b69ce80d8fb00",
      "kind": "dialogue",
      "ko": "왠지 평생 할 사랑 고백을 전부 외친 기분이야……. \n미안해, 루루우. 폐를 끼쳤네.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 10,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
