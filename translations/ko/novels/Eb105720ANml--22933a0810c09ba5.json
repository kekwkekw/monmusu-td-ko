      "row_index_0based": 7,
      "serialized_row_index": 7,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "い、いや、遠慮しておきます。\nなんか、あったかい風みたいなのが吹き出してて、\nちょっと気味が悪いというか……。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
