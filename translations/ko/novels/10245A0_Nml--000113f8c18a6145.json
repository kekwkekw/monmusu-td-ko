      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ふふふふ……！\nリデルさんのお茶会、とても楽しかったです……。",
      "jp_sha256": "428e546cd5433317a8e3fa07273d51ddfe2dd30c5d3ccb269b1eba1329166553",
      "kind": "dialogue",
      "ko": "후후후후……!\n리델 씨의 다과회, 정말 즐거웠어요…….",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 37,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
