    {
      "command": "",
      "draft_row_sha256": "3405aa83fbdb50d94391eb346a02770c299c3681aad559ade0ceb9bee9402d09",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "――ランケは激怒した。\n必ず、かの女タラシなご主人様を連れ去らねばならぬと決意した。",
      "jp_sha256": "a3fecaff818bd8831bb0892d39641febd34396ac41f662aa60c7c4a64aac1798",
      "kind": "dialogue",
      "ko": "――란케는 격노했다.\n반드시 저 바람둥이 주인님을 납치해야겠다고 결심했다.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 24,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
