      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あの、メリッサさん。何かご用でしょうか？\n今なら手が空いているので、お手伝いでも、\n相談でも、何でもできますけど……？",
      "jp_sha256": "2d70a16db9e831817454513eada1cae1826f8618eaef527d830cdee2e83e7a8c",
      "kind": "dialogue",
      "ko": "저기, 멜리사 씨. 무슨 볼일이라도 있으신가요?\n지금은 손이 비어 있으니, 일손을 돕든\n상담을 하든 뭐든 할 수 있는데요……?",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 11,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "76615c3aab9c5bf1a323522f9060161f090ba5ce525b500b28437d94743d07d8:000001_-1947926703791520027:g0:r10",
      "row_index_0based": 10,
      "serialized_row_index": 10,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "あの、メリッサさん。何かご用でしょうか？\n今なら手が空いているので、お手伝いでも、\n相談でも、何でもできますけど……？"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
