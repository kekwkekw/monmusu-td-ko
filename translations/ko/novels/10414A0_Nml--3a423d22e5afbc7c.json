      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "うん！\nフラスコも悪くなかったけど、この開放感はたまらないね！",
      "jp_sha256": "63567d1681a57bba1c7318b438b26bfc0e881782763aa68cc6b1778e5e0623ed",
      "kind": "dialogue",
      "ko": "응!\n플라스크도 나쁘지 않았지만, 이 해방감은 참을 수가 없네!",
      "message_index_0based": 7,
      "page_ctrl": "",
