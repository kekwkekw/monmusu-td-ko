      "row_index_0based": 9,
      "serialized_row_index": 9,
      "source_cells": [
        "",
        "",
        "ラプルムムーンチャイルド",
        "<Off>",
        "",
        "",
        "",
        "",
        "",
        "助手くん！\nよく来てくれたね。待っていたよ。",
        "",
        "ch_10414/R18/10414A0_10414_Nml/10414A0_10414_001"
      ],
      "speaker": "ラプルムムーンチャイルド",
      "translation_status": "translated",
      "voice": "ch_10414/R18/10414A0_10414_Nml/10414A0_10414_001"
    },
    {
      "command": "",
      "draft_row_sha256": "1122a8f92b489a64a3dc0da58530123d5f5af5cbd7146bbb06203efdd862f993",
      "grid_index": 0,
      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "空からぎゅーんとラプルムさんが下りてくる。",
      "jp_sha256": "c7fd8bd4151b838876aefda7e5c0703abe8a85262a6ded09ed6ddc65d22378e0",
      "kind": "dialogue",
      "ko": "하늘에서 쓩 하고 라플룸 씨가 내려온다.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
      "review_note": "",
      "review_status": "reviewed",
