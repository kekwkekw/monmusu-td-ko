      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ちょうどプリムヴィルを追いかけて汗も掻いとるし、ラッキーだったな！",
      "jp_sha256": "87fc2ef34c95ca41c9a5673dbf31c6632983bcfcaf9ea0a5086ee9706d386919",
      "kind": "dialogue",
      "ko": "마침 프림빌을 쫓느라 땀도 흘리고 있으니 운이 좋았네!",
      "message_index_0based": 10,
