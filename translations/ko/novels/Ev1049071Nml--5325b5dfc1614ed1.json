      "grid_message_index_0based": 2,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ホントですね……。\nもしかしてフレロカさんはすごく大きい方なんでしょうか……？",
      "jp_sha256": "e8bb00e86237b1886ab46093b9b43683398e62f868db8ad5100c078bf97a001a",
      "kind": "dialogue",
      "ko": "정말이네요…….\n혹시 프레로카 씨는 굉장히 거대한 분인가요……?",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 16,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
