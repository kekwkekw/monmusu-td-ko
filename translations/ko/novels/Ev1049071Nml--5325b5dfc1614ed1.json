      "review_status": "reviewed",
      "row_id": "efdaa60bd299e249709db08d5fd9d618bc733fdddb235bb12aaf8d1948dff9b9:000002_5311788666791945128:g0:r15",
      "row_index_0based": 15,
      "serialized_row_index": 15,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "ホントですね……。\nもしかしてフレロカさんはすごく大きい方なんでしょうか……？"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "e68f907cfaaa642d9d5183dbe2e7636d7e55cf54934bb3b86784eec921a553d2",
