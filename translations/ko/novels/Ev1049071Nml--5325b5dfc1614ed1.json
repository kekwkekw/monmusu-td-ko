      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ふふふ……その通りよ。\n私は大きな愛を持っている――全世界の美少年を「癒す」為に。",
      "jp_sha256": "7feef6839f7766aa25c437fbd296c7cde39253bbc6eacd33a1b193b740c1b3ab",
      "kind": "dialogue",
      "ko": "후후후……그 말이 맞아.\n나는 커다란 사랑을 지녔지――전 세계의 미소년을 \"치유\"하기 위해.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 30,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "efdaa60bd299e249709db08d5fd9d618bc733fdddb235bb12aaf8d1948dff9b9:000002_5311788666791945128:g0:r29",
      "row_index_0based": 29,
      "serialized_row_index": 29,
      "source_cells": [
        "",
        "",
        "ファロルーチェ",
        "Emt1_Nor",
        "layer_中",
        "",
        "",
        "0.3",
        "",
        "ふふふ……その通りよ。\n私は大きな愛を持っている――全世界の美少年を「癒す」為に。",
        "",
        "",
        "",
        ""
      ],
      "speaker": "ファロルーチェ",
      "translation_status": "translated",
      "voice": ""
    },
    {
