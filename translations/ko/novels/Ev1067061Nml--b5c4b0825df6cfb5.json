      "serialized_row_index": 9,
      "source_cells": [
        "",
        "",
        "ワエマワワキヤン・タンカ",
        "Emt1_Nor",
        "layer_中",
        "",
        "",
        "0.3",
        "",
        "うーん、ニーサちゃんはこっちに、\n飛んで行ったと思うけど……あ！",
        "",
        "",
        "",
        ""
      ],
      "speaker": "ワエマワワキヤン・タンカ",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
