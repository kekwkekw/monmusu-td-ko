      "jp": "うっすらと潮風が吹き抜ける海辺に、\nいつものように凛と立つハイルィさん。",
      "jp_sha256": "ea829ebe61c6e9c7f71c83642c4f1c76bb81bd91cb9d42741b1d4fe5a46087e8",
      "kind": "dialogue",
      "ko": "희미한 바닷바람이 스쳐 가는 해변에\n평소처럼 늠름하게 선 하이루이 씨.",
      "message_index_0based": 0,
      "page_ctrl": "",
      "physical_line_1based": 8,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b008-20261106-451bb6a2fb2c21c5",
