      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ジャイアント娘である彼女が、嬉しそうに手を叩いたり、\n指をさしたりするたびに強風が巻き起こる。\n足踏みすれば地面が揺れ、ちょっとした天変地異だ。",
      "jp_sha256": "083565488960324a13e4033e402eb8f29bf6b058d8f0e773e2ed5d9eb86d64e7",
      "kind": "dialogue",
      "ko": "자이언트 소녀인 그녀가 기쁜 듯 손뼉을 치거나\n손가락으로 가리킬 때마다 강풍이 휘몰아친다.\n발을 구르면 땅이 흔들리니, 작은 천재지변이나 다름없다.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
