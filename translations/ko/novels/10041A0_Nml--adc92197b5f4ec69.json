      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "わぁ、このお花かわいい！\nあっ、蝶々だ～！　\nみてみて、ご主人さま！　綺麗だね～！",
      "jp_sha256": "f0b6f6c496ae7665da1f7351f2e96964fa4549fd8a4d5a67378701a70379d9b2",
      "kind": "dialogue",
      "ko": "와, 이 꽃 귀여워!\n앗, 나비다～!　\n봐 봐, 주인님! 예쁘다～!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 9,
