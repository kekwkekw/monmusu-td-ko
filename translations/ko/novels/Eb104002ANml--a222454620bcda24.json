    {
      "command": "",
      "draft_row_sha256": "ca2a825cfa19206096baf6386999a59515cece0e077ace99c32aa3daa1d59db5",
      "grid_index": 0,
      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "この競技は「メイド部」「チアリーディング部」といった\n各部活の代表者が幼児退行し、\nまるでイヤイヤ期になったつもりで争う対抗戦よ。",
      "jp_sha256": "d31e236ee53eafa7ff0d11518361a604d2881f9499ddbbdd9d37228c257670b1",
      "kind": "dialogue",
      "ko": "이 경기는 '메이드부', '치어리딩부' 같은\n각 부활동 대표자가 유아 퇴행해서\n마치 떼쓰는 시기가 된 것처럼 겨루는 대항전이에요.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 9,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
