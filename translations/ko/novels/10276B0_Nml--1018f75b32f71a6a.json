    {
      "command": "",
      "draft_row_sha256": "bad07f128d88844ab6a5bc4e028533eedc1093c2af67ced7ea0cde43789f1a69",
      "grid_index": 0,
      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "まったくもう……こんなことするのは誰なんですか……。\nいたずら好きの妖精さんの仕業ですか？\nお願いですから、そろそろ僕を解放してください……。",
      "jp_sha256": "452e7f2d44a975aacbfac9be9fdfc29a896b479dfb20fe92c0212e4bae9871f2",
      "kind": "dialogue",
      "ko": "정말이지……이런 짓을 한 게 누구예요…….\n장난꾸러기 요정들이 한 짓인가요?\n부탁이니 슬슬 날 풀어 주세요…….",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 9,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b006-20261106-same-model-pass2-r1",
