      "kind": "dialogue",
      "ko": "말끔히 갠 하늘 아래.\n나는 초원에서 코코노하 씨와 마주 보고 있었다.",
      "message_index_0based": 0,
      "page_ctrl": "",
      "physical_line_1based": 8,
