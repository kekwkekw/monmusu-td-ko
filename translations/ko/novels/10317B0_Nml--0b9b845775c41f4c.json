      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あの……ココノハさん、今日は僕に何の御用でしょうか？",
      "jp_sha256": "113544ce6d6a9009fd356c5c5af902c21b110f44a2ca51446b38c64fcdbdcf70",
      "kind": "dialogue",
      "ko": "저기……코코노하 씨, 오늘은 제게 무슨 볼일이신가요?",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 10,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
