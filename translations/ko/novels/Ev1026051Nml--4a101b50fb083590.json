      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "わ、私も行きます！\nみんなや先生の力になりたいの。\nこんな私でも役に立てることがあるかもしれないから……。",
      "jp_sha256": "528016f1ae6d57bf068c1216108369d3a72e2fe6285aafd8240703ac84a392d4",
      "kind": "dialogue",
      "ko": "저, 저도 갈게요!\n모두와 선생님에게 힘이 되고 싶어요.\n이런 저라도 도움이 될 일이 있을지 모르니까…….",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
