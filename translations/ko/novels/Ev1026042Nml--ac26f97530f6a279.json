      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "う、嘘だろ！？\nまさかあの、最強と噂されるモンスター娘だってのか！？\nなんでそんなのが、モンスター娘学園にいるんだ！？",
