    {
      "command": "",
      "draft_row_sha256": "dea46ed8f50dff56a9cef27abab7164e331a34789633516033e2a73586c0920f",
      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ガウミィさんの言葉に僕は首を傾げる。\n自由気ままに生きている彼女から\n『仕事』という言葉が出てきたのが意外だったからだ。",
      "jp_sha256": "77878ef1bdfd9646aec8b1da9a314a3324f50f3707fbeece224d30db325b3404",
      "kind": "dialogue",
      "ko": "가우미 씨의 말에 나는 고개를 갸웃했다.\n자유분방하게 살아가는 그녀의 입에서\n『일』이라는 말이 나온 것이 뜻밖이었기 때문이다.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 29,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
