      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "よしっ、もういい。気が済んだぞ。\n今日にーちゃんに来てもらったのは、\nじゅーよーな仕事を頼みたいからだ。",
      "jp_sha256": "51c62463f6f8aad1c37dcbdf8c464e1e6d31b96a5f88b20b0d8b18ae16f7abfc",
      "kind": "dialogue",
      "ko": "좋아, 이제 됐어. 만족했어.\n오늘 오빠를 부른 건\n중～요한 일을 부탁하려고 한 거야.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 28,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
