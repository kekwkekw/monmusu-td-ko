      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なるほど！　なら私は生き別れのお姉ちゃんがいいです！\nでも記憶を失って、ご主人くんのことを忘れてるんです！",
      "jp_sha256": "d95e604238bf1d82566218f7b4639e58dfd6f51816525f0d23bdbee0ce261396",
      "kind": "dialogue",
      "ko": "그렇군요! 그럼 저는 생이별한 누나가 좋아요!\n하지만 기억을 잃어서 주인 군을 잊은 거예요!",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 17,
