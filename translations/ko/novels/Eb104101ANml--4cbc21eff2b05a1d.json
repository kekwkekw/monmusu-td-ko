      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "きさまらに悪影響を及ぼしんす。\n早々に破壊しておくようにしなんし。\n同じ性質を持つ者であれば、破壊しやすいようでありんすが……。",
      "jp_sha256": "ca3cf5596f35f316d02435de5ec678ffd1c6e283a06a2e5e0e8a1762b1a8f41b",
      "kind": "dialogue",
      "ko": "너희에게 악영향을 미치니\n서둘러 파괴하도록 하여라.\n같은 성질을 가진 자라면 파괴하기 쉬운 듯하나…….",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 22,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
