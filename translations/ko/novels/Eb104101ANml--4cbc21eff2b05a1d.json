      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あの船ではないか？\n闇の魔力に近い、禍々しい気配を感じるぞ。",
      "jp_sha256": "83f7101a9a76af45851d3cdbd8232076f40f3a7384761bcf485e2cf41791aac3",
      "kind": "dialogue",
      "ko": "저 배가 아닌가?\n어둠의 마력과 가까운 불길한 기운이 느껴진다.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 7,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
