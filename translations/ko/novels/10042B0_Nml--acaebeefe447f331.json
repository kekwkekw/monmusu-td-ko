      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そろそろ休憩にしましょうか。\nご主人様は素直で呑み込みが早いので、\nとても教え甲斐がありますね。",
      "jp_sha256": "bce0458db3076855539d98d7d45e6d2a7c71fc181963510778c64fecef40e23d",
      "kind": "dialogue",
      "ko": "슬슬 쉬었다 할까요?\n주인님은 솔직하고 이해도 빠르셔서\n가르치는 보람이 크네요.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 12,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
