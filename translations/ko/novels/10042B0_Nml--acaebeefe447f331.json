      "row_index_0based": 12,
      "serialized_row_index": 12,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "いえいえ、パステノさんの教え方がいいからですよ。"
      ],
