      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "a9dfbc0a549482630ca02f1e66abd60b180e9ef2564750e3895f73823b24f6e3",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ふふふ、褒めても何もでませんよ？\nでも、ご主人様の言うことですから、\n素直にお褒めの言葉としていただいておきますね。",
      "jp_sha256": "f9c6900e2432856eb78474223c03f90c5f3eea43ef22f4c9286db8b5621e217a",
      "kind": "dialogue",
      "ko": "후후후, 칭찬하셔도 아무것도 안 나와요.\n하지만 주인님이 하신 말씀이니\n순순히 칭찬으로 받아 둘게요.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 42,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
