      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "この２つの野草は、よく似ていますけれども、\nこちらは薬草、こちらは毒草です。\n葉っぱの付け根の膨らみをよく確認してくださいね。",
      "jp_sha256": "0b6f3103ec6023f1f18125e6308bd2bf053b11057c73dc898ccf2c58f710df94",
      "kind": "dialogue",
      "ko": "이 두 들풀은 아주 비슷하게 생겼지만\n이쪽은 약초, 이쪽은 독초예요.\n잎 밑동의 부푼 부분을 잘 확인하세요.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 9,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
