      "kind": "dialogue",
      "ko": "도중에 담스토가 성급히 나서는 바람에\n무관한 여행자 몇 무리를 습격하기도 했다.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 9,
