    {
      "command": "",
      "draft_row_sha256": "647940ef79fb19c226ee09442bed951af329504e22a96da6ed0d05ec1a3e4c82",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ひとつでも……とはいいますが、私的には見れば見る程、\n縁起マシマシになると考えていまして。",
      "jp_sha256": "4179b4954f15c4fd8f89959e1664b9e93423b44e1a907a9de61029d84e8a07d3",
      "kind": "dialogue",
      "ko": "하나라도……라고는 하지만, 제 생각에는 많이 보면 볼수록\n길운이 듬뿍 늘어난다고 보거든요.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 21,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b011-20261107-ff47d2c5b69e",
