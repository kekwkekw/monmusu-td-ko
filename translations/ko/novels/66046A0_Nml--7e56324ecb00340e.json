    {
      "command": "",
      "draft_row_sha256": "efb5e89e2ed9032f5dc93fdb6b84141395dd49f062879af6315959a254ebf270",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "はい！　一火山、二鷹、三なすび、といいまして……これらが、\n１つでも初夢に出れば、縁起がいいと伝えられています。",
      "jp_sha256": "4973c7b8c04500f29cb83d821a6ad80f5c4f44fa7c32e9c353941e738d3287ab",
      "kind": "dialogue",
      "ko": "네! 첫째 후지산, 둘째 매, 셋째 가지라고 해서…… 이것들이\n하나라도 첫 꿈에 나오면 길하다고 전해집니다.",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 20,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b011-20261107-ff47d2c5b69e",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "5e6da6635104d00f384e6fbd9b843588a30510d2856068683486c3ea46215cf5:000002_8679928382417875844:g0:r19",
