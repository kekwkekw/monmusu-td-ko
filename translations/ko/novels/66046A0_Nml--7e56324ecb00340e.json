      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "イヅツさん、あけましておめでとうございます。\nあれ、素敵なお衣装ですね。新調されたんですか？",
      "jp_sha256": "0cdd282917f54cb0cb349ba58dda3d0c9cd90cf2c50d65a8e694dfa61ec7a16b",
      "kind": "dialogue",
      "ko": "이즈츠 씨, 새해 복 많이 받으세요.\n어라, 멋진 옷이네요. 새로 장만하셨습니까?",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 12,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
