      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "オッホン！\n今夜はですね、新年のあいさつもかねて、主様に素敵な１年を、\n過ごしてもらうため、ある提案をしに来たんです。",
      "jp_sha256": "45503589ad2bfc2d0180a2f219ab4a9ab3f1e092587559ad07ed23a4fcc916e4",
      "kind": "dialogue",
      "ko": "어흠!\n오늘 밤에는 말이죠, 새해 인사도 겸해 주인님께서 멋진 한 해를,\n보내실 수 있도록 어떤 제안을 드리러 왔습니다.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
