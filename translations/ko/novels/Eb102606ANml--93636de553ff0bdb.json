    {
      "command": "",
      "draft_row_sha256": "6e2630b48ffa0d62b1f46c0f4f78babce6abd6a9703beb43538746327e203dd0",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "モンスター娘から人間を守るために決まってるだろ！\n集団でぞろぞろと学園から出てくるなんて前代未聞だからな。\n徒党を組んで人間を襲うに決まってるし。",
      "jp_sha256": "48bc446c23d348c5316049141d58fddf3c4488447867db01a1de6817cb9b03e9",
      "kind": "dialogue",
      "ko": "몬스터 소녀에게서 인간을 지키기 위해서가 당연하잖아!\n집단으로 우르르 학원에서 나오는 건 전대미문이니까.\n무리를 지어 인간을 덮칠 게 뻔해.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 21,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "b2425feaafe26d77161cf903e515216f90e15a01f32e7d29569f393a0982f51b:000000_-2676812584409407398:g0:r20",
      "row_index_0based": 20,
      "serialized_row_index": 20,
      "source_cells": [
        "",
        "",
        "女騎士道生",
        "<Off>",
        "",
        "",
        "",
        "",
        "",
        "モンスター娘から人間を守るために決まってるだろ！\n集団でぞろぞろと学園から出てくるなんて前代未聞だからな。\n徒党を組んで人間を襲うに決まってるし。"
      ],
