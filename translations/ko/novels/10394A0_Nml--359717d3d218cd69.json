      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なるほど、\nそれじゃあ今年も挑戦してみますか。\n見つけられますかね？",
      "jp_sha256": "3bada92175342ba88162b1cc5e3f0548f233455b0f2cdd9569d7b4979c3e7e97",
      "kind": "dialogue",
      "ko": "그렇군요,\n그럼 올해도 도전해 볼까요.\n찾을 수 있으려나요?",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 30,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
