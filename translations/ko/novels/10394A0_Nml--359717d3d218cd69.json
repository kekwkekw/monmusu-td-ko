    {
      "command": "",
      "draft_row_sha256": "8ff568080e745a940c481200b5da7ec648b5e991e4f153973b258c25ae49b4cc",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "胸を張って宣言するバウさん。\nその真面目な顔があまりに可愛くて、\n僕は少し意地悪を思いついた。",
      "jp_sha256": "671c2dc085e991d5417723f3144315d28d94d094f22ff77a42aff891dcd004e6",
      "kind": "dialogue",
      "ko": "가슴을 펴고 선언하는 바우 씨.\n그 진지한 얼굴이 너무 귀여워서,\n나는 조금 짓궂은 생각을 떠올렸다.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 25,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
