      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ソレイア、確かにあなたの言う通り、\nご主人さまをいやらしい目で見ている\nモンスター娘も少なくありません。むしろ、全員がそうでしょう。",
      "jp_sha256": "fffd5114a19d477bcf3083eb93130bddbb5d804fd09a0aba04bbc639038cfd65",
      "kind": "dialogue",
      "ko": "소레이아, 당신 말대로 주인님을 음흉한 눈으로 보는\n몬스터 소녀도 적지 않습니다.\n아니, 오히려 전부 그렇다고 봐야겠죠.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
      "review_note": "",
      "review_status": "reviewed",
