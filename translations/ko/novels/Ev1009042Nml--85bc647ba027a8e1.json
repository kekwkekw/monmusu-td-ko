      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "これまでご主人さまは\n数多のモンスター娘たちと共に戦い、成長してきましたからね。",
      "jp_sha256": "787ba1f2b06a7de169c75c5fe0167faf36f1e7681b6e1395f10605835de5aa64",
      "kind": "dialogue",
      "ko": "그동안 주인님은\n수많은 몬스터 소녀와 함께 싸우며 성장해 오셨으니까요.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 12,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
