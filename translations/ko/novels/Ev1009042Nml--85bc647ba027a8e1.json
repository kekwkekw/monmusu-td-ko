        "Emt3_Gla",
        "layer_ビビ神c_右",
        "",
        "",
        "0.3",
        "",
        "これまでご主人さまは\n数多のモンスター娘たちと共に戦い、成長してきましたからね。",
        "",
        "",
        "",
        ""
      ],
      "speaker": "ビビ神",
      "translation_status": "translated",
      "voice": ""
