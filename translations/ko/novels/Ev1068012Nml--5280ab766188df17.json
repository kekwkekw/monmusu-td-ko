    {
      "command": "",
      "draft_row_sha256": "5d937708d19134022161c9beeec5143e7442c08e5323578d64173b4391a61992",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ラッシーちゃん待って！\nもう、カティナちゃん。いくらなんでも無愛想すぎだよ？",
      "jp_sha256": "1b4a5d364e6a31ba1b732fc96faf69f119f51faa029f929c5b2400db82ca0b61",
      "kind": "dialogue",
      "ko": "랏시쨩, 기다려!\n정말, 카티나쨩. 아무리 그래도 너무 무뚝뚝하잖아?",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 32,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
      "review_note": "Names 정본 표기 교정",
      "review_status": "reviewed",
      "row_id": "c7c2f7c4c79ca417365a9fff226cccaec72608012b3a432cdefdf04a26d935f1:000002_8672277162074768752:g0:r31",
      "row_index_0based": 31,
      "serialized_row_index": 31,
      "source_cells": [
        "",
        "",
        "リンデンハート",
        "Emt10_Sad",
        "layer_右中",
        "",
        "",
        "0.3",
        "",
        "ラッシーちゃん待って！\nもう、カティナちゃん。いくらなんでも無愛想すぎだよ？",
        "",
        "",
        "",
        ""
      ],
      "speaker": "リンデンハート",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "c3692a9063c037defe338a16c6d23641fce7ec108c2369c64b1669be675d3966",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "べっ、別に不愛想じゃないわよ。\nちゃんと情報共有したし、もう言う事はないでしょ？",
      "jp_sha256": "d90b3499734bca39ea86e556a9b262a7b1ee23da933485f217c507f2fc5bc6fa",
      "kind": "dialogue",
      "ko": "무, 무뚝뚝한 거 아니야.\n제대로 정보를 공유했고, 이제 할 말은 없잖아?",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 33,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
