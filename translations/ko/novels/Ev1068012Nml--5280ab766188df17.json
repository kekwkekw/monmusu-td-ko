        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "え、えーっと……はい、わかりました。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "b20a9c542d7f3b1ce5b549d92c46afab814f09fc83bc07867f90a0c39141d455",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "主人公は戸惑いながらも、\n指示に従って宮殿を出ようとすると――。",
      "jp_sha256": "a2b4c862676bbf454d3156034481e7d096b6b385bd8920d0fc6ab8e0dead7311",
      "kind": "dialogue",
      "ko": "주인공이 당황하면서도\n지시에 따라 궁전을 나가려 하자――.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 27,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
