    {
      "command": "",
      "draft_row_sha256": "cb9009ffa093c048c485ebb8075b793e855547cca7ba7827cd241cda9cd1cdbd",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "いつものカティナちゃんじゃないよぉ。\nこれじゃあラッシーちゃんもかわいそうだよぉ。",
      "jp_sha256": "730bf1494f27a0da36f5f7fb3ca9454846a3c2aadd37124d0fe91706f22889da",
      "kind": "dialogue",
      "ko": "평소 카티나쨩답지 않아아.\n이러면 랏시쨩도 불쌍하다구우.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 34,
