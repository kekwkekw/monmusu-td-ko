      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "いや、知将とか関係なく、\n近づく音でバレているといいますか……。\nそれに何度も殺されかけたら、さすがに察しますよ。",
      "jp_sha256": "18b3fd373a8a824a40461e56aca8b03f24c2bd0eaff56ca89ca479d43bd6b8e0",
      "kind": "dialogue",
      "ko": "아뇨, 지장 같은 건 상관없이,\n다가오는 소리 때문에 들킨다고 할까…….\n그리고 몇 번이나 죽을 뻔하면 아무리 그래도 알아차려요.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 23,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "3d5f146bcd31b8d16707c3e1d08c2f3f1db19fc0f5af0f0fa73d77661d66f3ca:000002_5650685679615414311:g0:r22",
      "row_index_0based": 22,
      "serialized_row_index": 22,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "いや、知将とか関係なく、\n近づく音でバレているといいますか……。\nそれに何度も殺されかけたら、さすがに察しますよ。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
