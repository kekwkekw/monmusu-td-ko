      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "くっ……よく避けたな。ご主人様。\n知将として名高いお前には、わしの策も筒抜けか！",
      "jp_sha256": "81651dcef48df146804d9d4c00ee0f794308540a8c5350246f053484ad933986",
      "kind": "dialogue",
      "ko": "큭…… 잘도 피했구나, 주인님.\n지장으로 명성이 높은 네게는 내 계책도 훤히 보인다는 건가!",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 22,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
