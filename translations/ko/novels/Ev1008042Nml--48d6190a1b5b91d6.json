      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そんな、リーダーだなんて……やめてくださいよ。\n僕はいつもモンスター娘さんたちに守られているだけで、\n今の勝負だって、皆さんがいなければ僕は……。",
      "jp_sha256": "dd120e14cb19fac6c2e0e877f169686b3e8ff45b5750c203236d10664a402946",
      "kind": "dialogue",
      "ko": "그런 리더라니…… 그만하세요.\n저는 늘 몬스터 소녀분들에게 보호받을 뿐이고\n방금 승부도 여러분이 없었다면 저는…….",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 44,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
