      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "私の授業の――アシスタントに――、\nなってもらった――ほうが――早いと――思う。",
      "jp_sha256": "204e5c547d47356fe09dc3771c04e48206eeaffe70baa6705c3385d345dfed39",
      "kind": "dialogue",
      "ko": "내 수업의―― 보조 교사가――,\n되어 주는―― 편이―― 빠를 것――같다.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 41,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
