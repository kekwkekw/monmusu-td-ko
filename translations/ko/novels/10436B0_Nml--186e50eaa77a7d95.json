    {
      "command": "",
      "draft_row_sha256": "418b505512dd0d9b0b94321aa603766632fb3406ebad7757a2d2400a9106163a",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "今回の『おっぱい学』を――始めよう。\nモンスター娘の胸部に――絶対と言っていいほど、\n存在している――『おっぱい』に――ついてだ。",
      "jp_sha256": "bb0fec2fe5e142ad00f81901576145fd9b6323d0a8c02664190bb958946eebea",
      "kind": "dialogue",
      "ko": "이번 ‘가슴학’을―― 시작하지.\n몬스터 소녀의 흉부에―― 거의 반드시,\n존재하는―― ‘가슴’에―― 관해서다.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 52,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "b104154744d51144b11fc2904f12f92c08d5228d8d680ba8178057619eae6262:000002_4479125623223178206:g0:r51",
      "row_index_0based": 51,
      "serialized_row_index": 51,
      "source_cells": [
        "",
        "",
        "シルバ学園",
        "Emt1_Nor",
        "layer_中",
        "",
        "",
        "0.3",
        "",
        "今回の『おっぱい学』を――始めよう。\nモンスター娘の胸部に――絶対と言っていいほど、\n存在している――『おっぱい』に――ついてだ。",
        "",
        "ch_10436/R18/10436B0_10436_Nml/10436B0_10436_004",
        ""
      ],
      "speaker": "シルバ学園",
      "translation_status": "translated",
      "voice": "ch_10436/R18/10436B0_10436_Nml/10436B0_10436_004"
    },
    {
      "command": "",
      "draft_row_sha256": "ec1c57b791b883831e0b37eea97e14d5477ca493f56a96a7f030a9dcc27bf5f5",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "知っていると思うが――この世の全ては――、\n『おっぱい』の――大きさで決まる。",
      "jp_sha256": "e03878726089c2875238ce99ce40590443f98aeedec8a8dd911d4d25431f43e7",
      "kind": "dialogue",
      "ko": "알고 있으리라 생각하지만―― 이 세상의 모든 것은――,\n‘가슴’의―― 크기로 정해진다.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 56,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
