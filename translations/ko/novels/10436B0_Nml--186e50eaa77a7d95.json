      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "今日は――先生にアシスタントを――お願いした。",
      "jp_sha256": "92dd4665cd7d1d54c8c2818b0c8ab0849b515225f6887d61a744b98f28198a5b",
      "kind": "dialogue",
      "ko": "오늘은―― 선생에게 보조를―― 부탁했다.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 51,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
