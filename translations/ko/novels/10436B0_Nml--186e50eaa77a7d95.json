      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "シルバさんの授業が始まった。\nアシスタントが必要な授業ってなんだろうと思いきや……。",
      "jp_sha256": "4732bf1819b379ae5733fb72f34872e0343bbb05bdd1e9e8e250e7296ccf48eb",
      "kind": "dialogue",
      "ko": "실바 씨의 수업이 시작됐다.\n보조 교사가 필요한 수업이 대체 뭘까 했더니…….",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 49,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
