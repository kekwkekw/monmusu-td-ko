      "kind": "dialogue",
      "ko": "제법 분위기 있는 숲이네.\n여기라면 강력한 몬스터 소녀가 있을 것 같아.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 29,
