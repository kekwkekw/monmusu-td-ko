      "jp": "ご主人、アタシに用ってなに？",
      "jp_sha256": "858abdf229348c6577728a0f4eb53047cd5d2680d9620bc0b357e8f6f65ccf7d",
      "kind": "dialogue",
      "ko": "주인, 나한테 볼일이 뭐야?",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 41,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
