    },
    {
      "command": "",
      "draft_row_sha256": "b6247bbec00b96b0730b84abdf365d02392979ede9750382607eb4c36f19540c",
      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ああ、なるほど。\nいつものやつですね……。",
      "jp_sha256": "0af613194e2840638a35bd4f18e49f08c64162af42fa0956bd1e4288ace4863c",
      "kind": "dialogue",
      "ko": "아아, 그렇군요.\n늘 있는 일이네요…….",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 29,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
