    {
      "command": "",
      "draft_row_sha256": "7705393e529764ae93b1ed41d51c27db1d2083a8512d62b2d7a940e7e86e1c90",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "任せて、ご主人さま！\n進化した私の力で、前よりもっとご主人さまを守れるってとこ、\n証明してみせるから！",
      "jp_sha256": "28736af6e4d4a55a8ca1d9209d62de4535cd1425ffce465bb573a7929a077001",
      "kind": "dialogue",
      "ko": "맡겨 줘, 주인님!\n진화한 내 힘으로 전보다 더 주인님을 지킬 수 있다는 걸,\n증명해 보일 테니까!",
      "message_index_0based": 10,
