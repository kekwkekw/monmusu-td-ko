      "kind": "dialogue",
      "ko": "아무래도 눈앞의 숲에서 마물들이 온 모양입니다.\n마물의 방해를 어떻게 피하느냐도 이 레이스의 묘미죠.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 72,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
