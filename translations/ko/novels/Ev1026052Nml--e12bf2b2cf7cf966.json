      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そう―――だ――。私だって―――ご主人様―――に\nミルクを―――絞って―――欲しい―――から――――な。\nここは――――公平に――――ローテを組ん――で―――。",
      "jp_sha256": "ff5359fc7ecc47570ddcc9b76d5045640db1b39ec193d3558dd69f7e43d384a6",
      "kind": "dialogue",
      "ko": "그래―――. 나도―――주인님―――께\n우유를―――짜 달라고―――하고 싶으―――니.\n여기는――――공평하게――――순번을 짜――서―――.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 18,
