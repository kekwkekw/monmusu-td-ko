      ],
      "speaker": "",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "866c5304381c67d2e45ea4442a01cd715a700ad29829c610cd43ca14aa6dc873",
