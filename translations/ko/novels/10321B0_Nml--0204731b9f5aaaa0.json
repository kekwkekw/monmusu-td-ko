      "kind": "dialogue",
      "ko": "어쩐지 감회가 새롭네요.\n그때는 매운 걸 먹으려고 수련하셨는데.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 19,
