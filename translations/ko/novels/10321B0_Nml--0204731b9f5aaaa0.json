    {
      "command": "",
      "draft_row_sha256": "fb1dbd109bb8a5fd6e5a8b98c7dd12af8a2ac89e5c1e7a541ef535f4a453ad9c",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "はい、最近寒い日が続いていたので、\nお鍋は身体が温まりそうですね。",
      "jp_sha256": "0b7468e870df8cc9e803b74efed21b736da5b1cad5c195a24a9334f520ba6d0f",
      "kind": "dialogue",
      "ko": "네, 요즘 추운 날이 이어졌으니,\n전골을 먹으면 몸이 따뜻해지겠네요.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 32,
