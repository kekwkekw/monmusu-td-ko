    {
      "command": "",
      "draft_row_sha256": "06ec46d6e9b3e7baeda96974fdf88dd47cf7a06ebbf6e29364be8af34086a71f",
      "grid_index": 0,
      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "うっ、すごい辛い匂い……！\nっていうか鍋の中が真っ赤で、滅茶苦茶辛そうですね……。",
      "jp_sha256": "ea3f2762412b2b2655715dab88e28c9e8d2dbc22959f9e38e82ed87a2ee006ba",
      "kind": "dialogue",
      "ko": "윽, 엄청 매운 냄새……!\n그보다 냄비 안이 새빨개서 엄청나게 매워 보이네요…….",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 16,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "f141bf2dc29c3a29296179145aa3fa67970c98e47c8ee5721429257f10c6ecaf:000000_-3542472672250371368:g0:r15",
      "row_index_0based": 15,
      "serialized_row_index": 15,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "うっ、すごい辛い匂い……！\nっていうか鍋の中が真っ赤で、滅茶苦茶辛そうですね……。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "65823f7598ab20229cea331d89efaf4cbb312397b1998356bcdba50d9b06f4e9",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ふふふ、嬉しい誤算というか……。\nフロストドレイク娘になったことで、\n辛さを克服することが出来たのよ。",
      "jp_sha256": "760df849d1d0c18e9a836ac8405a82893c595015ec8348047ffd0de9c1a11de4",
      "kind": "dialogue",
      "ko": "후후후, 기쁜 오산이라고 할까…….\n프로스트 드레이크 소녀가 되면서,\n매운맛을 극복할 수 있게 됐어.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "f141bf2dc29c3a29296179145aa3fa67970c98e47c8ee5721429257f10c6ecaf:000000_-3542472672250371368:g0:r16",
      "row_index_0based": 16,
