      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そう言いながら、フリスさんは鍋から具材を\nお椀によそって僕に手渡してくれる。",
      "jp_sha256": "4807ce834b5657d411da57b4edc2ad3d9fa6bab179c42d2287375dbbdefa400c",
      "kind": "dialogue",
      "ko": "그렇게 말하며 프리스 씨는 냄비에서 건더기를,\n그릇에 담아 내게 건넸다.",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 28,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
