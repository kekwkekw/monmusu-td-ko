    {
      "command": "",
      "draft_row_sha256": "cd54ea5698fe2a1b5389a590335a6cc5bed47c1c1c05c24767f7e721280d127e",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ご主人さんは辛いもの大丈夫だったわよね？\n外は寒かっただろうし、これを食べて温まってね。",
      "jp_sha256": "4aa45c21648fbed977314c576830284221b9c56cc92d71f2f2f51b8df1d6a2a5",
      "kind": "dialogue",
      "ko": "주인님은 매운 음식 괜찮았지?\n밖은 추웠을 테니 이걸 먹고 몸을 데워.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 31,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
