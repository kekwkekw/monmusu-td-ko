      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "43752e30f6e9792546ee2fc910d76f0e36b8181ec2e2c3a66e46253957322e07",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "まったくです。ご主人様を葬るならば、\nもっとイケオジになってからにしてください。",
      "jp_sha256": "6a74861f29300c43b57d057972d529b022260f2aa2fb1220176df456399cf1b9",
      "kind": "dialogue",
      "ko": "정말이지. 주인님을 장사지내려면\n좀 더 미중년이 된 다음에 해주세요.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 21,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
