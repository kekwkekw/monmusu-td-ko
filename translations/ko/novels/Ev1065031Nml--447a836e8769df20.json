      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "イケオジになっても嫌です。\nじゃなくて、今は内輪揉めをしている場合じゃ――！",
      "jp_sha256": "82e8d82d25f6590c2a86ffeb3cbea3b70d05b2478edf101f7b21eca1df00fe2b",
      "kind": "dialogue",
      "ko": "미중년이 돼도 싫어요.\n아니, 그보다 지금은 집안싸움을 할 때가――!",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 22,
