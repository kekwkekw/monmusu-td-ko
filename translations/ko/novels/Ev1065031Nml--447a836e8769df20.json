      "kind": "dialogue",
      "ko": "으아아악!!\n뭐, 뭐, 갑자기 무슨 짓이에요, 브라이니 씨!",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 18,
