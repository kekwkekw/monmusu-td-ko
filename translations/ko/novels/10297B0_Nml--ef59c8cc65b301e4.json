      "grid_index": 0,
      "grid_message_index_0based": 21,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "私の場合は英雄王からの縁もあったからな。\n戦いの場でもお互いの力が分かっているからこそ、\n連携もうまくいっているわけで――。",
      "jp_sha256": "b7ec86e4c7b82ed08358228e06129dececa890695d72620eb92978687e5bdcbf",
      "kind": "dialogue",
      "ko": "내 경우에는 영웅왕에게서 이어진 인연도 있었으니까.\n전장에서도 서로의 힘을 알고 있기에\n연계도 잘 맞는 것이고――.",
      "message_index_0based": 21,
      "page_ctrl": "",
      "physical_line_1based": 62,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
