      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "こんばんは。\n怖いなら、こんな所で待ち合わせしなくても……。",
      "jp_sha256": "d6c1091fa00f55c508f4cbea57c54ebf4ac307f7f0253a538af077e659e37594",
      "kind": "dialogue",
      "ko": "안녕하세요.\n무섭다면 이런 곳에서 만나지 않아도…….",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
