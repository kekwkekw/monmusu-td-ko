      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ククク……、\n闇の魔術の天才たる我と契約を結べる事、光栄に思うがいい！",
      "jp_sha256": "afc2ccdf70b41b050fa87aa651c41e5a11a61d72ae0da2780dda37d9a06f39b6",
      "kind": "dialogue",
      "ko": "크크크……,\n어둠의 마술 천재인 나와 계약을 맺을 수 있음을 영광으로 여겨라!",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 61,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
