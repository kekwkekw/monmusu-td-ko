    {
      "command": "",
      "draft_row_sha256": "0d2b4448764a2dd5ac3fe8f88b827af3b4a7e367082c40aac1eff16e67063d2b",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あ、ああっ、暑いぃぃ～～っ！\nこんなのバテちゃうよ～。\nどうして！？　なんで砂漠になってるのーーっ！？",
      "jp_sha256": "f6793489b1b67a7830e3eb5521a0f5eecc79df3ba4cc0f6e852d337e540c3b19",
      "kind": "dialogue",
      "ko": "아, 아아, 더워어어～～!\n이러다 지치겠어~.\n왜!? 왜 사막이 된 거야아아!?",
      "message_index_0based": 10,
