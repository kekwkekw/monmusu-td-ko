      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ふふふ、それは着いてからのお楽しみだよ。\n他ならぬ私が言うんだから、期待していいからね。",
      "jp_sha256": "1dc9e1041f70fb7f832502e37b19ea783540ec5608aad5bbfa67add7ab24bbc0",
      "kind": "dialogue",
      "ko": "후후후, 그건 도착한 뒤의 즐거움이야.\n다른 누구도 아닌 내가 말하는 거니까 기대해도 좋아.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 18,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
