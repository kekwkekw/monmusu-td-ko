    {
      "command": "",
      "draft_row_sha256": "fa79d752b2c9f4ed1d048e082c5d72d8aac43e2506567012f6d43c60cab62305",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "意味が違う！\n私は命を狙っていただけです！　ラシオネル王子に好意など\n微塵も持っておりません！",
      "jp_sha256": "802e3c446f3c6dd65394783a57c308cde2a9c124962ccae285daac2016df09f9",
      "kind": "dialogue",
      "ko": "의미가 다르잖아!\n나는 목숨을 노렸을 뿐입니다!　라시오넬 왕자님께 호감 따위는\n조금도 품고 있지 않습니다!",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 35,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
