      "kind": "dialogue",
      "ko": "그것도 사과할게요!\n이, 이렇게 훌륭한 아지트를 만들다니 대단해요!",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 18,
