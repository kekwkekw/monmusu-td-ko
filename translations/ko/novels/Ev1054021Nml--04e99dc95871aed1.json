      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "メロンを高速で運び、\nあなた達の到着を先回りしただけです。簡単な事ですよ。",
      "jp_sha256": "700de1f097df53fb75e18b1a756172c8ab5c896687afa63b88ea1c4d5eec8a76",
      "kind": "dialogue",
      "ko": "멜론을 고속으로 운반해서,\n당신들이 도착하기 전에 앞질러 왔을 뿐입니다. 간단한 일이지요.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 36,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
