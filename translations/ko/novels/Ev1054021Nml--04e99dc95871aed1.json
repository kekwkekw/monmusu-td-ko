      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "先程も言ったでしょう。\n可愛い学生たちを育てるため、必要なことなのです。\n決して「面白そうだったから」ではありません。",
      "jp_sha256": "6f5a8c6d6b3ffd5a112e5871c021e2bcd126af214af64f49af4dce5414e9d7c4",
      "kind": "dialogue",
      "ko": "아까도 말했지 않습니까.\n귀여운 학생들을 성장시키기 위해 필요한 일입니다.\n결코 「재미있어 보였기 때문」은 아닙니다.",
      "message_index_0based": 11,
      "page_ctrl": "",
      "physical_line_1based": 38,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
