    {
      "command": "",
      "draft_row_sha256": "08276808d2dfbffae8f414a862a93dd36bb0cd8b81aa78abe0b28a0db925c1eb",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そ、それは駄目じゃ！\nワシのこのボディーは正真正銘のワンオフ機！\n下手に解体なんかしたら取り返しがつかんゾイ！",
      "jp_sha256": "b9ce96ba6cd6a58be36dbe2bea7bff9bd2709c67906e4412b9f29aa734902408",
      "kind": "dialogue",
      "ko": "그, 그건 안 된다!\n내 이 보디는 틀림없는 원오프 기체!\n함부로 분해했다가는 돌이킬 수 없다!",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 67,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
