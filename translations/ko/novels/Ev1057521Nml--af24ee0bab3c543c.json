      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "う、ウッチュー・ノット・リターイだト！？\nこのヘンテコなロボットガ……！？",
      "jp_sha256": "3ad25c891e76e376f247b58e731ed621798c1b22d0b81eb8c43a4f0cec9fd909",
      "kind": "dialogue",
      "ko": "우, 웃츄・노트・리타이라고!?\n이 괴상한 로봇이……!?",
      "message_index_0based": 6,
      "page_ctrl": "",
