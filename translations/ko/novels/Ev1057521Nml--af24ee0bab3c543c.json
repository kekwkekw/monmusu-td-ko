      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ウオッフォンッ！　それでは改めて、\nワシこそがウッチュー・ノット・リターイ、\n改め、ウッチューロボである！",
      "jp_sha256": "25adde34b99d2313940e8d516b058cad08a3609d0c5316f6c71869ea1c93df08",
      "kind": "dialogue",
      "ko": "어흠! 그럼 다시 소개하지.\n나야말로 웃츄・노트・리타이, \n다시 말해 웃츄 로보다!",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 50,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "a45c2d9707c22131747f956c7de6ed15853b56bfe5c21b8a94451085f99ebffc:000002_1081592009447814415:g0:r49",
      "row_index_0based": 49,
      "serialized_row_index": 49,
      "source_cells": [
        "",
        "",
        "ウッチューロボ",
        "",
        "",
        "",
        "",
        "",
        "",
        "ウオッフォンッ！　それでは改めて、\nワシこそがウッチュー・ノット・リターイ、\n改め、ウッチューロボである！"
      ],
      "speaker": "ウッチューロボ",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "e013a9d538eb0f140f80975f258c5f9be93b94d231b8f43ba4750fe8609d7a15",
