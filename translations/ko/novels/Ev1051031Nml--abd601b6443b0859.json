    {
      "command": "",
      "draft_row_sha256": "04b947e336218636c2bae78b152438f63d90a71f41ddd175896938eee48f5a71",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "はい、演技です。\nでもあの勇者さんの方は本気で戦っているんですよ。",
      "jp_sha256": "99e3a7a7b175d4aff53050872759144972e764335c3888abb0b30ce18b89260f",
      "kind": "dialogue",
      "ko": "네, 연기예요.\n하지만 저 용사분 쪽은 진심으로 싸우고 있어요.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 39,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
