    {
      "command": "",
      "draft_row_sha256": "5494e7657409aa8a2ef919f0dacb115321653b913a359e07317516c6ef914e9b",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あれは一体何をしているんですか……？\n襲われてるみたいですけど……今度こそ演技ですよね？",
      "jp_sha256": "6e48b45e8619fafb51583d6089ac2c5b1c468fdbed64f187c7fd0af13041e00e",
      "kind": "dialogue",
      "ko": "저건 대체 뭘 하는 건가요……?\n습격당하는 것처럼 보이는데…… 이번에야말로 연기 맞죠?",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 38,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
