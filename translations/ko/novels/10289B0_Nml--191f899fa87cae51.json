      "page_ctrl": "",
      "physical_line_1based": 52,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-20261104-ab86-10289B0_Nml-r1-8736667f",
      "review_note": "나나에가 들여보낸다는 말의 뜻을 되묻는 반응을 보존했다. #27~29에서 들여보내다를 일관되게 사용한다.",
      "review_status": "reviewed",
      "row_id": "bb932d2c7b01bd197755eb917aa4774c790828fba50997fca6b9d04b01d1ed32:000000_-6398324788499329418:g0:r51",
