    {
      "command": "",
      "draft_row_sha256": "eea3371530f2140e64d7adf1b65e8e4f8f66aa41cb0e9d51c6d1b7d5949ed7ee",
      "grid_index": 0,
      "grid_message_index_0based": 24,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "もしも、ご主人さまの全てを見る事、\n知る事ができないなら……わたくしは――。",
      "jp_sha256": "450011ff7b23753ca28b6cb592ae97f6e65ee1d1229c2a4f2b7f59ad336c82bf",
      "kind": "dialogue",
      "ko": "만약 주인님의 모든 것을 보는 것도,\n아는 것도 불가능하다면…… 저는――.",
      "message_index_0based": 24,
      "page_ctrl": "",
      "physical_line_1based": 48,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-20261104-ab86-10289B0_Nml-r1-8736667f",
      "review_note": "보는 것과 아는 것의 병렬을 유지하면서 두 후보의 긴 명사 연결을 자연스럽게 정리했다. 뒤의 위협은 미완성이므로 무엇을 하겠다는지 임의로 완성하지 않았다.",
      "review_status": "reviewed",
      "row_id": "bb932d2c7b01bd197755eb917aa4774c790828fba50997fca6b9d04b01d1ed32:000000_-6398324788499329418:g0:r47",
      "row_index_0based": 47,
      "serialized_row_index": 47,
      "source_cells": [
