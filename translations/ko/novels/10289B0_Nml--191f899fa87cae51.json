      "grid_index": 0,
      "grid_message_index_0based": 18,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "暗く閉ざされた場所での監視を受け入れるか、\nわたくしと一生一緒に鐘の中で過ごすか……、\nどちらかを選んでくださいまし。",
      "jp_sha256": "afb8615019816263c22227215c335d84d50142e790514e9e54ea6fafe2358c21",
      "kind": "dialogue",
      "ko": "어둡고 폐쇄된 곳에서 감시받는 것을 받아들이실지,\n저와 평생 함께 종 안에서 지내실지……,\n둘 중 하나를 골라 주세요.",
      "message_index_0based": 18,
      "page_ctrl": "",
