      "voice": "ch_10289/R18/10289B0_10289_Nml/10289B0_10289_012"
    },
    {
      "command": "",
      "draft_row_sha256": "ba97eac217a02904f7f53d04e546be1733f1b508132a4e0ee5c80e13988983d8",
      "grid_index": 0,
      "grid_message_index_0based": 28,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "僕の中にナナエさんはいます。いつも僕と一緒に居ます。\nナナエさんの心の中にも……僕を入れて下さい。",
      "jp_sha256": "eb15138f98e80d115a7dc138699192ad970ca2e88d189663d7eb78c933a87bab",
      "kind": "dialogue",
      "ko": "제 안에는 나나에 씨가 있어요. 언제나 저와 함께 있어요.\n나나에 씨의 마음속에도…… 저를 들여보내 주세요.",
      "message_index_0based": 28,
      "page_ctrl": "",
      "physical_line_1based": 53,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
