    {
      "command": "",
      "draft_row_sha256": "b2e6784b828b1ac7961673d83f9fa2894c6e0ec1af0bc79c7dd4ed7d4a5e1747",
      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "逃げるのを止めて止まってくれたら……、\nこの怖い顔も止めて差し上げますわ。",
      "jp_sha256": "d0bc864fdb8db2f5631691bfaf84cd091a9a2c4cce99522139965127662d6001",
      "kind": "dialogue",
      "ko": "도망치는 걸 멈추고 제자리에 서 주신다면……,\n이 무서운 표정도 풀어 드리겠어요.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 15,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-20261104-ab86-10289B0_Nml-r1-8736667f",
      "review_note": "A의 표정도 풀어 드리겠어요를 채택했다. B의 무서운 얼굴도 그만둬 드리겠어요는 내용은 이해되지만 한국어 결합이 부자연스러워 유창성 이슈로 기록했다.",
      "review_status": "reviewed",
      "row_id": "bb932d2c7b01bd197755eb917aa4774c790828fba50997fca6b9d04b01d1ed32:000000_-6398324788499329418:g0:r14",
