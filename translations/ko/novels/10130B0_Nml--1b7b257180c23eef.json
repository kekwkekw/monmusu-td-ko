      "kind": "dialogue",
      "ko": "주인님. 야영하려면 물가 가까운 곳이 좋아.\n오늘은 누타바가 잠자리 만들어 뒀어.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 9,
