      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "え？　ばばあ……？\nっていうか、こまんどってなんですか。\nそんな高い位置の飾りは、モンスター娘さんに頼んだ方が……。",
      "jp_sha256": "df0ff7a02bbced4ecc8dc751c4e08dfb018fb16e773f386324a0249ad7c7cf82",
      "kind": "dialogue",
      "ko": "네? 할망구……?\n그보다 커맨드가 뭔데요.\n그렇게 높은 곳의 장식은 몬스터 소녀분께 부탁하는 편이…….",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 9,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b016-20261109-0cc9675e465a",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "0c468d7e530de42bc578f93073aaef88256cb198030d6344b26e412a21c2a03c:000000_-6392785616919935808:g0:r8",
      "row_index_0based": 8,
      "serialized_row_index": 8,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "え？　ばばあ……？\nっていうか、こまんどってなんですか。\nそんな高い位置の飾りは、モンスター娘さんに頼んだ方が……。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "f1acc96a9e0d59e41ffed6e9cdd28dae8fa134902cffb2734dd72a8e72168761",
