      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "しょ、勝負……？\nいったい何の勝負でしょうか……？",
      "jp_sha256": "5fac1267f09d88c8b8039536feb51109d8f180810080306daa5bab73a92ee74b",
