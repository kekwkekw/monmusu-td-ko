      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "fd100e283bed1f100fa54f5ff4aeb467b618db7c423fc1f9195a944d1889ba5f",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "はーっはっは！　ご主人、足下には気をつけないとな？\nどこに触手トラップがあるか、分からないんだぞ！",
      "jp_sha256": "6eb663560b51cde71d960738415476193c99171a401c8f020f30dd0b22ffc271",
      "kind": "dialogue",
      "ko": "하――하하! 주인, 발밑을 조심해야지?\n어디에 촉수 트랩이 있을지 모르잖아!",
      "message_index_0based": 11,
