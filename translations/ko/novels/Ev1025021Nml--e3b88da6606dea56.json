      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "うわああっ！！　な、なんですか、これ！？",
      "jp_sha256": "054da5145ee9b05870bcca669e29bda581bce12815cde9e727f933cbe3612b18",
      "kind": "dialogue",
      "ko": "우와앗!! 뭐, 뭔가요 이거!?",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 36,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
