      "kind": "dialogue",
      "ko": "조사에 따르면 이 숲을 빠져나간 곳에 진실의 마을이 있는 모양이네요.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 11,
