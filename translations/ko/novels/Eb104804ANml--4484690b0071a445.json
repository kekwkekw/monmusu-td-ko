    {
      "command": "",
      "draft_row_sha256": "44dfc1918a340f4e8a70e1e838c64c59a18e86e38531e8ed61c2459be5147d96",
      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "天使さんというのは止めよ。神に与えられし私の名はオシュネー。\n邪なる者の手からこの世界を解放するため、\n神の忠実なしもべとして……少年、貴殿を処刑する。",
      "jp_sha256": "fc9b989f9b18970560cdcb13a653c7dff6efb2b0fa6d9e9a64e3ba8369c60a05",
      "kind": "dialogue",
      "ko": "천사 씨라고 부르지 마라. 신께서 내리신 내 이름은 오슈네.\n사악한 자의 손에서 이 세계를 해방하기 위해,\n신의 충실한 종으로서……소년, 그대를 처형하겠다.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 15,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
