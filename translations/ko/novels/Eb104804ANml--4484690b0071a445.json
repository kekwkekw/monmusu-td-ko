      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ど、どうも……はじめまして。\n手紙をくださった天使さんはあなたですよね？",
      "jp_sha256": "4f840bd9ac856550fd9d17de6ebddcae478f08c05c1775ab333551131e23647a",
      "kind": "dialogue",
      "ko": "처, 처음 뵙겠습니다……\n편지를 보내 주신 천사 씨가 당신이죠?",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
