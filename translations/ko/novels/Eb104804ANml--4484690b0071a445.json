    },
    {
      "command": "",
      "draft_row_sha256": "d4f5ab4debcd7fc5fdab4c145c050941fe421bd4165b1c97cc16a8469e43e606",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "フン、自分の頭で考える力もない人形が言ってくれる！\nこの少年は私の獲物。貴様など、すぐに神の元へ送ってやる！",
      "jp_sha256": "4618ec6ee55cb716f317ad0e88a2dd2d66a814521cc8845e872436749483c5f5",
      "kind": "dialogue",
      "ko": "흥, 자기 머리로 생각할 힘도 없는 인형이 잘도 지껄이는군!\n이 소년은 내 사냥감. 네놈 따위는 당장 신의 곁으로 보내 주마!",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 22,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
