    {
      "command": "",
      "draft_row_sha256": "32db4a152ad796e490e74ee65f6735eb59e101788fd75f4bad3d128eafe9152a",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それは、そこの下品な悪魔モンスター娘に吹きこまれたのか？\n――さすが虚言や妄言は悪魔のお家芸だな。",
      "jp_sha256": "e0a50f543cd7f2f91ec7655b7a802eb6678ab0c51fa190071548e670d36e1d1e",
      "kind": "dialogue",
      "ko": "그건 저 천박한 악마 몬스터 소녀가 불어넣은 말인가?\n――역시 거짓말과 망언은 악마의 특기군.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
