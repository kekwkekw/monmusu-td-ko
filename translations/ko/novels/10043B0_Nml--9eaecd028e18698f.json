      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "た、確かにその通りですね！\n……と、止まりました。\nでも、また歩こうとすると……足が真横に出ちゃうんです……。",
      "jp_sha256": "3c9f9f84b54a34e7075f4717f3cf3113b00e8519a262726083264783d6ecf7e4",
      "kind": "dialogue",
      "ko": "마, 맞는 말씀이에요!\n……머, 멈췄어요.\n하지만 다시 걸으려고 하면……발이 옆으로 나가 버려요…….",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 35,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
