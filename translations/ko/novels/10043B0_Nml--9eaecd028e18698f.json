    {
      "command": "",
      "draft_row_sha256": "9b45b5d403fabff43a0821cb8b8295223810deb33fbd29ce539c6379773d8506",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あっ、ご主人様っ。夜遅くにすみませぇん……。\nちょっと相談したいことがあって、訪ねたんですけど\n緊張し過ぎて横歩きが戻せなくなっちゃって……。",
      "jp_sha256": "16f2157ae71619f24c1e4374307c79dc3d4d624f33e6e14fc21a7514e87ea685",
      "kind": "dialogue",
      "ko": "앗, 주인님. 늦은 밤에 죄송해요…….\n조금 상담드리고 싶은 게 있어서 찾아왔는데\n너무 긴장해서 옆걸음을 멈출 수 없게 됐어요…….",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 29,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
