      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "うぅ、ドアを開けたいのに開けられない……。\nまっすぐ歩かなきゃいけないのに、横歩きになっちゃうぅ……。",
      "jp_sha256": "30b105a8ed89fa6bec8666278ed85941939f9f1066553eda14ba4cd3b7cd770c",
      "kind": "dialogue",
      "ko": "우으, 문을 열고 싶은데 열 수가 없어…….\n똑바로 걸어야 하는데 자꾸 옆걸음질을 하게 돼…….",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 26,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
