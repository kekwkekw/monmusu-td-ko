    {
      "command": "",
      "draft_row_sha256": "961ae24cc480e84ac99bba18f17462467a5edda80efb6d6dc6c53b95ea53ea96",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "大丈夫ですよ、ほら。相談があるんですよね？\n話を聞きますから……どうぞ。",
      "jp_sha256": "5c189025f6f966df797fb3fee3411741f3b4338c691371b2d010ca06769b059b",
      "kind": "dialogue",
      "ko": "괜찮아요, 자. 상담할 게 있으신 거죠?\n이야기를 들을 테니……손 주세요.",
      "message_index_0based": 10,
      "page_ctrl": "",
