        "密猟者",
        "",
        "",
        "",
        "",
        "",
        "",
        "もっ、モンスター娘の言う事なんか信じられるか！"
      ],
      "speaker": "密猟者",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "781b97b8da90e0ae2b42ae7e7f91e8ba63d987bd8a27a5d4fb961f12c99d19f9",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "信じて。\n討ちたくない……討たせないで。",
      "jp_sha256": "f70150e774b8625714b54b0737e87419555c3b85a5e959536295c74786b485b2",
      "kind": "dialogue",
      "ko": "믿어 주세요.\n베고 싶지 않아요…… 베게 하지 마세요.",
      "message_index_0based": 11,
      "page_ctrl": "",
      "physical_line_1based": 30,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
