    {
      "command": "",
      "draft_row_sha256": "38b699503905aae07a1fb1f570273e3b130e3cbff3e3fd8925ea02de6dfbf78d",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "う、うん……この花嫁衣装を着てると幸せになれる、\nっていう伝説……。だ、だから、えっと……、\n脱ぐのがもったいないっていうか……その……。",
      "jp_sha256": "171966f698700dbf4b069109a4b56ce214497859976ca34483011bbb49dd10e6",
      "kind": "dialogue",
      "ko": "으, 응…… 이 신부 의상을 입고 있으면 행복해진다는\n전설…… 그, 그래서, 저기……\n벗기가 아깝다고 해야 하나…… 그게…….",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
