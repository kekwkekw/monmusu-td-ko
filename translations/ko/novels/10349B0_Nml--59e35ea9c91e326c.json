        }
      ],
      "jp": "すっかりその衣装、気に入ってるんですね。<interval=0.8>\nここのところ、毎日着てるじゃないですか。",
      "jp_sha256": "f98a9f4803d4e4ed9a23a8147d57ebc56f6354a7979db94b231d3451acd537e8",
      "kind": "dialogue",
      "ko": "그 의상이 완전히 마음에 들었나 보네요.<interval=0.8>\n요즘 매일 입고 있잖아요.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 10,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
