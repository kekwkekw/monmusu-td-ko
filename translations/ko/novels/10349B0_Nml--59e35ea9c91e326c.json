      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "コカトリス娘の求愛行動ってね、本当はすっごく派手なんだよ。\nばっさばっさって翼を大きく動かして、\nできるだけたくさんの羽根を舞わせるの。",
      "jp_sha256": "aba88dcb8c699b29e2433cdb0ed3f5b67b1db26e7926661088ec132ef694981a",
      "kind": "dialogue",
      "ko": "코카트리스 소녀의 구애 행동은 말이야, 사실 굉장히 화려해.\n날개를 파닥파닥 크게 움직여서\n가능한 한 많은 깃털을 흩날리는 거야.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 19,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b008-20261106-451bb6a2fb2c21c5",
      "review_note": "",
      "review_status": "reviewed",
