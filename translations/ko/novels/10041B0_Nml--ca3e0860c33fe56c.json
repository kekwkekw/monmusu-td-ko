      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "わぁっ！　ご、ご主人さま！？\nなっ、えっ、ど、どうしてここにいるの！？",
      "jp_sha256": "a6e60e66842de4ef19379d587506dbff6c4cb7fa7218a05523195fb8b377db36",
      "kind": "dialogue",
      "ko": "와앗! 주, 주인님!?\n뭐, 어, 어, 어떻게 여기 있어!?",
      "message_index_0based": 11,
