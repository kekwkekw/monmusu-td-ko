      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ん～～っ……風が気持ちいいですね！\nエテジアさん、誘ってくれてありがとうございます！",
      "jp_sha256": "e0db64a0e8a32c19874dae5289e78c6342a4aba47ec2930fad189b83cebe74f4",
      "kind": "dialogue",
      "ko": "음~~…… 바람이 기분 좋네요!\n에테지아 씨, 불러 줘서 고마워요!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 9,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
