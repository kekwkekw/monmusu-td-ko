    {
      "command": "",
      "draft_row_sha256": "693d102d9f6b7c112430dc57b1b44cedeb0d2fdb887580bde6ed8c7fd96708ed",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あはは……エテジアさん、\n最近その顔を隠さなくなってきましたね。",
