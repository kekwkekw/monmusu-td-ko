      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "むしろ、私の方こそ……。\n風に吹かれて微笑む美少年の姿……うふふ、絵になるわ。\nえへへぇご馳走様……おっと涎が……。",
      "jp_sha256": "89d0f6a5e71798f91db5a09ca1d41c81634c1fba74f7343b7e2ed85912a43e9b",
      "kind": "dialogue",
      "ko": "오히려 내가 더…….\n바람을 맞으며 미소 짓는 미소년의 모습…… 우후후, 그림이 되네.\n에헤헤, 잘 먹었습니다…… 앗, 침이…….",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 39,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
