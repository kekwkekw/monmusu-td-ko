    },
    {
      "command": "",
      "draft_row_sha256": "f65054ccafc28ffebc64255e7cde494e57fb188cae76dbf2d99f17dcaabb8687",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "\"異種族の雄との交配\"がエルフの禁忌とされている理由が、坊や、\nいや、創世記の少年にある、などという仮説はどうだろうか？",
      "jp_sha256": "eb1977064b92b3618b0ca54de58b380db4d2098f5a147582754abf116eba0c68",
      "kind": "dialogue",
      "ko": "'이종족 수컷과의 교배'가 엘프의 금기로 여겨지는 이유가, 도련님,\n아니, 창세기의 소년에게 있다는 가설은 어떨까?",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 37,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "282686f8d35420f6521210fc2afc6409e2f71edb59150a01800147cf674d5e02:000002_1496926655719114222:g0:r36",
      "row_index_0based": 36,
      "serialized_row_index": 36,
      "source_cells": [
        "",
        "",
        "ソーヴェグラー",
        "Emt3_Gla",
        "layer_左",
        "",
        "",
        "0.3",
        "",
        "\"異種族の雄との交配\"がエルフの禁忌とされている理由が、坊や、\nいや、創世記の少年にある、などという仮説はどうだろうか？",
        "",
        "",
        "",
        ""
      ],
      "speaker": "ソーヴェグラー",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "079b2bb924010c4d3125a5878f2b8699b034efbe157f814754880f54a64286f8",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "……黙りなさい。\n不浄なものたちと交わす言葉など、これ以上ありません。",
      "jp_sha256": "7a0ae1757fa0ec3e3eb9cd31e36f1955aa536644593e85cbf4f2ca3d26160e9e",
      "kind": "dialogue",
      "ko": "……입 다무세요.\n부정한 자들과 나눌 말은 더 이상 없습니다.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 40,
