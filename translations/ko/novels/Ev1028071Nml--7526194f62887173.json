      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "ec9e213cda9874596f84dd10108fa2c958435fd8c94cd9b58d10af9f3640cd81",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そうやって、ご主人のこと悪者にしてさ。\nこの津波を起こしたのは、私らだけど、\n元はといえば火をつけた人間が悪いんじゃん。",
      "jp_sha256": "3c49cb6e5be53bc0983f64c1c488adb1a922943a924a55fb34037a5f285f1a01",
      "kind": "dialogue",
      "ko": "그렇게 주인님을 악당으로 몰고 말이야.\n이 쓰나미를 일으킨 건 우리지만,\n애초에 불을 지른 인간들이 잘못한 거잖아.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 35,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
      "review_note": "",
      "review_status": "reviewed",
