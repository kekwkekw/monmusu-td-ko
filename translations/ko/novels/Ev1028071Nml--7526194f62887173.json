      "grid_message_index_0based": 2,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あんな大津波が襲ってきたらそりゃそうですよ。\nまずはエルフの皆さんを探さないと……！",
      "jp_sha256": "d41c38ac2362dae62e5ae81f6f2ce0473c4a4ffa6e2d3c001e14fbacb1840e96",
      "kind": "dialogue",
      "ko": "그런 대쓰나미가 덮쳤으니 당연하죠.\n우선 엘프 여러분부터 찾아야……!",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 19,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
