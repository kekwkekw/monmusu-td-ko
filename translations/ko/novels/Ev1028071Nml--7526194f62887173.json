      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "エルフの族長を中心に、大津波を逃れたエルフたちが\n主人公たちを取り囲んだ。",
      "jp_sha256": "915518f31d680ac86c9d0a6a6722c93f37842f21f60ca5450df5352551269a68",
      "kind": "dialogue",
      "ko": "엘프 족장을 중심으로 대쓰나미를 피한 엘프들이\n주인공 일행을 에워쌌다.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 27,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "282686f8d35420f6521210fc2afc6409e2f71edb59150a01800147cf674d5e02:000002_1496926655719114222:g0:r26",
      "row_index_0based": 26,
      "serialized_row_index": 26,
      "source_cells": [
        "",
        "",
        "",
        "",
