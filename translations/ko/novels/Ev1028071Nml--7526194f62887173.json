    {
      "command": "",
      "draft_row_sha256": "61dbd99edab586989234eec380339eb6512260a6bec012e1a164e2c3a578e6e0",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "大人しく投降しなさい。明らかに数でこちらが勝っている。\n利口な少年であれば、この状況で\n勝機がないことは分かっているはずです。",
      "jp_sha256": "bd759b6ba93fc8734f4a80a21199760a30c0767b86e9cb14a8e9925bc33b7877",
      "kind": "dialogue",
      "ko": "얌전히 투항하세요. 명백히 숫자는 이쪽이 우세합니다.\n영리한 소년이라면 이 상황에서\n승산이 없다는 건 알겠지요.",
      "message_index_0based": 10,
