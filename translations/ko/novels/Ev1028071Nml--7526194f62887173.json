      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そこまで頑なに坊やを”悪”としたいのには、\n理由があるのではないのかな？　そう、例えば――。",
      "jp_sha256": "123db1fd4c0cc7aca000024d0ffbd5545607e5f296b34184e824755b7c2a62ab",
      "kind": "dialogue",
      "ko": "그토록 완고하게 도련님을 '악'으로 만들고 싶은 데는,\n이유가 있는 것 아닌가? 예를 들어――.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 36,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "282686f8d35420f6521210fc2afc6409e2f71edb59150a01800147cf674d5e02:000002_1496926655719114222:g0:r35",
      "row_index_0based": 35,
      "serialized_row_index": 35,
      "source_cells": [
