    {
      "command": "",
      "draft_row_sha256": "5824a972bc4917b74f4ab42de7c4fa12b5b8d34d4d7d9417b1d1af5cc961aa92",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [
        {
          "end": 46,
          "raw": "<interval=0.4>",
          "start": 32
        }
      ],
      "jp": "こんにちは、ご主人様。\n私は裁きを司る、雲外鏡娘のカガミヤです。<interval=0.4>\nよろしくお願いいたしますね。",
      "jp_sha256": "58292b19c6918be6207a615a16fe2dafd2936218ceaf6f146c7f92f717c6e8ee",
      "kind": "dialogue",
      "ko": "안녕하세요, 주인님.\n저는 심판을 관장하는 운외경 소녀 카가미야입니다.<interval=0.4>\n잘 부탁드리겠습니다.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 50,
