      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "――ある日の昼下がり。\n僕は蜘蛛の軍勢に担ぎ上げられて、\nなすすべもなく、何処かへと運び込まれていた。",
      "jp_sha256": "9a10aadcad62b9a89168044891cf25928487d462df8ac40092f504aa0e115a16",
      "kind": "dialogue",
      "ko": "――어느 날 오후.\n나는 거미 군단에게 들려 올라가,\n속수무책으로 어딘가에 운반되고 있었다.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 10,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
