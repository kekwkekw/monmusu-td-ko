      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "蜘蛛に運び込まれた洞窟の奥深く。\nそこには小さな祭壇があって、\nカヅネさんが両手を合わせ、首を垂れていた。",
      "jp_sha256": "fed3c30bb7ecff057bf986b74f1f1c8ba3d7c78beaabe1c8748dd99f59de24a0",
      "kind": "dialogue",
      "ko": "거미들에게 실려 온 동굴 깊숙한 곳.\n그곳에는 작은 제단이 있었고,\n카즈네 씨가 두 손을 모아 고개를 숙이고 있었다.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 23,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
