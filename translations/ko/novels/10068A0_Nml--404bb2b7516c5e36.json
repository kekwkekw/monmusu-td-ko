    {
      "command": "",
      "draft_row_sha256": "01efcb1a42966c33a0276583bd05318abae9f2b666af95962bc74338818eda32",
      "grid_index": 0,
      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "御在天なる我らの神よ――。\n美少年と巡り合わせてくださったお導きに、感謝します。",
      "jp_sha256": "6442d488df475fbec131b1bcc659c30dfe1fba86b8415bb8b4856f5ada0fb68f",
      "kind": "dialogue",
      "ko": "하늘에 계신 우리 신이여――.\n미소년과 만나게 해 주신 인도에 감사드립니다.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 20,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
