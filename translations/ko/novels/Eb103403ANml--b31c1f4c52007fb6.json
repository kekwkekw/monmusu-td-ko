    {
      "command": "",
      "draft_row_sha256": "9ac75cdcf144738429cdca9edabf4cc297d63570dbe6da41e1a008294e6690d2",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "大丈夫ですよ。\nこちらには可愛くてカッコイイご主人様がいますから、\nちょっと歩いていれば向こうの方から――",
      "jp_sha256": "abd0e5d7978cc00cee3739b0abde878bd1a72cc9c776bcd1bc71480870302971",
      "kind": "dialogue",
      "ko": "괜찮아요.\n우리에게는 귀엽고 멋진 주인님이 있으니\n조금만 걷다 보면 저쪽에서――",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 29,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
