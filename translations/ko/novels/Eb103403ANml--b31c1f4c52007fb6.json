      "draft_row_sha256": "e75f5c58c3720e923280b29a84b7347e833983a2ff66a42ba0733d9d5f7b5d2b",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それなら今度はこちらから密猟者を探さないといけませんね……。",
