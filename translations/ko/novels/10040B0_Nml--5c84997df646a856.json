    {
      "command": "",
      "draft_row_sha256": "1d8b3dcb78a289528ba3a5bd186e3766c0544638dba4f2962084fce4067e8ead",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ニィルさんは気配を悟られずに背後から忍び寄ることが得意だ。\nその特技を見込んで、彼女に特訓をお願いしたのは事実だった。",
      "jp_sha256": "26ad552253047099910c736430dde5e6fcf6750fc09c87050e8427648493f0d4",
      "kind": "dialogue",
      "ko": "니르 씨는 기척을 들키지 않고 등 뒤에서 다가오는 데 능숙하다.\n그 특기를 보고 그녀에게 특별 훈련을 부탁한 것은 사실이었다.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 43,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
