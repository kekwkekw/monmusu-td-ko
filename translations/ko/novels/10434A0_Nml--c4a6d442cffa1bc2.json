      "grid_message_index_0based": 14,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "このドブカスども！　有罪だ、オラァ！\n何故ならこの本は、禁忌の『ショタおね本』だからなぁ！",
      "jp_sha256": "62927c8b8ea68f7dc2545bfd58e8701bcb2a7984e78b003868d65204cd16292b",
      "kind": "dialogue",
      "ko": "이 시궁창 찌꺼기들아! 유죄다, 인마!\n왜냐하면 이 책은 금기의 ‘쇼타 누나 책’이니까!",
      "message_index_0based": 14,
      "page_ctrl": "",
      "physical_line_1based": 78,
