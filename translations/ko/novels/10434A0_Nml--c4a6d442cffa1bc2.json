      "kind": "dialogue",
      "ko": "\n그러자 카가미야 씨는 자신의 게다를 딱딱 크게 울렸다.",
      "message_index_0based": 12,
      "page_ctrl": "",
      "physical_line_1based": 69,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
