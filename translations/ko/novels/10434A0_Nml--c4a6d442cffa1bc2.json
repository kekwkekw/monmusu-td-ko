    },
    {
      "command": "",
      "draft_row_sha256": "d6d8fb28a4bb9b4dab4878e7d79b48e901c1f0e79f80f5059a1bb20a8bb6acfa",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ふぅ……なるほど。審理はこの程度で十分でしょう。\nそれでは、判決を下します。",
      "jp_sha256": "37a0b22e11277eb74c3e6c0e84cffc6ef39f5c458a4a9f202c3a992405b1cd6b",
      "kind": "dialogue",
      "ko": "후우…… 그렇군요. 심리는 이 정도면 충분하겠죠.\n그럼 판결을 내리겠습니다.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 45,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
