      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "これだけ人数がいれば採掘も楽勝ですね。\nすぐに終わっちゃうんじゃないですか？",
      "jp_sha256": "c63bf1536d6d5a9d2f2dad70899ed74534a999824a2fbb6fde43c0b8ec7a507c",
      "kind": "dialogue",
      "ko": "이렇게 인원이 많으면 채굴도 식은 죽 먹기겠네요.\n금방 끝나는 것 아니에요?",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 12,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
