      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "話を聞く相手に比較的まともなモンスター娘さんを選んだのに、\n普通に変な知識を教えているとは予想外だった。",
      "jp_sha256": "d0698324030d34934ca257013b3d365b9e0fd676e80bcc191f4e1300b8d2c894",
      "kind": "dialogue",
      "ko": "이야기를 들을 상대로 비교적 멀쩡한 몬스터 소녀를 골랐는데\n평범하게 이상한 지식을 가르치고 있을 줄은 예상 밖이었다.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 34,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
