      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "助けてくれぇ！　食べられるぅ！\n変な雰囲気のモンスター娘に食べられちゃうぅぅ！！",
      "jp_sha256": "3bc43682d0cf9af17b70e10bfe234119ed442dd38b51c28f8c959ca6a0fc1f2d",
      "kind": "dialogue",
      "ko": "도와줘! 잡아먹혀!\n이상한 분위기의 몬스터 소녀에게 잡아먹힌다아아!!",
      "message_index_0based": 1,
      "page_ctrl": "",
