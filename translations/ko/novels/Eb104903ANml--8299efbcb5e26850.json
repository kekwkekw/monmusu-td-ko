    {
      "command": "",
      "draft_row_sha256": "1e7851e66b52a9464645543b5adbd10fd57877fd2bb065cc7059c1bd94f7f6ec",
      "grid_index": 0,
      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あれは……ヴェラートゥさんとシルバさんですね。\n揉めてるみたいですけど、何かあったんでしょうか？",
      "jp_sha256": "0bce38d50ebb0b3d33d399a46624d23d466cf120460dc2e598b10f99ce3d3621",
      "kind": "dialogue",
      "ko": "저건……베라투 씨와 실바 씨네요.\n다투는 것 같은데 무슨 일이 있었을까요?",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 3,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "96d042fce084a5f167bd29e2215f293fc9fc932edba7846be0fe2b68cdca37b4:000002_7920028618594699718:g0:r2",
      "row_index_0based": 2,
      "serialized_row_index": 2,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "あれは……ヴェラートゥさんとシルバさんですね。\n揉めてるみたいですけど、何かあったんでしょうか？"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "b6392efd5f07efab4efe45fce44c9a6adf816c9919b1b2a44b2e6d7202a52373",
