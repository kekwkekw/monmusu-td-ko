      "inline_tags": [],
      "jp": "シルバさん！　どうか冷静に！\nヴェラートゥさんも悪気があって言ったわけじゃないですから！",
      "jp_sha256": "880a5a802b1a850139c40dda6a670d26bf30d604ad5437436aa964ce43eecb89",
      "kind": "dialogue",
      "ko": "실바 씨! 진정해 주세요!\n베라투 씨도 악의가 있어서 한 말은 아니니까요!",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
