      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "……ああ、気づかれてしまいましたか。\n残念です。何も知らない無垢なご主人様の身体を乗っ取り、\n王道なるショタ受けを再現しようとしたのに。",
      "jp_sha256": "284b93de906872dc17a9639950de1cd12edf007c2e196ab2f3bed2240586ce0d",
      "kind": "dialogue",
      "ko": "……아아, 들켜 버렸군요.\n아무것도 모르는 순진한 주인님의 몸을 빼앗아\n왕도 쇼타 수를 재현하려 했는데.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 34,
