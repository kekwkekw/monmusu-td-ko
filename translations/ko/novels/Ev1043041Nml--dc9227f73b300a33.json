    {
      "command": "",
      "draft_row_sha256": "8ac7f5016e6ff17257d576d2773109dbda141a7d79c9e4fd733bda022ab6e2c2",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "うぅ……腐った匂い……すごく匂うぞ！\n誰か、ここにいるんだろ、姿を見せろ！",
      "jp_sha256": "b6e1f6d59b727b1331abc42a10fe609a4cc9dc756e7db6492bb03fd8c1dfcb15",
      "kind": "dialogue",
      "ko": "으으…… 썩은 냄새…… 엄청 심해!\n누가 여기 있지? 모습을 보여!",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 24,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
