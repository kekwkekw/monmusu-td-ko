      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ふえ……？　うわあっ！？\nい、いま、今何か、僕の身体を通り抜けて……っ。",
      "jp_sha256": "5edfcd46b33fd52a7cf0b834e95cfe49f94561abedf1c3547f2e3c68b08b4d9b",
      "kind": "dialogue",
      "ko": "으에……? 우와악!?\n지, 지금 무언가 제 몸을 통과해서…….",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 23,
