      "review_status": "reviewed",
      "row_id": "3878127a2413992b15ee78c630301d6af42cbea29c25d95ccb7dc8ed725f15d9:000002_1737030121126220808:g0:r10",
      "row_index_0based": 10,
      "serialized_row_index": 10,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "ば、ヴァリナさんが清掃を！？\n一体どうしたんですか！？"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "adc6b148f43cda6b01f4da4a415264c150f03be5f1289d7a48e9df7990a83b92",
