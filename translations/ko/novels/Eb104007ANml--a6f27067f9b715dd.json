    {
      "command": "",
      "draft_row_sha256": "a55b87a4ef13d0faabf67faa098e193d9022dec0a74c77d6cc2c7d15265b4909",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そっ、それにそんなの貰っても私、ダンスとか別に興味ないし！\n先生がどうしてもって言うなら考えてあげてもいいけどっっ！！",
      "jp_sha256": "1eda86caad00b0254937347628ded5f8da867f7a1a13f1b402e9f1aea7fc77e7",
      "kind": "dialogue",
      "ko": "게, 게다가 그런 걸 받아도 난 춤 같은 데 별 관심 없어!\n선생님이 꼭 부탁한다면 생각해 줄 수도 있지만!!",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 25,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "b637a718ffbc15b0c39e7e37aca3831bb562188605ca378d6ef764c827eb56ee:000002_2065561295039694792:g0:r24",
      "row_index_0based": 24,
