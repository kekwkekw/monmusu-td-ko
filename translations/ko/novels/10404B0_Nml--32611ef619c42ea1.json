      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なんでも、ずっと観察していたゲシュペンス島を、\n改めて自分の足で歩いてみたいと思ったらしい。",
      "jp_sha256": "9a14d32969ace41be7e306c34b675fa63f76c44a1b89539046512c0709cb0fe6",
      "kind": "dialogue",
      "ko": "그동안 줄곧 관찰해 온 게슈펜스 섬을,\n새삼 자기 발로 걸어 보고 싶었던 모양이다.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 25,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
