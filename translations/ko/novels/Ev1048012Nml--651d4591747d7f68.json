      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "……アークデーモン娘のアルコスっていう、\nムカつく野郎にケンカ売られたからだ。\nあのバカ、オレが腑抜けてるだの何だの言いやがって！",
      "jp_sha256": "b8296b647d8895671258955af0bfe18d21478a482597056d02b5a9ea497f1f06",
      "kind": "dialogue",
      "ko": "……아크 데몬 소녀 알코스라는,\n재수 없는 녀석이 시비를 걸었기 때문이야.\n그 바보, 내가 얼빠졌다느니 뭐라느니 지껄여서!",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 26,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
