      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あの野郎はチビが狙いらしいから、\nオレが先に倒して手柄を横取りしようと思ったんだよ。",
      "jp_sha256": "dc3e21664bb246cfb29c37efdee3f1e8bb8417d381017aab5677b40ca792d32d",
      "kind": "dialogue",
      "ko": "그 녀석은 꼬맹이를 노리는 모양이라,\n내가 먼저 쓰러뜨리고 공을 가로챌 생각이었어.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 27,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
