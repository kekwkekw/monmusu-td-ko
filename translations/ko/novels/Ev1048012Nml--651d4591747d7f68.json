    {
      "command": "",
      "draft_row_sha256": "c88b866f32ef3abd634e85c6786c15ef30a729ce9b773f17a78496033fd743da",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "アークデーモン娘がご主人さまを狙って……？\nということはあの手紙、やはり悪戯ではなかったようですね。",
      "jp_sha256": "0cf70e64cc09d6efb19307474339c74741f9dcdc967084877d94a52cd5334bd9",
      "kind": "dialogue",
      "ko": "아크 데몬 소녀가 주인님을 노린다……?\n그렇다면 그 편지는 역시 장난이 아니었던 모양이군요.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 28,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
