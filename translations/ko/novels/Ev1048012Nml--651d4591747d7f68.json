      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "さて……メド。\n負けたのですから、こちらの質問に答えてもらいますよ。\nなぜご主人さまに決闘など挑んだのですか？",
      "jp_sha256": "3c051eb6a02a2d3f6387c3f14dc94f1795547373625e96a48e763ec730979d68",
      "kind": "dialogue",
      "ko": "자……메드.\n졌으니 이쪽 질문에 답해 줘야겠습니다.\n왜 주인님에게 결투를 신청한 겁니까?",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 25,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "b4519ef5f3265ad696458b0eb970b9cd5d7629e43c5ec147646aa7370f594025:000000_-8770156106755742527:g0:r24",
      "row_index_0based": 24,
