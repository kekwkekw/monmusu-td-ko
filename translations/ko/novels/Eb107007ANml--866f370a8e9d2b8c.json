      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "その通りだ、バロウ。ヤツは自分の歌声を呪いに変え、\n各地で飾りを強奪しながら、\n負のエネルギーを増幅させて回っていたらしい。",
      "jp_sha256": "fb6cc6baf9097a4deef16a88cd8235eb6d04591fcfd85a2a99b95b56134cbaaf",
      "kind": "dialogue",
      "ko": "맞아, 바로우. 녀석은 자신의 노랫소리를 저주로 바꿔,\n각지에서 장식을 강탈하면서,\n부정적인 에너지를 증폭시켜 다닌 모양이야.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b013-20261109-same-model-pass2-5adf61fa",
      "review_note": "",
      "review_status": "reviewed",
