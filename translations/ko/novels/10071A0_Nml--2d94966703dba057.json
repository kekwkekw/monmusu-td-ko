      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それが、私の寝床の周りをでっかい犬がうろついていて……。\nそうだ！　ご主人さま、あの犬を退治してくださいよ！",
      "jp_sha256": "89aea990f4bd9561fd44956a97a70e396910adc3c024d37dc4af731e358e2ea8",
      "kind": "dialogue",
      "ko": "제 잠자리 주변을 엄청 큰 개가 돌아다니고 있어서요…….\n맞다! 주인님, 그 개를 퇴치해 주세요!",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 18,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
