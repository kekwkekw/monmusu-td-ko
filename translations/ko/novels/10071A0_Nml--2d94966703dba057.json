      "kind": "dialogue",
      "ko": "역시 도네 씨였군요.\n방금 그 비명은 또 뿌리가 빠져 버린 건가요?",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 14,
