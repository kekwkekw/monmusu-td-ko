      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "わあ！？　が、ガウミィさん！？\n急にどうしたんですか！？　あと、その言い方、\n僕が色々と勘違いされますから！",
      "jp_sha256": "0073cb64f535f0154bb984438a9b7653587dc6932f538569c7e46dd9601b4096",
      "kind": "dialogue",
      "ko": "와앗!? 가, 가우미 씨!?\n갑자기 왜 그러세요!? 그리고 그 말투,\n제가 여러 가지로 오해받으니까요!",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b011-20261107-ff47d2c5b69e",
