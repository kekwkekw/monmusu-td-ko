        "",
        "女勇者Ａ",
        "Emt2_Ang",
        "layer_左中",
        "",
        "",
        "0.3",
        "",
        "うるさい、うるさい、うるさいっ！！\nモンスター娘のいうことなんて、信じられるもんか！",
        "",
        "",
        "",
        ""
      ],
      "speaker": "女勇者Ａ",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "1ebaa7fc46d626236964d98f9e2e2c1d0422c9d0736b46e9c862ca180bbac73c",
