    {
      "command": "",
      "draft_row_sha256": "7ba96114064466a7363be2cc1d11e81f7db526fc081773d5d793de6383a9f574",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "んも～、またそんなこと言って。\nご主人くんは記憶喪失なんだもん、スラリアムだったことを\n忘れていても仕方ないよね。",
      "jp_sha256": "4df041d47eda53a276f12697387a0f3e654fe38966ca2d0b17b843ef5ee4c35e",
      "kind": "dialogue",
      "ko": "정말~ 또 그런 말 한다.\n주인 군은 기억상실이니까, 슬라리암이었던 걸\n잊었어도 어쩔 수 없지.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 69,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
