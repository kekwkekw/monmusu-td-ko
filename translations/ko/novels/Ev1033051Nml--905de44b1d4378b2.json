      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "いや、違います。僕は生まれた時から人間です。\nスライムだった記憶はありません。",
      "jp_sha256": "0e5857bfccbf9d066b35f2061618c4213d1a582335c785fadcefa477a3a01c3d",
      "kind": "dialogue",
      "ko": "아니, 아닙니다. 저는 태어날 때부터 인간이에요.\n슬라임이었던 기억은 없습니다.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 66,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
