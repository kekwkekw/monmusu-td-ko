      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あ、あはは……。\nなんとも頷きづらくはありますが、\nとりあえず異変のようなものはなさそうですね。",
      "jp_sha256": "7827ae2146ca333a26b293210dfe913104d1a0f5c8e9b71790ca1ae2a7864c74",
      "kind": "dialogue",
      "ko": "아, 아하하…….\n좀처럼 고개를 끄덕이기 어렵기는 하지만,\n일단 이변 같은 것은 없는 모양이네요.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
