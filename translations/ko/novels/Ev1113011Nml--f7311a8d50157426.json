    {
      "command": "",
      "draft_row_sha256": "2bd1f95ccd842ac4117440a39b076a42c1379ba4fd67c1743693f8fe2b402360",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
