      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ご主人さまに対してある意味で好戦的でしたが……、\nまぁ、それはいつも通りですね。",
      "jp_sha256": "51986fe3785562d49cef0515c9651abc26befed87e118373e4f265297cdedfe3",
      "kind": "dialogue",
      "ko": "주인님에게 어떤 의미로는 호전적이었지만……,\n뭐, 그건 평소대로군요.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
