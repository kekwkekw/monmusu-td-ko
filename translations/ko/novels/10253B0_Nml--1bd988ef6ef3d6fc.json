      "kind": "dialogue",
      "ko": "이제 다 같이 밀렵꾼들을 보내 주려고요.\n이 세상의 천상낙원으로 말이죠…….",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 40,
