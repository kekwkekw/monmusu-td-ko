      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "まさかー。他のモンスター娘さんたちもいましたよ。\nま、みんなとっくに帰っちゃいましたけどね。\n私はちょっと、やりたいことがあって残ってるんです。",
      "jp_sha256": "64a5c64b95c985f4d63d96918b46fcd1a5ecbbb256bc0f03fe245349bc5c5ff2",
      "kind": "dialogue",
      "ko": "설마요―. 다른 몬스터 소녀들도 있었어요.\n뭐, 다들 진작 돌아갔지만요.\n저는 조금 하고 싶은 일이 있어서 남아 있답니다.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 18,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
