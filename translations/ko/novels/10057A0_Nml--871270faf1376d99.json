      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "わわっ、サウラさんじゃないですか！\n大丈夫ですか！？　今助けますからね！",
      "jp_sha256": "8cc8a307cf2de5bd2882236ec315c5f02b817db4e945094c3c5d26cd85d17875",
      "kind": "dialogue",
      "ko": "우왓, 사우라 씨잖아요!\n괜찮으세요!? 지금 도와드릴게요!",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 20,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
