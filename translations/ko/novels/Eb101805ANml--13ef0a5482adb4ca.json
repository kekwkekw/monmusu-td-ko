    {
      "command": "",
      "draft_row_sha256": "279d51924c5fdea3684826f09b20f325ae11de6004f555a39ebce2920001af1f",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ワタシの死霊たちをそんな可愛く言うな！",
      "jp_sha256": "e2f8e1e452a757eccda421e182a0e4ada115ac22f3b43197d23038a5f3b18a5c",
      "kind": "dialogue",
      "ko": "내 사령들을 그렇게 귀엽게 부르지 마!",
      "message_index_0based": 10,
