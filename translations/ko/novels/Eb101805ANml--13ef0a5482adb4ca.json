      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "もうココは、クリスマスデコレーションで浄化されてるの！\nその欠片の淫力も、ここでは力が弱まるの！",
      "jp_sha256": "f1c835b6e01fd2b34890384a743f1829d42b8a566ee669e98b0654e970acdeb5",
      "kind": "dialogue",
      "ko": "이곳은 이미 크리스마스 장식으로 정화됐어!\n그 조각의 음력도 여기서는 힘이 약해지는 거야!",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 44,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
