    {
      "command": "",
      "draft_row_sha256": "3a9ecbd7dfbdd9416d7b96ac26d47b273445e3523fd6ceac621659393f33b458",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ええい！　ワタシのセリフを盗るな！　\n後から合流してきたクセに、\nよりによって一番オイシイところを奪いやがって！",
      "jp_sha256": "41afb8cb8550bd3f0a1da92314deda2ffe878d03682f7ec75ebcb09fcc4ab344",
      "kind": "dialogue",
      "ko": "에잇! 내 대사를 빼앗지 마라! \n나중에 합류한 주제에,\n하필 가장 맛있는 부분을 가로채다니!",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 45,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
