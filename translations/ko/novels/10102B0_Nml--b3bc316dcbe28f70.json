      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ええ、天気が良かったので。\nウォルーザさんは、こんなところまで見回りをしているんですね。",
      "jp_sha256": "773bcb245d3c44b0f2b69aa6cf1f1e843f5dd526ca9af4e48f60544e0e9204bd",
      "kind": "dialogue",
      "ko": "네, 날씨가 좋아서요.\n워루자 씨는 이런 곳까지 순찰하고 계시는군요.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
