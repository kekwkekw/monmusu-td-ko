      ],
      "speaker": "",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "5bc12a0b82aa43ab0aa6097795d2573b57b8b5e588bb93e9260b77cdb6cbf0f9",
