      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "我ながら不用心だと思いつつも、\n好奇心に負けて細工のひとつに触れた瞬間――。",
      "jp_sha256": "a05e28f933befe56d0f9494f471ae3c19feb79af3af0d179b73fd1198fd97a8a",
      "kind": "dialogue",
      "ko": "나도 참 부주의하다고 생각하면서도,\n호기심을 이기지 못하고 공예품 하나를 만진 순간――.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
