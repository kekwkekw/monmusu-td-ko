      "review_status": "reviewed",
      "row_id": "c6eed2f15bd6984f790b22572ded93a44a66d7866d4915be54978bf36b842a56:000002_3110841615604273404:g0:r7",
      "row_index_0based": 7,
      "serialized_row_index": 7,
      "source_cells": [
        "",
        "",
