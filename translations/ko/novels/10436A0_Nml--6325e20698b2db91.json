      "row_index_0based": 17,
      "serialized_row_index": 17,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "ええ！？　\n僕の授業とは大違いだ……。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "22abc2d4ba5c7d5914ed121e583ebf73c0ec6e3d7e9133fb4e7e4aa69d6373c8",
