      "grid_message_index_0based": 2,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "おはよう。\n今日の――授業を――始める。起立。",
      "jp_sha256": "9557b90e399c691b8ce5ed2a80ad9f525552ac4a0c064aed8f4baef6ca5f31dd",
      "kind": "dialogue",
      "ko": "좋은 아침.\n오늘의―― 수업을―― 시작한다. 기립.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
