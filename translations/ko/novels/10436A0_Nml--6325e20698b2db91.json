      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ええ！？　\n僕の授業とは大違いだ……。",
      "jp_sha256": "4e44016853e921e279c0d1a5a88112c4eda531dc0bdd68dd9f1aa25aea5aa2d3",
      "kind": "dialogue",
      "ko": "에에!?　\n제 수업과는 완전히 달라…….",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 18,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
      "review_note": "",
      "review_status": "reviewed",
