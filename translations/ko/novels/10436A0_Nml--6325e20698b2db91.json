      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "私は――学生にも――教師にもなれる――。\nひとりふたやく――つまり――ベテラン教師――だ。",
      "jp_sha256": "6bec3a377f3b07e892f01eba3f39f8c543a361590fa59c8745a15ecbee4d2bca",
      "kind": "dialogue",
      "ko": "나는―― 학생도―― 교사도 될 수 있다――.\n일인 이역―― 즉―― 베테랑 교사――다.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 32,
