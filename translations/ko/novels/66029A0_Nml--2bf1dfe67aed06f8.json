    {
      "command": "",
      "draft_row_sha256": "baabefda78bcd398e6a07a5d8338f38c1ec050438aca1949e7aed6c0afbe65cf",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あああ！　ちょうどいいところに！\n僕、気づいたらなぜか木に縛られていたんです！\n早くこれを、切るかほどくかしてください！",
      "jp_sha256": "22a13413f2dae6adf21a07f341f5b1e5e4ee40dc4c9a8a72b77b4e1ca9470e7a",
      "kind": "dialogue",
      "ko": "아아아! 마침 잘 오셨어요!\n제가 눈을 뜨니까 웬일인지 나무에 묶여 있었어요!\n어서 이걸 자르든 풀든 해 주세요!",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 19,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b011-20261107-ff47d2c5b69e",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "5cfed47a39bd01f6a74ebe52290acd57e108295cf4fa00fc80c1298a05c111f9:000001_-709008094871157430:g0:r18",
      "row_index_0based": 18,
      "serialized_row_index": 18,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "あああ！　ちょうどいいところに！\n僕、気づいたらなぜか木に縛られていたんです！\n早くこれを、切るかほどくかしてください！"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
