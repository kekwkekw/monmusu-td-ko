    {
      "command": "",
      "draft_row_sha256": "1ba8081ca909ba05914205a54209f41360e708e4b8f7289f6d4db66c683da65a",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "おねショタ日和は、晴れ、曇り、雨、\n雷、雪、その他諸々の天気を指すと聞いたの。\n今日は晴れているから、該当すると思ったのだけど。",
      "jp_sha256": "0b9be100c9d7788377eb338eb08c6527860b36adbd84297349ee51490683cf4a",
      "kind": "dialogue",
      "ko": "누나 쇼타 날씨는 맑음, 흐림, 비,\n천둥, 눈, 그 밖의 온갖 날씨를 가리킨다고 들었어.\n오늘은 맑으니 해당한다고 생각했는데.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 19,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
