    {
      "command": "",
      "draft_row_sha256": "c1ffd78651505431678a981f712557cc3f64b0f2cb9b965495ee5529a8ad9e48",
      "grid_index": 0,
      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "突然やってきたシモアマヅさん。\nまさか彼女の口からおねショタ警察なんて言葉が出るなんて、\n予想できるわけなく、びっくりしてしまった。",
      "jp_sha256": "ee6f27b403ff93ebc73389ee0048446b8795d5cd7baa2fbd64763a87ae528503",
      "kind": "dialogue",
      "ko": "갑자기 찾아온 시모아마즈 씨.\n설마 그녀의 입에서 누나 쇼타 경찰이라는 말이 나올 줄은,\n예상할 수 있을 리 없어 깜짝 놀랐다.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
