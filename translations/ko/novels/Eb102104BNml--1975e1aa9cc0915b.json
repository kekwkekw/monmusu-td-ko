    {
      "command": "",
      "draft_row_sha256": "57d02fe83d32e97ccb2977ed10a7851a81b3f0a53247373513fcfa9a98b0d65b",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "今回は負けてしまったが、次こそは……次こそは、\n綿密な裏切り計画を立ててみせるぞ、ご主人様……。\nそして、私に腐るほどのお仕置きを……腐腐腐腐……。",
      "jp_sha256": "b4f24cfe70b31ad65c7a3e111b2d9ff7627904f246b035f9a8e25bfa02b14489",
      "kind": "dialogue",
      "ko": "이번에는 져 버렸지만, 다음에는…… 다음에는 반드시,\n치밀한 배신 계획을 세워 보이겠습니다, 주인님…….\n그리고 제게 썩어 넘칠 만큼 벌을…… 부후후후후…….",
      "message_index_0based": 10,
