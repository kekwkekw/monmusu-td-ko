      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それで……ご主人さま。\nカー・ルーの勢力圏から何とか脱しましたが、\nこれからどうするのですか？",
      "jp_sha256": "408d9397573d8932e00058206edcb87dbfd65f30c77e7dc5120891395acb95c7",
      "kind": "dialogue",
      "ko": "그래서…… 주인님.\n카·루 세력권에서는 어떻게든 벗어났습니다만,\n이제 어쩌실 건가요?",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b011-20261107-ff47d2c5b69e",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "e4b8391ebcecd341a4da637dd7d44c9ea075ec5fe11d2e62d587254ed92bd443:000002_3937946050235739821:g0:r12",
      "row_index_0based": 12,
      "serialized_row_index": 12,
      "source_cells": [
