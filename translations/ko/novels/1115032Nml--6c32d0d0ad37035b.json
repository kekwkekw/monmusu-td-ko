      ],
      "speaker": "",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "9c17c8d6a7415fcfd525bef298de2e0767d27405288d8809193ba1ed070a4c9d",
