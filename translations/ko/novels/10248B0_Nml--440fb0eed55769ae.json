    {
      "command": "",
      "draft_row_sha256": "5f9ad5c388ca6816c81a65d7a83a3b5829b031cb5497fab8f45b16ec7e59aa37",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
