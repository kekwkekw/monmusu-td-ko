    {
      "command": "",
      "draft_row_sha256": "02d277a5c3a647bbd3b3b25d1b86cd9f9384667ecbf070aaf2618dbc836c506b",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "でも私が多く釣ったりしたら弟は絶対に拗ねるから、\n気づかれないように、釣った魚を弟のバケツに入れたあげたり、\nたま～に釣り糸が切れたふりして逃がしてみたりね。",
