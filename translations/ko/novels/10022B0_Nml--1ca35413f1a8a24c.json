    {
      "command": "",
      "draft_row_sha256": "d0ef63caa9eed58f58ab23a6af1ea56016d649fd6a88a75b22255604008cc31b",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "懐かしいなぁ～。ここと似たような湖畔で、\n夏休みには家族でキャンプしたり、弟と一緒に釣りをして、\nどっちが魚をたくさん釣れるか競争したりしてさ。",
      "jp_sha256": "a39c3adaf5714acb6e27eca470a6e783983fbf6deace9fe76bdcb3706a796a69",
      "kind": "dialogue",
      "ko": "그립다~. 여기와 비슷한 호숫가에서\n여름방학이면 가족끼리 캠핑도 하고, 동생과 함께 낚시해서\n누가 물고기를 더 많이 잡나 내기도 했지.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 55,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
