      "row_index_0based": 9,
      "serialized_row_index": 9,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "ええと……なんです？\nその石版で出来たおっきな本……。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
