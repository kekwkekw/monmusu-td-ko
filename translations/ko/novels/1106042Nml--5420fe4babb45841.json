    {
      "command": "",
      "draft_row_sha256": "ef4a85699fb022dbfe4933849b7f1a0f47eebd99c9e52d8cb3e59af6d437b5ab",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "メチャクチャ光り出し、\nその場の全員が『うぉっ！　眩しっ！』となった。\nそして、待つことしばし、ようやく、光がやや弱まっていく。",
      "jp_sha256": "7733e67a9f77179205570417eb9ae127e106955d56d393b35dfd90fc1f3301f2",
      "kind": "dialogue",
      "ko": "엄청나게 빛나기 시작했고\n그 자리에 있던 모두가 '우왓! 눈부셔!'라고 했다.\n그리고 잠시 기다리자 마침내 빛이 조금 약해졌다.",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 33,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b010-20261107-same-model-pass2-r1",
