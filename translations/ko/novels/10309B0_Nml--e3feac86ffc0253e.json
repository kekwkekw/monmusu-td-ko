      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "うう、仕方ないとはいえ、\n夜の森はさすがに怖っ――。",
      "jp_sha256": "81b8ef39070483334f2cdc129838ba10f1491465aa9824d10288481bdb46a0f8",
      "kind": "dialogue",
      "ko": "으으, 어쩔 수 없다지만,\n밤의 숲은 역시 무서――.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 9,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
