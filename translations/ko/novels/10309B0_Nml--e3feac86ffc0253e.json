      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それはこっちのセリフですよっ！\nもしかしてまた呪いの儀式ですか！？",
      "jp_sha256": "3de0fd0de0b38f84cc3cd7502743ce863c2172a0bc7e35c216104f68087ffb89",
      "kind": "dialogue",
      "ko": "그건 제가 할 말이에요!\n설마 또 저주의 의식인가요!?",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 23,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
