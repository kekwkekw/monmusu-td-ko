      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "おーそうだ！　これはレアモンスター『ワ・ギュー』の肉なんだ！\nもうアタイはたらふく食べたし、\nご主人にお裾分けしようと思ってな！",
      "jp_sha256": "53164b2d66a35bb68d237e51828712430352745dcc79261d78acedc810415193",
      "kind": "dialogue",
      "ko": "아, 맞다!　이건 희귀 몬스터 ‘와·규’의 고기야!\n나는 이미 배불리 먹었으니\n주인에게 나눠 주려고!",
      "message_index_0based": 11,
      "page_ctrl": "",
      "physical_line_1based": 56,
