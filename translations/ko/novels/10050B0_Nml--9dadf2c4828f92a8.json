      "kind": "dialogue",
      "ko": "아뇨, 아무것도 아니에요.\n그보다 그 쇠고기는 어떻게 된 건가요?",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 27,
