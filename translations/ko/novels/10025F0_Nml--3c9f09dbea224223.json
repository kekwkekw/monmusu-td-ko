    {
      "command": "",
      "draft_row_sha256": "bdf864d9c35c9edf129a0427348b615f95dfc4c7d13bb71e717e1405e6c43c62",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そのまま唇が近づいていき――。",
      "jp_sha256": "692c586d77a790dc6170b082038d95cf9e93a1cf003a89e679a44c29802a6f77",
      "kind": "dialogue",
