      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "僕、見てましたからね。\nタンタルさん、戦闘中にナンパしていたでしょう？\nダメですよ。みんな頑張っている時にああいうことしては。",
      "jp_sha256": "af418c67c624d7b3732cc363c73a5e1cabdaa247e663b139f20c5158b4e3724e",
      "kind": "dialogue",
      "ko": "저, 봤거든요.\n탄탈 씨, 전투 중에 헌팅하고 있었죠?\n그러면 안 돼요. 모두 열심히 싸울 때 그런 짓을 하면.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 15,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "812258758af2d71c064217d877cde0b80f66b9629b65a30025b2b1ad1c071ed1:000000_-3596459087261541630:g0:r14",
      "row_index_0based": 14,
      "serialized_row_index": 14,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "僕、見てましたからね。\nタンタルさん、戦闘中にナンパしていたでしょう？\nダメですよ。みんな頑張っている時にああいうことしては。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
