      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "こんなところって……貴方が壊した棺、私の家だったんだけど？\n真っ二つにしてくれて……どうしてくれるのかしら？",
      "jp_sha256": "9f6a52531cb0b155363407bbb01e9adf492099c6fbbbec2cb9630bfd6c9bfba2",
      "kind": "dialogue",
      "ko": "이런 곳이라니…… 네가 부순 관은 내 집이었거든?\n두 동강을 내 놓고…… 어떻게 책임질 셈이니?",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 43,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
