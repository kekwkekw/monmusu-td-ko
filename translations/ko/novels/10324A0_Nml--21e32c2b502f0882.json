      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それなら何よりです。\n今取り組んでいるのは、新しい実験ですか？",
      "jp_sha256": "d9f808f6ed8048ae0cb818f54d5bb3dc48f9e1b2ec0c76905551f65ebc3d6c44",
      "kind": "dialogue",
      "ko": "그렇다면 다행이에요.\n지금 하시는 건 새로운 실험인가요?",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
