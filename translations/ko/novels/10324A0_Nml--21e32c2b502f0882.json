    {
      "command": "",
      "draft_row_sha256": "839c2902620b1e93d47994b0508246cf5bafeb054b9d0a50720ca6f09d3ac448",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "チョコレートの研究？　手作りチョコレートのではなく？",
      "jp_sha256": "79cd62909cb125201076fcdf90c8fc710b5817a6687f1250da48e4fa28b42dc0",
      "kind": "dialogue",
      "ko": "초콜릿 연구요? 수제 초콜릿 연구가 아니라요?",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 16,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b007-20261106-398afd64-pass2-r1",
