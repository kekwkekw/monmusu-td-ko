      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ああ、これは失礼。心配をかけたかな。\nこの通り、ピンピンしているよ。\nやる気が有り余っているくらいだ。",
      "jp_sha256": "71d6cf70233711777370ca9608c40c8e82778b0a74bdaf1826244b98c4d48753",
      "kind": "dialogue",
      "ko": "아아, 실례했군. 걱정을 끼쳤나.\n보다시피 아주 멀쩡해.\n의욕이 넘칠 정도지.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 11,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
