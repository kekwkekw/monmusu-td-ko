      "review_status": "reviewed",
      "row_id": "3a55fc1bf8b82677fb57f51bee24a58ea6c17adda3743306d9f0d827b7810089:000000_-2858949829448152061:g0:r15",
      "row_index_0based": 15,
      "serialized_row_index": 15,
      "source_cells": [
