    {
      "command": "",
      "draft_row_sha256": "21ae57d7a392c49a050a00ffdba49c16a8832e321e1960f31018c15d8de138a7",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "要するに、レティアさんとの訓練を\n寝坊してすっぽかしてしまったということか。",
