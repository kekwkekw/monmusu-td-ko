      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "アイレンさん、助けてくれてありがとうございます。\nただ、助けてもらっておいてなんですけど、\nあんまりモンスター娘の皆さんを責めないでくださいね……。",
      "jp_sha256": "1ff7232da497a575c719c6f348d30e3ff9d27cd799cd9260db53e144c20156f1",
      "kind": "dialogue",
      "ko": "아이렌 씨, 도와줘서 고마워요.\n도움을 받은 입장에서 할 말은 아니지만,\n몬스터 소녀들을 너무 나무라지는 마세요…….",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 24,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "3f861b5f8a51b9aa436ba6bb79c86344cf7fb72516328c84cb4a9f7fdf2feb1e:000002_5549322770837016520:g0:r23",
      "row_index_0based": 23,
      "serialized_row_index": 23,
      "source_cells": [
