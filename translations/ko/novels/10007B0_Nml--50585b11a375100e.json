      "row_index_0based": 29,
      "serialized_row_index": 29,
      "source_cells": [
        "",
        "",
        "侵入者",
        "",
        "",
        "",
        "",
        "",
        "",
        "あ、アタシらの装備じゃ勝てるわけがない！\nここは退散だ！　さっさと逃げるわよ！"
      ],
      "speaker": "侵入者",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "62492c3393f19cc01bc0e124245d49a54d3d8c60ae5b9bcd5db7d5a2fb17ed29",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "オキシーさんの剣幕に、侵入者たちは武器を抜くことすらなく、\n慌てて船に乗って逃げていくのであった。",
      "jp_sha256": "b526aed1c48109eceb8e33db559f2e4159f05a97afb2e41eacc090175ba12876",
      "kind": "dialogue",
      "ko": "옥시 씨의 기세에 침입자들은 무기를 뽑지도 못한 채,\n허둥지둥 배를 타고 달아났다.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 33,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
