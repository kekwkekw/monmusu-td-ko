    {
      "command": "",
      "draft_row_sha256": "0eb1e3edcd5b66e5e13dd51452a97b6d55d93d81af03c7790ff19084207988dd",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "恥ずかしそうに言葉遣いを変えるオキシーさん。\n初めて出会った時からこんな感じなので、\n僕は彼女の様子にはもう慣れていた。",
      "jp_sha256": "bb2b04432a4f153db40f4b836d01fa08e11bbcda24f25c93ba91e18e945ab259",
      "kind": "dialogue",
      "ko": "부끄러운 듯 말투를 바꾸는 옥시 씨.\n처음 만났을 때부터 늘 이런 식이라,\n나도 이제 그녀의 모습에 익숙해져 있었다.",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 68,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
