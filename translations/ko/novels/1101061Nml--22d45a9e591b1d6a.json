      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "――どうやら、誰かを探しているみたいですね。\nまたモンスター娘さんたちを密猟しにやってきたんでしょうか。\nちょっと捕まえて情報を聞き出してみませんか。",
      "jp_sha256": "e20a87cd81d4b72c786b7697a42dd9277392fdf30db53cf623ba4c6d1f0a3310",
      "kind": "dialogue",
      "ko": "――아무래도 누군가를 찾는 모양이네요.\n또 몬스터 소녀들을 밀렵하러 온 걸까요.\n한 명 붙잡아서 정보를 캐내 보지 않을래요?",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 26,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b010-20261107-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "0578c5b2dc9423c31c5b155155269c6218ac5692b5b7f71b810ec6f024bab3a8:000000_-7687027692147780663:g0:r25",
