      "serialized_row_index": 25,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "――どうやら、誰かを探しているみたいですね。\nまたモンスター娘さんたちを密猟しにやってきたんでしょうか。\nちょっと捕まえて情報を聞き出してみませんか。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "12f814a20d0321adaf02e415b5d601cb2d9a44a5c15a7146f1604c2fe4cb3b1c",
