      "kind": "dialogue",
      "ko": "기사단의 포위에서 벗어나기 위해\n주인공 일행은 숲 깊숙이 발을 들이고 있었다.",
      "message_index_0based": 0,
      "page_ctrl": "",
      "physical_line_1based": 8,
