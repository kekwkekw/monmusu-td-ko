    {
      "command": "",
      "draft_row_sha256": "8442f1bd5dc385b6b067c887ef2c763b7a62d0b3917a7fb0c322555605b1afa5",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "器を受け取り、ひとくち。口の中に濃厚な味わいが広がった。\nすごく美味しいとシルバさんに伝える。\nその時アスタさんがニヤニヤしているのに気づいた。",
      "jp_sha256": "568cbf14f999f9326f0a3de00bb99ff0b928e114aafbe3de514481079aa77f83",
      "kind": "dialogue",
      "ko": "그릇을 받아 한입. 입안에 진한 맛이 퍼졌다.\n정말 맛있다고 실바 씨에게 전했다.\n그때 아스타 씨가 실실 웃고 있다는 걸 알아차렸다.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 59,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
