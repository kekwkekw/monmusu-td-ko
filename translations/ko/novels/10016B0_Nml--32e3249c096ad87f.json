      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "食べ過ぎ―――だ。\nご主人も一緒に―――どうだ？\n私の特製シチュー―――だ。",
      "jp_sha256": "283dbd692ccf0c01b88a72436d70f99b3d97d5046321afdbea2fec8286af2aa6",
      "kind": "dialogue",
      "ko": "너무 많이――― 먹는다.\n주인도 함께――― 어떠냐?\n내 특제 스튜――― 다.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 53,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
