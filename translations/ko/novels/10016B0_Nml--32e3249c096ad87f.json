      "review_status": "reviewed",
      "row_id": "9eee64f21cbbbbfa861e325dae90c5c5102120d912e47cacbe2b4c6ffa09515a:000002_8731773621540528314:g0:r48",
      "row_index_0based": 48,
      "serialized_row_index": 48,
