      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "お前は本当に―――これが好き―――だな。\nあまり食べ過ぎると―――体に良くない―――ぞ？",
      "jp_sha256": "253ea7a48f6b2acae53aa1ed7c1ad137f453797d5ca1f6856d0921d38863e01c",
      "kind": "dialogue",
      "ko": "너는 정말――― 이걸 좋아하는――― 군.\n너무 많이 먹으면――― 몸에 좋지 않다――― 알겠나?",
      "message_index_0based": 0,
      "page_ctrl": "",
      "physical_line_1based": 20,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
      "review_note": "Stage B 원문 대조에서 의미·문체·표기 교정.",
      "review_status": "reviewed",
      "row_id": "9eee64f21cbbbbfa861e325dae90c5c5102120d912e47cacbe2b4c6ffa09515a:000002_8731773621540528314:g0:r19",
