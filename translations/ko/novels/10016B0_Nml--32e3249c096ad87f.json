      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "いいのいいの！　こんなに美味しいものが体に悪いわけないわ！\nおかわりちょうだい！",
      "jp_sha256": "8b36dd06e4a43a19485ce9e6a21429d7b09d7f42413734092d6100edec473ac6",
      "kind": "dialogue",
      "ko": "괜찮아 괜찮아! 이렇게 맛있는 게 몸에 나쁠 리 없잖아!\n한 그릇 더 줘!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 49,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
