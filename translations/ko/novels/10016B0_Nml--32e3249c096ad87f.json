      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "こんにちは。\nお昼ご飯ですか？",
      "jp_sha256": "d39173e51a25e69a8d9a7fe0e1a280cbeea31e1d609b090b129ba1e2cb7015c2",
      "kind": "dialogue",
      "ko": "안녕하세요.\n점심 식사 중이세요?",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 51,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "9eee64f21cbbbbfa861e325dae90c5c5102120d912e47cacbe2b4c6ffa09515a:000002_8731773621540528314:g0:r50",
      "row_index_0based": 50,
      "serialized_row_index": 50,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "こんにちは。\nお昼ご飯ですか？"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "2eee722de6d638635643b234f14e76a38736db2dd76abd123b83d3277931894a",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あ、おはようご主人。\n私はさっき起きたから、これは朝ご飯よ。\nお昼ご飯はその後にまた食べるわ！",
      "jp_sha256": "846c16526e25878029cd1e447b3909d1850e44321f8e7d798967f015dcf9b18a",
      "kind": "dialogue",
      "ko": "아, 좋은 아침이야 주인.\n나는 방금 일어났으니 이건 아침밥이야.\n점심은 그 뒤에 또 먹을 거고!",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 52,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "9eee64f21cbbbbfa861e325dae90c5c5102120d912e47cacbe2b4c6ffa09515a:000002_8731773621540528314:g0:r51",
