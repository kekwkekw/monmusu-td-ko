      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "0d32a7d9a621b11348230d292ab66867196af5813844d4f5b013093104935e4f",
      "grid_index": 0,
      "grid_message_index_0based": 2,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "元々は『ミルキィ星』にしか生息しない、\nホルスティンティンから搾れるんだけどな！\nこの星のホルスティンティンから取れるミルクには驚いたぞ！",
      "jp_sha256": "01a8c27cd388ac70e161eb0c2ac96060f91dfb1365e87ebea47571e198186323",
      "kind": "dialogue",
      "ko": "원래는 『밀키 행성』에만 사는\n홀스틴틴에게서 짤 수 있는데 말이야!\n이 별의 홀스틴틴에게서 나오는 우유엔 놀랐어!",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 6,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
      "review_status": "reviewed",
