      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "？\n心を操る能力もあったんじゃなかったかしら？",
      "jp_sha256": "5d444542576988c6053c3e1bb57225ecece9a07363a903959a8ad989eb13e286",
      "kind": "dialogue",
      "ko": "?\n마음을 조종하는 능력도 있지 않았니?",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
