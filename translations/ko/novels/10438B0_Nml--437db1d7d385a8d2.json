      "grid_message_index_0based": 2,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ラララ～♪　ルルル～♪　レレレのレ～♪\n……違うわね。もっとこう、ダイナミックに――。\nドガーン！　ズガガーン！　みたいな？",
      "jp_sha256": "afbf202c77ed574f689ca42a4b4a0db9fdc3607a2c40dd17ff1e590564a96514",
      "kind": "dialogue",
      "ko": "라라라～♪ 루루루～♪ 레레레의 레～♪\n……아니야. 좀 더 이렇게, 다이내믹하게――.\n콰쾅―! 두두쾅―! 같은 느낌?",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
