      "kind": "dialogue",
      "ko": "샘에서 이상한 냄새가 난다는 말을 듣고,\n나는 혼자 조사하러 향했다.",
      "message_index_0based": 0,
      "page_ctrl": "",
      "physical_line_1based": 8,
