      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "f036a37ec8291b0172be79d6d80c2e1d1a1be97642b8d6550785c5aa2a53c6a5",
      "grid_index": 0,
      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "早く早く、とぐいぐい背中を押される。\nあまりに押され過ぎて、勢い余って転びそうだった。",
      "jp_sha256": "b38a0f13f0b49038bc5b88d9c07731cc2793c62399f010d7805a3dd722ae71b4",
      "kind": "dialogue",
      "ko": "빨리, 빨리 하며 등을 세게 밀린다.\n너무 많이 밀려 기세를 못 이기고 넘어질 것 같았다.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b004-20261105-same-model-pass2-r1",
