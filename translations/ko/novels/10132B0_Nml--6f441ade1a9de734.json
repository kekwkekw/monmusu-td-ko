    {
      "command": "",
      "draft_row_sha256": "d9cc59383cb663e28cb6d158e1c196e5a597ea83dd0b75b385a00f12d2847930",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "うっ、ウソなんかつくわけないだろ！　馬鹿やろう！\nほらっ、ご主人っ！　分かれ道だぞ！　右と左、どっちに行く！？",
      "jp_sha256": "cfa5ea7413ae66dcd0d1db3edcb9193b0d427e60798a3780b358c3b141dfe452",
      "kind": "dialogue",
      "ko": "거, 거짓말 같은 걸 할 리 없잖아! 바보야!\n자, 주인! 갈림길이다! 오른쪽과 왼쪽, 어디로 갈래!?",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 21,
