    {
      "command": "",
      "draft_row_sha256": "03f88f583f8754caa04cb236fed6f5791679b3ec876bd6681b91dd0f5db377a5",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "いっ、いいからいいから！\n可愛いご主人の顔見りゃ、きっと元に戻るはずだ！　たぶん！",
      "jp_sha256": "6681b6b4f3ac764e3e2ffa95280c2cb783a6fc61f09abc13df919573acd6e461",
      "kind": "dialogue",
      "ko": "그, 그냥 됐으니까!\n귀여운 주인 얼굴을 보면 분명 원래대로 돌아올 거야! 아마!",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 16,
