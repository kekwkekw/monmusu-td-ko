    {
      "command": "",
      "draft_row_sha256": "becd6993d07c7ea179255f8065745ef18dff26cc36a61b0737c25a0957a74d5c",
      "grid_index": 0,
      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "急げ、ご主人っ！　さあ早く！　ダンジョンの奥までダッシュだ！\nアタシの仲間を早くっ！　早く助けねぇと！",
      "jp_sha256": "a8a0ad91f28dd8e24690d8b080913a33f0d5d4e239dbbe467500bd0cc193e563",
      "kind": "dialogue",
      "ko": "서둘러, 주인! 자, 빨리! 던전 안쪽까지 달려!\n내 동료를 빨리! 빨리 구해야 해!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 11,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b004-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "5884f727117c363a6acb842be55743bdd5239c86033421a9053c38c26f3e49fb:000000_-3162782448438629691:g0:r10",
