      "kind": "dialogue",
      "ko": "평소에는 대체로 왜곡되어 전해지는 이 섬의 소문이\n이번만큼은 정확히 전해졌다는 것은\n훗날 생각하면 아이러니라고밖에 할 수 없다.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 41,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b011-20261107-ff47d2c5b69e",
