    {
      "command": "",
      "draft_row_sha256": "0ab54d5c7102d6b344b82dfa8aec31ec81cec21f2998ce013b0baae1db350c91",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ちちちっ♪\nそれだけ喜んでもらえると、見せた甲斐があるものだね！",
      "jp_sha256": "83bf14dc2f5e74384af1d6a89ef46ce87389f442885bc716fa4b09729bae7a70",
      "kind": "dialogue",
      "ko": "찍찍찍♪\n그렇게 기뻐해 주니 보여 준 보람이 있네!",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 35,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
