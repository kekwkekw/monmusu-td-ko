      "grid_message_index_0based": 2,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ありがとうございます。\nでも、クリフォさんの強さがあっての作戦でしたから。\n今日の勝利はクリフォさんのおかげです。",
      "jp_sha256": "662a19f0c6427aed60027a4cd1cb27c6e86e7769b70036b9b6bbba9394678d14",
      "kind": "dialogue",
      "ko": "감사합니다.\n하지만 클리포 씨의 힘이 있어야 가능한 작전이었어요.\n오늘 승리는 클리포 씨 덕분이에요.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 16,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "61bf05620d5afa976453b8766090458a2cba0663b7f741a75948fdaf497fe256:000000_-3232882064063142642:g0:r15",
      "row_index_0based": 15,
      "serialized_row_index": 15,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "ありがとうございます。\nでも、クリフォさんの強さがあっての作戦でしたから。\n今日の勝利はクリフォさんのおかげです。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
