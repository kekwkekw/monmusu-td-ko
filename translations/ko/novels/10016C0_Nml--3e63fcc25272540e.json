      "row_index_0based": 7,
      "serialized_row_index": 7,
      "source_cells": [
        "",
        "",
        "男剣士Ａ",
        "<Off>",
        "",
        "",
        "",
        "",
        "",
        "ゲシュペンス島……。\n忌まわしきモンスター娘どもの楽園……今度こそ、俺は……。"
      ],
      "speaker": "男剣士Ａ",
      "translation_status": "translated",
      "voice": ""
    },
    {
