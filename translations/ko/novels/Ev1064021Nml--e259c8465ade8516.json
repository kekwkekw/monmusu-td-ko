      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "私と話をしてくれるなら、この「びっくりエッグ」をやろう。\n中に何が入ってるか分からない特別な卵だぞ。",
      "jp_sha256": "c0abd170b056d09cba4d0b0463ca360bdd529da75b026193e399b8eea2d79794",
      "kind": "dialogue",
      "ko": "나와 이야기를 해 준다면 이 「깜짝 에그」를 주지.\n안에 뭐가 들었는지 모르는 특별한 알이야.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 40,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
