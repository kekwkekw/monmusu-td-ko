      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "c0a6a1e554f285d788461119373ae32b6975f162f186554b089170ea1e001be3",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "しばらく海を漂流し、もはや運命の女神にも\n見放されたと絶望しかけたが、俺は運良く海賊に救われた……。\nだが、貴様らへの恨みは……あの屈辱は忘れもしない。",
      "jp_sha256": "5538c887207d328cbdd4a58b54a44d844cccd161a30f2a2e52e49d2ae701376a",
      "kind": "dialogue",
      "ko": "한동안 바다를 표류해 운명의 여신에게마저\n버림받았다고 절망할 뻔했지만 운 좋게 해적에게 구조됐다…….\n하지만 너희를 향한 원한은…… 그 굴욕은 잊지 않았다.",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 29,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
      "review_status": "reviewed",
