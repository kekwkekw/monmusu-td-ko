      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "気づけば、目の前が真っ暗になり、\nそのまま倒れこんでしまった――。",
      "jp_sha256": "2735252dcc41cf46d4cdbb646dbaea747b1ffb35b45d7198038306ee9e25c32b",
      "kind": "dialogue",
      "ko": "어느새 눈앞이 새까매졌고,\n그대로 쓰러지고 말았다――.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 23,
