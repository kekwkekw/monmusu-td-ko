      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "僕のことを看病してくれていたのは、\nこの学校で保健を担当している先輩のローレンさんだった。",
      "jp_sha256": "ea69e947085d83db8e7f66a9bea4a3af7eb3a41bc984c4b614339e16d710258d",
      "kind": "dialogue",
      "ko": "나를 간호해 준 사람은\n이 학교에서 보건을 담당하는 선배 로렌 씨였다.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 33,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b005-20261106-resume-same-model-pass2-r1",
