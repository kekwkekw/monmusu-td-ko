      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ローレンさんが運んでくれたんですか？\nすいません、ありがとうございました。",
      "jp_sha256": "605c64acdf92a59219302b35b6b965311ce1abe693f251271aac630863170915",
      "kind": "dialogue",
      "ko": "로렌 씨가 옮겨 주신 건가요?\n죄송해요, 고맙습니다.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 34,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b005-20261106-resume-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
