    {
      "command": "",
      "draft_row_sha256": "72c0d6af4a6161c87156f3d846f650200aba8d6a1cffd801da3c978cc10bc4ce",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あらん、ようやく目が覚めたのね？\nまったく、あなたったら疲れと寝不足で倒れたのよん？\n忙しいと言っても、体調管理も大切だからねぇ？",
      "jp_sha256": "434ac2618ae53b01c72eac6ce09e02bd768e35b253869c4a11919a42fd855950",
      "kind": "dialogue",
      "ko": "어머나, 드디어 눈을 떴네?\n정말이지, 너 피로와 수면 부족으로 쓰러졌다고?\n바쁘다고 해도 건강 관리도 중요하니까아?",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 32,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b005-20261106-resume-same-model-pass2-r1",
