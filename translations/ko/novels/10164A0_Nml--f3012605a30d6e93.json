    {
      "command": "",
      "draft_row_sha256": "18c20534fc79950a0923f06269ac09e38df5d6a56e0e4d23dd76edc18a155614",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "んもう、先生なんだから、学生ちゃんと同じなのはダーメ。\nそれなら、あなたにもちゃんと健康の大切さを教えて、\n今後はこんな事がないようにしてもらうからねぇん？",
      "jp_sha256": "e47bdaf3483ad49f432062beab715994628cb5edfe431bed22d69acf16dc63b0",
      "kind": "dialogue",
      "ko": "정말, 선생님인데 학생과 똑같으면 안 돼.\n그럼 너한테도 건강의 중요성을 제대로 가르쳐서,\n앞으로는 이런 일이 없게 해야겠네에?",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 37,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b005-20261106-resume-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
