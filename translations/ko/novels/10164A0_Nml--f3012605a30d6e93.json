      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "faf20bd2c565da26696ac8f2e54cf6dd2021c65761b839f92355e39228c9d96f",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "学園の子にもありがちだけどぉ、ついつい頑張りすぎて、\n自分の体調を疎かにしすぎねぇ。\nちゃんとご飯を食べて、暖かくして寝ないとダメよぉ？",
      "jp_sha256": "fd018260732039bb16de2c85359380d3e8501c11a217bc4ba4c84d1fc4bdea66",
      "kind": "dialogue",
      "ko": "학원 아이들에게도 흔한 일이지만, 자꾸 너무 열심히 해서\n자기 건강을 지나치게 소홀히 하네에.\n밥도 제대로 먹고 따뜻하게 하고 자야 한다고?",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 35,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b005-20261106-resume-same-model-pass2-r1",
