      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "――うぅ、あ、あれ？　ここは……。\n知らない天井だ。えっ、どこですか！？　ここ！？",
      "jp_sha256": "9b5ce9d1a38579e8bb581cfce60118ae30bf283aac6fcc2d56990a27835ba6a9",
      "kind": "dialogue",
      "ko": "――우우, 어, 어라? 여기는…….\n낯선 천장이다. 네, 어디예요!? 여기!?",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 28,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
