    {
      "command": "",
      "draft_row_sha256": "96a6c703b176d3f9ef742291c54757ba9eb94cdd0f058dee1407ed3ea8c9bdfe",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "す、すいません。ご迷惑をおかけしました。\nでも、忙しいとついつい後回しになっちゃって……。",
      "jp_sha256": "07860c4369db92967dcc700c33566ec2c6016112b08f49a324aa0def04b20b7f",
      "kind": "dialogue",
      "ko": "죄, 죄송해요. 폐를 끼쳤네요.\n하지만 바쁘면 자꾸 뒤로 미루게 돼서…….",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 36,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b005-20261106-resume-same-model-pass2-r1",
