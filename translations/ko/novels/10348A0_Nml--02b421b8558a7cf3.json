      "jp": "もうルルゥの魅了は暴走しないの！",
      "jp_sha256": "3f64e4ac3394a06fc9fe1864ec7824eb9de035a7f40096a03ca3f45a257c89e8",
      "kind": "dialogue",
      "ko": "이제 루루의 매료는 폭주하지 않는 거야!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 9,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
