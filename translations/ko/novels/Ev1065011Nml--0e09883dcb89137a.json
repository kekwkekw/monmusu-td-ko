    {
      "command": "",
      "draft_row_sha256": "e92c9db0b2783d8aea8e47976512ff294ccc787e2fba27885295e9e3075590c2",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "これから皆さまには各世界の拠点にて、\n現在次元間を高速で航行中の、\nホロウクルスの眷属を迎撃してもらいます。",
      "jp_sha256": "25cb2c1b32d733a1e625e8833e9e11518a93d9359ea4f4cead24dc6ffd9508d1",
      "kind": "dialogue",
      "ko": "이제부터 여러분은 각 세계의 거점에서\n현재 차원 사이를 고속으로 항행 중인\n홀로우크루스의 권속을 요격하게 됩니다.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
      "review_note": "",
      "review_status": "reviewed",
