      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "もともと、パークさんは私の従者ですぞよ。\nだから魔法は効かないのですぞよ。",
      "jp_sha256": "592061c96776b0224ceaf12fabefb9a30d8f5f7cfa212615995d3f3c965e9edf",
      "kind": "dialogue",
      "ko": "원래 파크는 내 시종이로다.\n그러니 마법은 통하지 않도다.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 7,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
