      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それは大きな間違いなのよ、主。\n『愛』ほど……この世で怖いものはないのよ。",
      "jp_sha256": "315517a078da1ffe6f269f2c3b22c989bb4bb2375a0d35e605150aa97662652a",
      "kind": "dialogue",
      "ko": "그건 큰 착각이야, 주인.\n『사랑』만큼…… 이 세상에서 무서운 건 없어.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 10,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b013-20261109-same-model-pass2-5adf61fa",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "90087bd073bc8fcd1da31162ff5bbe70055026150e76d9486b11d91c8d82e202:000002_3207481244698449044:g0:r9",
      "row_index_0based": 9,
      "serialized_row_index": 9,
      "source_cells": [
