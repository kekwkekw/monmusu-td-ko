      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そのお金で、ビート板たくさん買うんだ！\nおらのせいで何枚かダメになっちまってるし！",
      "jp_sha256": "f6ee995d4a3c19480bf2a423540af9fe71fab11716c8b53f1254c882b329e3da",
      "kind": "dialogue",
      "ko": "그 돈으로 킥판을 잔뜩 살 거야!\n나 때문에 몇 장 못 쓰게 됐으니께!",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 20,
