      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "メリッサさん！？\nそうか……僕と一緒に落ちてきてしまったんですね。",
      "jp_sha256": "a383b60ec37c2aa2a3a1c886641b85c3bff930910e4404deeb9d7c8ea296d2bf",
      "kind": "dialogue",
      "ko": "멜리사 씨!?\n그렇구나……저와 함께 떨어져 버렸군요.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
