      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "お互い大きな怪我もなさそうですね。\nとりあえず出口を探して移動をする必要がありそうです。",
      "jp_sha256": "33b1b23d3fa0293d97d27c9dc05aacd46a982a028e60c0e7f5d30f66c9d2b5e2",
      "kind": "dialogue",
      "ko": "서로 큰 부상은 없는 것 같네요.\n우선 출구를 찾아 이동해야 할 것 같아요.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 28,
