      "row_index_0based": 13,
      "serialized_row_index": 13,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "メリッサさん！？\nそうか……僕と一緒に落ちてきてしまったんですね。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "76bc74965ae327c77dd547f36aaf118b71c15d6a202b6140c361b247f7a49fa1",
