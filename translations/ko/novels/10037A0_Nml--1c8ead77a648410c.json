    {
      "command": "",
      "draft_row_sha256": "f1cfc4d8a1277832239a9060cdda0ae82bf01a608aa31db1fde8a4ee6b5708bb",
      "grid_index": 0,
      "grid_message_index_0based": 2,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "僕は慌てて辺りを見渡す。\n数人の仲間と洞窟を探索中、足場が崩れてしまったのだ。\nそして長い坂を転がってきて……。",
      "jp_sha256": "f7d12a11f938143f0cc50610077415aeca9d896abb9b5940f28a89fd2b279d18",
      "kind": "dialogue",
      "ko": "나는 황급히 주위를 둘러본다.\n동료 몇 명과 동굴을 탐색하던 중 발판이 무너진 것이다.\n그리고 긴 비탈을 굴러 내려와…….",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 12,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
