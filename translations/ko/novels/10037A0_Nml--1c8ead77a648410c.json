    {
      "command": "",
      "draft_row_sha256": "e92f7a5b175e78944e524d37bd8fd83bcea9ad2211a6dc574b5ce908f24b5143",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "洞窟の中にかわいらしいくしゃみの音が響く。\n見れば、メリッサさんは不思議そうな顔をして\n自分の体をさすっていた。",
      "jp_sha256": "da26306716602d2d769031329f2269858f18a3d37d985ebad4d81179cf86262e",
      "kind": "dialogue",
      "ko": "동굴 안에 귀여운 재채기 소리가 울린다.\n보니 멜리사 씨는 이상하다는 얼굴로\n자기 몸을 문지르고 있었다.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 33,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
