    {
      "command": "",
      "draft_row_sha256": "093c9e9e49390b0f350348ac5ef1cff75c88936cb3e99a0e8c773e99f69731d7",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "うむ、妾も同じ考えだ。\n一刻も早く外へ出るか、他の者と合流したいところ――。\n……くちゅん。",
      "jp_sha256": "84d179fff439d6eb99ec65e8ba1de8ba93d2ea21b99f02e1caf445d1a9b64e71",
      "kind": "dialogue",
      "ko": "음, 짐도 같은 생각이다.\n한시라도 빨리 밖으로 나가거나 다른 이들과 합류해야――.\n……에취.",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 29,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
