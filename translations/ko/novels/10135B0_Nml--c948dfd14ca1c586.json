      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "fc1c5f0e780612e075df11b9b11b0d2e6b3be3b144ebd93c6cb2e8940dc7b605",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "っかぁ～～～！　美少年をはべらせて飲む酒は格別だなぁ！\nおう、折角だ！　何か芸とかできねえのか！？\nほれ、この魅力的な尻を振って踊ったりとかよ！",
      "jp_sha256": "9d4b43dab8b1ca5f83347519b0c4044ba0f36bac2aa21a2f762d8a18fd04e7da",
      "kind": "dialogue",
      "ko": "크아～～! 미소년을 옆에 끼고 마시는 술은 각별하구나!\n야, 모처럼이니 뭐 재주 같은 건 없냐!?\n자, 이 매력적인 엉덩이를 흔들며 춤춘다거나!",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 15,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
