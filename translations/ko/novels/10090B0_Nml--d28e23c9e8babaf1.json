    {
      "command": "",
      "draft_row_sha256": "c902fd0e0e8cf3d1e5577c64877c10647f2c09af175cc094433a31094ae3b916",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あやつは敏感体質で、寝床の土質にはうるさいからのぅ。\nわしが一肌脱いでやっとるわけじゃ！\nまぁ、結果一肌燃えてしまったわけじゃが……。",
      "jp_sha256": "4bdc2238389c7da1f6dc48e73cef4f4b0eacca4f75a413667a71272dc7a61f28",
      "kind": "dialogue",
      "ko": "그 녀석은 민감한 체질이라 잠자리의 토질에 까다롭거든.\n그래서 내가 한몫 거들고 있는 게다!\n뭐, 결과적으로 살갗 한 꺼풀을 태워 먹었지만…….",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 57,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "44d2327f9bc7a3525e0565aecc6d92481a8c4ef4a4185a3f7c51adafc152211c:000000_-4119221820154667214:g0:r56",
      "row_index_0based": 56,
      "serialized_row_index": 56,
      "source_cells": [
