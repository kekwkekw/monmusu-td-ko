    {
      "command": "",
      "draft_row_sha256": "9513588dcff74a2ce640f7a04ff0b4ad807ef008c6fd67498b48a38667378cfb",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
