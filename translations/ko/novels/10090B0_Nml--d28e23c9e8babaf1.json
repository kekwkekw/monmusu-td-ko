      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "でも、ここはレントープさんにとっても危険でしょう？\n単身で乗り込まずとも、ドネさんにも協力してもらっては？",
      "jp_sha256": "f231dad0333bdfcf00c24574e60f7883189d5a28f955955d06774d2a232158a1",
      "kind": "dialogue",
      "ko": "하지만 여긴 렌토프 씨에게도 위험하잖아요?\n혼자 들어오지 말고, 도네 씨에게도 협력을 부탁하면 되지 않을까요?",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 58,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "44d2327f9bc7a3525e0565aecc6d92481a8c4ef4a4185a3f7c51adafc152211c:000000_-4119221820154667214:g0:r57",
