      "review_status": "reviewed",
      "row_id": "79acfdace4d7f3ea78db5c5fca71895ed20cb76486144b8ef5b13062e567c3fc:000000_-4801517697809286916:g0:r20",
      "row_index_0based": 20,
      "serialized_row_index": 20,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "ちょ、ちょっと落ち着いてください、アイレンさん。\n興奮しすぎて口調が変になってますよ。"
      ],
