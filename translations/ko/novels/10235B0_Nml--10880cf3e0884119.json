      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なのに、なのに、誰１人として、\n風紀を守った正しいバレンタインをしようともしない！\n隙あらば、主様に破廉恥なことをしようとする輩ばかりです！",
      "jp_sha256": "297d712de1abc9e338ddb1959584efc98f69a8c9f02e51f7f30d9a2ee220a345",
      "kind": "dialogue",
      "ko": "그런데도, 그런데도 누구 하나\n풍기를 지키며 올바른 밸런타인데이를 보내려 하지 않습니다!\n틈만 나면 주군께 파렴치한 짓을 하려는 자들뿐입니다!",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 35,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
