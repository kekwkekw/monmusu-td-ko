      "grid_message_index_0based": 2,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そういえば、ご主人さま。あなたと私はこれまで\nたくさんの時間を共に過ごしてきたわけですが、\n何か思い出などありますか？",
      "jp_sha256": "f25f82cc964970121ebbf8e7b5cb8b05433da82d9c0f86a1f57fd44423ad8085",
      "kind": "dialogue",
      "ko": "그러고 보니 주인님. 당신과 저는 지금까지\n많은 시간을 함께 보냈는데,\n무언가 추억이 있습니까?",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 15,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b011-20261107-ff47d2c5b69e",
      "review_note": "",
      "review_status": "reviewed",
