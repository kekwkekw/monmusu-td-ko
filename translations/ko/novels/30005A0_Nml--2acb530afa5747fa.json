    {
      "command": "",
      "draft_row_sha256": "6b15f5a3b02c034adc82e1539e83eaf1f9187008fa60e2518102791ef8128e87",
      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ふふふ、そうでしょう。\nかなり濃厚で密な時間を過ごしてきましたからね♪\n……って、別に変な意味じゃありませんよ。わかっていますね？",
      "jp_sha256": "71ca1024eac05f4706a2487fdabca4e9796eff374f4737efa82f5295236e7d68",
      "kind": "dialogue",
      "ko": "후후후, 그렇겠지요.\n상당히 농후하고 밀도 높은 시간을 보냈으니까요♪\n……그렇다고 딱히 이상한 의미는 아닙니다. 알고 계시죠?",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 47,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b011-20261107-ff47d2c5b69e",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "e88d5cc4c6fb00af856b313e66265b504c8d1d0241f1b9159a72ced84254a6d6:000001_-2059170375748972497:g0:r46",
      "row_index_0based": 46,
      "serialized_row_index": 46,
      "source_cells": [
