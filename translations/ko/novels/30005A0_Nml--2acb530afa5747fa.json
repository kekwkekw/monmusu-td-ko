      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "何がそんなに忙しいのか……と言われましても。ふふふ。\nまだ秘密です。サプライズには、いろいろと準備が必要なのですよ。",
      "jp_sha256": "36c9472496645d6f408aca04f9d90326a1688f937af968cdd253f761ec18d9ae",
      "kind": "dialogue",
      "ko": "무엇 때문에 그렇게 바쁘냐고…… 물으셔도. 후후후.\n아직 비밀입니다. 서프라이즈에는 여러 준비가 필요하거든요.",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 55,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b011-20261107-ff47d2c5b69e",
