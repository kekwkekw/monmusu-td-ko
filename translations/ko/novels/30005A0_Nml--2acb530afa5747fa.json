    {
      "command": "",
      "draft_row_sha256": "4b5840fd211240b2f223e1b5120fe9ec65f1c3fcc979c3e47b42aa1729e30d00",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "――と、まぁ。\n積もる話もあるのですが、あいにく私は忙しいのです。\n偉大な獣神である私は、多忙を極めているんですよ、偉大ゆえに。",
      "jp_sha256": "120ee031b54181adf16cebca9484c12f8d9b645c3c185e596e64efb2ae16a885",
      "kind": "dialogue",
      "ko": "――뭐, 그렇습니다.\n쌓인 이야기도 있지만 공교롭게도 저는 바쁩니다.\n위대한 수신인 저는 극도로 바쁘거든요, 위대하니까요.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 54,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b011-20261107-ff47d2c5b69e",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "e88d5cc4c6fb00af856b313e66265b504c8d1d0241f1b9159a72ced84254a6d6:000001_-2059170375748972497:g0:r53",
      "row_index_0based": 53,
      "serialized_row_index": 53,
      "source_cells": [
