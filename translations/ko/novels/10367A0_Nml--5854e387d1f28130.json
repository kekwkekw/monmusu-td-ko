      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あの……これ、どのあたりが“実験”なんですか？",
      "jp_sha256": "2fc86ac05680937e702a081ebf787f025ab5f4186108933a93752b3ebc260165",
      "kind": "dialogue",
      "ko": "저기……이게 어느 부분에서 ‘실험’인가요?",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 54,
