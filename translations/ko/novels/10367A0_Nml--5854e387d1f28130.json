      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ご覧ください、ご主人様。体位、挿入角度、\n手の置き場所から舌の絡ませ方まで、\n細かく手書きで記された古代性行為大全です。",
      "jp_sha256": "1eb8ccd8dc10563ee3dadee68ce176d6c87ecf85a0ea79c3ca10c8af0ff108b5",
      "kind": "dialogue",
      "ko": "보세요, 주인님. 체위와 삽입 각도,\n손을 놓는 자리부터 혀를 얽는 방법까지,\n세세하게 손으로 기록한 고대 성행위 대전입니다.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 48,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b008-20261106-451bb6a2fb2c21c5",
      "review_note": "",
      "review_status": "reviewed",
