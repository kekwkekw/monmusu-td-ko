      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "いえ、初めて嗅いだご主人くん……いえ、\n美少年の香りに興奮しているみたいです。\nさすが、ビックマミーちゃん。ヤる気ムンムンです！",
      "jp_sha256": "4fe99008c2e989d4fa74cb0f37e245d0526331d0a7c3aecae894d53288fac223",
      "kind": "dialogue",
      "ko": "아뇨, 처음 맡아 본 주인님…… 아니,\n미소년의 향기에 흥분한 것 같아요.\n역시 빅 마미. 의욕이 넘쳐요!",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 34,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
