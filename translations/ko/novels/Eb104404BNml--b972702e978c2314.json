      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なら私はご主人くんを５０年しっかり教育してあげるわね。\nふふ、いろんなことをたーっくさん教えてあげる。",
      "jp_sha256": "39ba8ca21928334bc4c49c7ae8c16fb88cd36b575c5f28f1f326c38a7e8015d6",
      "kind": "dialogue",
      "ko": "그럼 나는 주인 군을 50년 동안 확실하게 교육해 줄게.\n후후, 여러 가지를 자――안뜩 가르쳐 줄게.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 26,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
