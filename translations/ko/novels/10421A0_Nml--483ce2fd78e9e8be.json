      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "んー、今さっきかな。ちょっとそこで、\n噂の密猟者ってのに珍しいモンスター娘だって襲われて、\n返り討ちにしてたんだ。",
      "jp_sha256": "d3e6f8ec3529cc818b8f1c859ab86f670176be12d02af3435bb67e9637d5cf68",
      "kind": "dialogue",
      "ko": "음ー, 방금 전쯤일까. 저기서,\n소문의 밀렵꾼이라는 녀석에게 희귀한 몬스터 소녀라며 습격당해서,\n되받아치고 있었거든.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 59,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
      "review_note": "",
      "review_status": "reviewed",
