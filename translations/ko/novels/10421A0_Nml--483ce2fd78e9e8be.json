    {
      "command": "",
      "draft_row_sha256": "78bb6a79a577e72b11bb23d582f8c800436768d2e32411f0f0bd8bae7f6a80de",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それじゃあさっきの悲鳴はズィズィーさんが……。\nはぁ……無事で良かったです。",
      "jp_sha256": "aadf024abdbd2ff6ddfa0785e30e6cb9d21b98398290e5f2908749d31d202891",
      "kind": "dialogue",
      "ko": "그럼 아까 비명은 즈지 씨가…….\n하아…… 무사해서 다행이에요.",
      "message_index_0based": 11,
