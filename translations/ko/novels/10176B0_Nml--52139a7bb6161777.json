      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "エリュートさん、心配しましたよ！\n……なんでまだ花嫁衣裳を着ているんですか？",
      "jp_sha256": "8781df29929d8f9bd9f5a797cfa0c3a38c97bcb66de61ac2fa6ba8d3dddf1809",
      "kind": "dialogue",
      "ko": "에류트 씨, 걱정했어요!\n……그런데 왜 아직도 신부 의상을 입고 있어요?",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 11,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
