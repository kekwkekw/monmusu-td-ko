      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ルルクアさん、すごくやる気ですね。\nなんだか……と言ったら失礼ですが、意外でした。",
      "jp_sha256": "3e7293c0a65ebd45c9fca9995b830503c894eedd172c4e9fc3614ed4daca3fc5",
      "kind": "dialogue",
      "ko": "루루쿠아 씨, 정말 의욕이 넘치네요.\n왠지…… 이렇게 말하면 실례지만, 의외였어요.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 45,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
