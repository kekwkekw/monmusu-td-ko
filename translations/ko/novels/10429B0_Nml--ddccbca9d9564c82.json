      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ルルクアさんは地面を注意深く見ながら、\n小さなゴミを拾い集めている。",
      "jp_sha256": "195671eb514d91fc7ded6bb1b490a0d5a7795caea5a4aee1529fa74692b96a4f",
      "kind": "dialogue",
      "ko": "루루쿠아 씨는 땅을 주의 깊게 살피면서,\n작은 쓰레기를 주워 모으고 있다.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 42,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
