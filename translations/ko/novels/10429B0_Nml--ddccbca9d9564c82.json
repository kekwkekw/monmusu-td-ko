      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "確かに私は引きこもりのヒッキーですし、\n１日中どころか、１年中閉じこもっていたいタイプですが――。",
      "jp_sha256": "7d889aeebbf7cd7680cd053f46b7cbd83e9e395146dfbc74bff7193a68b516ee",
      "kind": "dialogue",
      "ko": "확실히 저는 틀어박힌 히키코모리고,\n하루 종일은커녕 일 년 내내 숨어 있고 싶은 타입이지만――.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 72,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
