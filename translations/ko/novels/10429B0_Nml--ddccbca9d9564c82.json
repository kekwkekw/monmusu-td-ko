      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あっ、ご主人様、見て下さいな。\nこんなところに割れた瓶が……危ないですわね。",
      "jp_sha256": "7728d3d0b6d891bfe0e91fadf1fd43c5ea54a7a25a950f51f9075aed087cffc1",
      "kind": "dialogue",
      "ko": "앗, 주인님, 이것 좀 보세요.\n이런 곳에 깨진 병이…… 위험하네요.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 22,
