      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "d58f3c3b1ad34d3624929f8c0f21fefb15a78fdb1f6fdc3c45a5f8dac0be5f96",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なんだか――批評家――いや、鑑定家のようだ――。\n批評を受けて――式神も――なんだか――ほっこりしている――。",
      "jp_sha256": "a60b03b5cdff25cbd256cabd976f2d5266dad57e1ab14cb4961fc10f08bf2a22",
      "kind": "dialogue",
      "ko": "어쩐지――평론가――아니, 감정사 같군――.\n평을 듣고――식신도――왠지――훈훈해하고 있다――.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 24,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
