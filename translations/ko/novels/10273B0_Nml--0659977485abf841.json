      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なんか久々だなァ、大人の玩具作りも！\nお客様の悦ぶ顔が目に浮かぶってもんだ！",
      "jp_sha256": "7133f3b278e51ffc179ad31b6209de592a39b65f1b78035b00975d296cf32d09",
      "kind": "dialogue",
      "ko": "성인용품 만들기도 왠지 오랜만이네!\n손님이 기뻐할 얼굴이 눈에 선해!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 10,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b006-20261106-same-model-pass2-r1",
