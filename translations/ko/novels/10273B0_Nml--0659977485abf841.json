      "kind": "dialogue",
      "ko": "오랜만에 마음이 내켰거든!\n게다가 의뢰를 너무 많이 쌓아 뒀어!",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 16,
