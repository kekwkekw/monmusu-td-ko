      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あなた、戦闘中に見ないと思っていたら……\n私たちを囮に使って、工房へもぐりこんでいたのですね……。",
      "jp_sha256": "8e49dec195f0217fb1e9cda801d34dea0a90e734c5f37b423cf4810d9e17a827",
      "kind": "dialogue",
      "ko": "당신, 전투 중에 안 보인다 했더니……\n우리를 미끼로 삼아 공방에 숨어들었던 거군요…….",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 30,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
