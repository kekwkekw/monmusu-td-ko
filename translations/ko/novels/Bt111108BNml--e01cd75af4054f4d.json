      "grid_message_index_0based": 2,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "不良品よ！！　不良品を掴まされたのよ！！\nこの強欲悪魔！！　わたくしのお小遣いを返しなさいませ！！",
      "jp_sha256": "66f56df45e4261676de6ded8bc7c1b8211eb39cd57c4239165f4edad8907a535",
      "kind": "dialogue",
      "ko": "불량품이야!! 불량품을 떠넘긴 거라고!!\n이 탐욕스러운 악마!! 내 용돈을 돌려줘요!!",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 5,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b012-20261109-same-model-pass2-aaabc0ee",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "24abe166c384906fb8a5acc35c2a5d7aceee7b81d99840bff1c245b47ec99759:000000_-4883790438135855618:g0:r4",
      "row_index_0based": 4,
      "serialized_row_index": 4,
      "source_cells": [
        "",
        "",
        "わがままお嬢様",
        "Emt2_Ang",
        "layer_左中前",
        "",
        "",
        "0.3",
        "",
        "不良品よ！！　不良品を掴まされたのよ！！\nこの強欲悪魔！！　わたくしのお小遣いを返しなさいませ！！",
        "",
        "en_49051/Main/1111/1111_49051_420",
        "",
        ""
      ],
      "speaker": "わがままお嬢様",
      "translation_status": "translated",
