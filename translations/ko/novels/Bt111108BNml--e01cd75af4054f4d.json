      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "――この私が不良品をお嬢様にお渡しした、と？\n確かに、私はマモン娘。悪魔モンスター娘ですが、\n取引の上で等価交換はきっちりいたしますよ？",
      "jp_sha256": "0e3b21456a44857a06a8f475ccd770d219d1c7fcaa1fb75201aa774274a41069",
      "kind": "dialogue",
      "ko": "――이 제가 불량품을 아가씨에게 건넸다고요?\n확실히 저는 마몬 소녀, 악마 몬스터 소녀지만\n거래에서는 등가 교환을 철저히 지킵니다.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 6,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
