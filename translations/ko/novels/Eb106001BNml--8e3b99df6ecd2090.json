      "kind": "dialogue",
      "ko": "당연하죠.\n위대한 수신인 저의 은혜가 있었다면\n밀렵꾼 따위가 페스티벌을 방해하는 일은 없었을 겁니다.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 7,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
