      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ティヴェルさん――彼女はかつて一緒に戦った、\nT.O.W.E.R.さんが別個に生み出した、\n彼女とは全く別の存在だという。",
      "jp_sha256": "f9af635c30449fbe3e066dc7f738a7b3a2c74f79b94bfcc57231e87ba8f4f1d6",
      "kind": "dialogue",
      "ko": "티벨 씨――그녀는 과거 함께 싸웠던,\nT.O.W.E.R. 씨가 별도로 만들어 낸,\n그녀와는 완전히 다른 존재라고 한다.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 38,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "8dde204b6abe71c440a4a844948df5e86b061869f206152031336ba58eda0964:000000_-7134388585143848960:g0:r37",
      "row_index_0based": 37,
      "serialized_row_index": 37,
      "source_cells": [
        "",
        "",
        "",
        "",
        "",
        "",
