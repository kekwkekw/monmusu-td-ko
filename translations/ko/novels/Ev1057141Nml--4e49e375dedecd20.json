    {
      "command": "",
      "draft_row_sha256": "f08be2e6d5f7d90979829ff5d95baa0e7f1d497062e38235063cbf476f82c641",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なっ！？　すごい威力デス！\n蛮族には不釣り合いな兵器デス！！",
      "jp_sha256": "b4d554033edd3c9e2dacac53d389d17a117040c6ff0a750205d592de5fe824f5",
      "kind": "dialogue",
      "ko": "뭣!? 엄청난 위력입니다!\n야만족에게 어울리지 않는 병기입니다!!",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 56,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
