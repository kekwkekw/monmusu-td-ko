        "",
        "ピンダ",
        "Emt6_Sur",
        "layer_右中",
        "",
        "",
        "0.3",
        "",
        "なっ！？　すごい威力デス！\n蛮族には不釣り合いな兵器デス！！",
        "",
        "",
        "",
        ""
      ],
      "speaker": "ピンダ",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "c993a0e0958f7f53f6145aad1e3aec035a22229da2379d011c9a25cd8b48e333",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あ、ああ……なんて威力だ……。\n頭の足りない種族だと思っていたが、\nこれほどの科学力を持っていたとは……！",
