      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "b160598b8451189fd91c3622453fe9d4a3c488e67c7b42cea9932eb5e9ded388",
      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ああ、そんなもん目じゃないねぇ。\nほら、そこに転がってるやつがお目当ての武器だ。",
      "jp_sha256": "8b84bed62b6bedb609de0f45ccdf74682615ea40863dea0de925ccb24de299da",
      "kind": "dialogue",
      "ko": "그래, 그런 건 상대도 안 되지.\n봐, 저기 굴러 있는 게 너희가 찾던 무기야.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 31,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
