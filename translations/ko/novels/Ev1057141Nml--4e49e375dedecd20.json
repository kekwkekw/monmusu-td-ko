    {
      "command": "",
      "draft_row_sha256": "28706bf80464961bef36e31db397858f2b8baeac907c434ffa865272f13be48f",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "クルクリさんがバリスタを始動させると、\n近くの山の頂点が吹き飛んだ。",
      "jp_sha256": "0d6d8ca3fce76d84d31e9f1d9df16c8d888515916402067dcba065184055f8d5",
      "kind": "dialogue",
      "ko": "쿠르쿠리 씨가 발리스타를 가동하자\n근처 산의 정상부가 날아갔다.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 53,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
