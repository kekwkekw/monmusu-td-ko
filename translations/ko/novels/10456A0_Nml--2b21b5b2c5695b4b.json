      "kind": "dialogue",
      "ko": "햇빛이 찬란하게 내리쬐는 해변.\n신이 난 몬스터 소녀들에게 주의를 주는 목소리가 날아왔다.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 16,
