      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "4e6e3e0a996124b90ebf88af63d78bbf43259fb7aa6a41110113dacf171a15c9",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "えー……でもパ――ルカに頼むわけにはいかないしなぁ。\n最悪、あたしと兄貴が消えちゃう可能性も……。\nあーあ、どういう感じにロリ化するか興味あったのにー。",
