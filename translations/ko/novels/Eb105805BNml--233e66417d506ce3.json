      "kind": "dialogue",
      "ko": "천하다니 말이 심하네.\n아무리 천한 자라도 고용주의 정체는 말할 수 없어.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 6,
