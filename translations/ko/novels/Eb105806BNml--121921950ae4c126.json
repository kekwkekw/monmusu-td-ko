      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ということは――。\nナキメは――今、ピンチなのか――。\nそうか――オホ声で――私たちに、危機をしらせようと――。",
      "jp_sha256": "168a5ed79a97a05703a57cb30218ed5e82a3291eeaf03a2ce11d26fe351f3adb",
      "kind": "dialogue",
      "ko": "그렇다면――.\n나키메는――지금, 위기에 처한 건가――.\n그렇군――오호 소리로――우리에게, 위기를 알리려는――.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 12,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b013-20261109-same-model-pass2-5adf61fa",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "0ce95cb2f7c1933853c4716a767e47ae6efa88c5f482075d3e948191efebfa1f:000002_8229226578456589428:g0:r11",
