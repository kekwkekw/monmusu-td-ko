      "review_status": "reviewed",
      "row_id": "0ce95cb2f7c1933853c4716a767e47ae6efa88c5f482075d3e948191efebfa1f:000002_8229226578456589428:g0:r15",
      "row_index_0based": 15,
      "serialized_row_index": 15,
      "source_cells": [
