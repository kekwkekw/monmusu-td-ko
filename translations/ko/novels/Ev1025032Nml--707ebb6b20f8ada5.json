      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "もっもしかして、僕を連れ出したのはそれだけのために――",
      "jp_sha256": "323666969be86ef5107651dbfedcd854baed0a76cc0928c80db495e87ca8851d",
      "kind": "dialogue",
      "ko": "서, 설마 저를 데리고 나온 건 그것만을 위해서――",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 18,
