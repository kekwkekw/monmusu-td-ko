      "kind": "dialogue",
      "ko": "다크 왕자의 군세를 물리치고 왕성으로 서두르는 주인공 일행.\n그러나 한 인물이 그 앞길을 가로막았다.",
      "message_index_0based": 0,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
