      ],
      "speaker": "",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "2e5e7b9a7254858931e72d1afcad23ca62cbe6644112b3d0d6d385d27a7eda72",
