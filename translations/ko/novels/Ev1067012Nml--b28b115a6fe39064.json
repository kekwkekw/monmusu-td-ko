      "review_status": "reviewed",
      "row_id": "7b698aba3066a77ac966562a1684841f17507ad3e84223145459820376d9ab47:000000_-4217186548416348807:g0:r21",
      "row_index_0based": 21,
      "serialized_row_index": 21,
      "source_cells": [
