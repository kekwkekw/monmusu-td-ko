        "",
        "",
        "",
        ""
      ],
      "speaker": "アニス",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "bef92fec8dd6d329beb6c06128510b26882ae0d71081b9bc9b9de6e91ab48682",
