      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あれ……どこ行っちゃったんだろう。\nというか、こんなに日陰が広かったっけ――あっ！？",
      "jp_sha256": "16afa4b2947f2ca23da42f4ea841dd7692340329303d99c165970e29a60fa8d0",
      "kind": "dialogue",
      "ko": "어라…… 어디 간 거지.\n그보다 그늘이 이렇게 넓었나―― 앗!?",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 10,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
