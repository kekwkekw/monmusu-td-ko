      "review_status": "reviewed",
      "row_id": "b239f79f25d40d5d72e4538b572258aca8ffcac7e2bb6a9f9580494288645236:000002_8513537780737648324:g0:r19",
      "row_index_0based": 19,
      "serialized_row_index": 19,
      "source_cells": [
        "",
        "",
        "主人公",
        "",
        "",
        "",
        "",
        "",
        "",
        "シルバさん、どうかしましたか？\nなんだか調子が悪そうですが……。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "db05c65c0ba2fc93c5348aa70962f00346418e4e41ff8d3d5ab357fd6c9279e2",
      "grid_index": 0,
      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "む――ご主人――。\n肩が凝って――つらくて――な。",
      "jp_sha256": "44b188bc699f689fe6b93dba0d14d46eef864f564b03ff5255fbddcfeae2cd61",
      "kind": "dialogue",
      "ko": "음―― 주인――.\n어깨가 뭉쳐서―― 괴롭다――.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 21,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
