      "kind": "dialogue",
      "ko": "마물 대군을 물리친 뒤\n피로로 녹초가 된 주인공 일행은 땅바닥에 주저앉았다.",
      "message_index_0based": 0,
      "page_ctrl": "",
      "physical_line_1based": 8,
