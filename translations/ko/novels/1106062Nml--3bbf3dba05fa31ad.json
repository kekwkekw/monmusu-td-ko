    {
      "command": "",
      "draft_row_sha256": "2065290871effd1dc43a6ea8837e7ee0c11da5c4fc377782ab877ea452541f17",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "大丈夫、サキュバス娘であっても、あのクロミちゃんだよ？\nボク以上に心のナニはビンビンなはずさ。さあ、立って！\nそして、ボクらで\"あれ\"を召喚するんだ。",
      "jp_sha256": "0cbad412bb7f957cde0a1d342e569c7c8c034a4723b168b290d48f3703942878",
