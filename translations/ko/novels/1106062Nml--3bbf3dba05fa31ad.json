      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "クロミは、インキュバス娘じゃないから、\n立つものもないんじゃないかなぁ？",
      "jp_sha256": "6e597aa4ae55b28434e9c1ccdfe4533a5e8515ad86c4c36e6df5274ca0dd508a",
      "kind": "dialogue",
      "ko": "쿠로미는 인큐버스 소녀가 아니니까\n일어설 것도 없지 않을까아?",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 76,
