      ],
      "speaker": "",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "4f30b78da6a66368bbc2735a2c1890b44ae0a3ff4b407bcfef0156b94bae137d",
