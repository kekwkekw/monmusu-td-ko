      "kind": "dialogue",
      "ko": "하지만 밀렵꾼 말고는 관객이 없군.\n매기의 발밑에서 빛나는 코인은\n아마 아메리 일행이 동정해서 던져 준 돈이겠지.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 25,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b013-20261109-same-model-pass2-5adf61fa",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "55f5fc4e60470a907d8afd9ed5056c869d361d37cfd891afbe9e824468d6a2ec:000002_7433112941569026358:g0:r24",
