      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "dc76e8562352599036fb97453b6f270c4ed47b4c96e2f0b5d45eb410fef477aa",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "寝過ぎですよ！？\nしかもそれで氷漬けになっちゃうだなんて！",
      "jp_sha256": "d0d33e034a4d0979d42509e98937e8bdd27ed520c44f04888e87ab0b4aa347fd",
      "kind": "dialogue",
      "ko": "너무 오래 잤잖아요!?\n게다가 그것 때문에 얼음에 갇히다니!",
      "message_index_0based": 11,
