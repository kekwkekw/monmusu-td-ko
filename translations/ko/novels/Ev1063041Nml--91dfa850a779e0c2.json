    },
    {
      "command": "",
      "draft_row_sha256": "fc6410503c0a516e28149ef26a805e8040888a4b76ceac33aa2e0a92e94ff944",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "洞窟の中で涼んでたら、\n１００年くらい寝ちゃって氷漬けになったもす。\nドえらいめにあっちゃったもす。",
      "jp_sha256": "214e07dfca0c6fae7941a36871061c7f07632007d4e92ed51dcc99a5db4ec91e",
      "kind": "dialogue",
      "ko": "동굴 안에서 더위를 식히다가\n백 년쯤 잠들어서 얼음에 갇혔모스.\n엄청난 꼴을 당했모스.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 77,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "34fbb6fe4aec0e45d84dc13761d54db7e7d0f69efea2a10d984f29e4bcc2d8a4:000000_-8359648316756626758:g0:r76",
