      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "2a7eb4a3e0a0aea037e7bcf8a2bcaaa819c4c40e9341252c61731735e779dd57",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "気にしなくて良いわ。掃除は趣味みたいなものだから。\nそれに星徒会室の掃除だって、たまに私がしているのよ。\n客なのになんて今更だわ。",
      "jp_sha256": "020fcde1645f987aff8af6c73b9e25512b4f3ff1976eb3430bb9775a5c115263",
      "kind": "dialogue",
      "ko": "신경 쓰지 않아도 돼. 청소는 취미 같은 거니까.\n게다가 학생회실 청소도 가끔은 내가 해.\n손님인데 어쩌고 하는 건 이제 와서 새삼스러워.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 24,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
      "review_note": "",
      "review_status": "reviewed",
