      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ま、マハムートさん！？\n何をされているんですか……？",
      "jp_sha256": "78ea13489f4a0392c67c192fe1ee27bfc217a7935a27ecab07b475b3bdd6358d",
      "kind": "dialogue",
      "ko": "마, 마하무트 씨!?\n뭘 하고 계세요……?",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
