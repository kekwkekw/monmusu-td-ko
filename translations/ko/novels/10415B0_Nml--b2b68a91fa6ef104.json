    {
      "command": "",
      "draft_row_sha256": "8161243343a4f65f4ad84b1aba9acaa0bd1be527c7567b736274f0aeaa6fa5dd",
      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なにって見て分かるでしょ。掃除よ。\nこの食堂、どうにも汚れていたから気になって。",
      "jp_sha256": "2615e632012f97cf3a466ffa6bf7a6efcbf87973fd82c18252f7985c19971540",
      "kind": "dialogue",
      "ko": "뭐냐니 보면 알잖아. 청소야.\n이 식당, 영 더러워서 신경 쓰였거든.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 19,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
