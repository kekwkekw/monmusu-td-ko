    {
      "command": "",
      "draft_row_sha256": "eea5e2b6192b862ecbc0c814b1b40adee047a07a0fbd24cfe421ada94834c8c2",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ちょっと待ちなさいっ！　この黄金に輝く金糸の髪や宝石のように\n美しい青い瞳をした眉目秀麗なわたくしを前にして、\n萌えない上にヤる気もでないなんて、本気なの！？",
      "jp_sha256": "658e214bf04d8301dd97069f6aa59448fe88b278a29a76a0d8cfc78de15912ab",
      "kind": "dialogue",
      "ko": "잠깐만요! 금빛으로 빛나는 비단결 머리와 보석처럼\n아름다운 푸른 눈을 지닌 절세미인인 내가 앞에 있는데,\n흥이 안 나는 데다 할 마음도 없다니, 진심인가요!?",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 36,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
