    {
      "command": "",
      "draft_row_sha256": "f40430bf43ff666244bbf5f2c424a1897ab2e3bf909a76f533fdc93ab1f658ff",
      "grid_index": 0,
      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "私もね、「いい人がいたら」って言うんだけど、\nそもそもこの島には人がいないでしょ？\nまぁ、最近いい人が現れたんだけどねん？",
      "jp_sha256": "a7e422cf5f0dec81c674df271a420558f75584c1259832c6ad96657046216c96",
      "kind": "dialogue",
      "ko": "나도 「좋은 사람이 생기면」이라고 말하지만\n애초에 이 섬에는 사람이 없잖아?\n뭐, 최근에 좋은 사람이 나타나긴 했지만 말이야?",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 21,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
