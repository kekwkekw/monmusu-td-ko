      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あなたたち、密猟者ですよね！？\n僕、モンスター娘さんじゃありませんよ！？",
      "jp_sha256": "bcfadcff661cc232e6e9129b43001069ce05223e0a59c82d913ef0da27e7bee9",
      "kind": "dialogue",
      "ko": "당신들, 밀렵꾼들이죠!?\n저는 몬스터 소녀가 아니라고요!?",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
