      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "噂は本当だったんだな！\n極上の美少年が蜘蛛の巣に捕まってるぞ！\nこれは見過ごせない……！",
      "jp_sha256": "e976e3ec1a23fc4586e3e704d321bba3e83960fd4a8d91e7be628fb3f9b4f0f7",
      "kind": "dialogue",
      "ko": "소문이 사실이었군!\n최고급 미소년이 거미줄에 잡혀 있어!\n이건 그냥 지나칠 수 없지……!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
