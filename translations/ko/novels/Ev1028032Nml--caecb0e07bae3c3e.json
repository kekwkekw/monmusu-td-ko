      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "やっと思い出してくれたんですねぇ、ビビ神様～。\nその通り、私はサンドワーム娘のヘディアよぉ。\nそれじゃあ、この少年はどちら様？　ご主人様ではないの？",
      "jp_sha256": "0e0b6d04e4d6643479d7834581c45f71c1a17ae8c1ca1ced51466b7be2f24abb",
      "kind": "dialogue",
      "ko": "드디어 기억해 주셨네요오, 비비 신님~.\n맞아요, 저는 샌드웜 소녀 헤디아예요오.\n그럼 이 소년은 누구죠? 주인님이 아닌가요?",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 42,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
      "review_note": "",
      "review_status": "reviewed",
