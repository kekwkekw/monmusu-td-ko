      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あ……ま、待ってなの、ご主人様。\nお邪魔じゃないの、ルルゥがびっくりしただけで、\nその、ごめんなさい……なの。",
      "jp_sha256": "d4efec9140f7d83c792b625eab2570772a4bc1f1365f7a12bbdd2c698ee47361",
      "kind": "dialogue",
      "ko": "아……기, 기다려 줘, 주인님.\n방해가 아닌 거야. 루루가 놀랐을 뿐이라서\n그, 미안해……인 거야.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
