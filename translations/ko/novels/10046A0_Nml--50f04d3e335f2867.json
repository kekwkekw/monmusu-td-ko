    {
      "command": "",
      "draft_row_sha256": "55c1dd33a06ecd7ae14178a2de2a71d1121099a60bda93d084a15fd99d7434a7",
      "grid_index": 0,
      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あ、逃げないで！　驚かせてごめんなさい。\n何か困っているなら力になろうとしただけで……。\nえっと、その、お邪魔しました。",
      "jp_sha256": "dc02a68ec4f3a40ad1ee6450500b77e68064d9d999334b317ad326def522b2be",
      "kind": "dialogue",
      "ko": "앗, 도망가지 마세요! 놀라게 해서 미안해요.\n곤란한 일이 있다면 도와드리려 했을 뿐이라…….\n저기, 그럼 실례했어요.",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
