    {
      "command": "",
      "draft_row_sha256": "395458246d8d923d467a1c0402cd6a27f872e8e2511b64e8beef4f8908581353",
      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ワタシの友達はみんな善良で優しいコたちなんだよ～！\n主さん、手を貸して！　お願いだよぉ～！",
      "jp_sha256": "bff3c30b0218ad2a61a2cec3a412bc2dc88227f4ba867fc658f8494c36d54958",
      "kind": "dialogue",
      "ko": "내 친구들은 모두 선량하고 다정한 아이들이야～!\n주인님, 힘을 빌려줘! 부탁이야～!",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 15,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
