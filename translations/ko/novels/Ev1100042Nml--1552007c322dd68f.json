      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "開けられなかったのですよね～。\n中身は気になりますが、持っていることが大事ですから。",
      "jp_sha256": "51c310a549c7e8778d8f6fd1dbc6cb2a3630f98512b780790fc242db338605fe",
      "kind": "dialogue",
      "ko": "열리지 않았지요~.\n내용물은 궁금하지만 가지고 있는 게 중요하니까요.",
      "message_index_0based": 10,
      "page_ctrl": "",
