      "grid_index": 0,
      "grid_message_index_0based": 22,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "えー？　たまも様はそっちにはいないよ。\nこっちから気配がしてるんだから、こっちー！",
      "jp_sha256": "dbd3b17ac6637f92bcdb6cc978d321dc2f48d3d6dd083e9836f2a0138f9589d0",
      "kind": "dialogue",
      "ko": "에에? 타마모 님은 그쪽에 없어.\n이쪽에서 기척이 느껴지니까 이쪽이야!",
      "message_index_0based": 22,
