    {
      "command": "",
      "draft_row_sha256": "d9e6d2e494622b603a5e84d60f9792a7d6b2e2fec194a1334dd49f14e5bcb0d0",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "こうなったらもう……美少年、あなたを捕らえて、\n隣国へ売り飛ばして差し上げますわ！！\nそこのモンスター娘どものはく製と共に！！",
      "jp_sha256": "3ae662b5152940b9b25254c6fe985a9cdfbef79b7282145f6321b5168da0e76f",
      "kind": "dialogue",
      "ko": "이렇게 된 이상…… 미소년, 당신을 붙잡아서\n이웃 나라에 팔아넘기겠어요!!\n거기 몬스터 소녀들의 박제와 함께!!",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 54,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b011-20261107-ff47d2c5b69e",
