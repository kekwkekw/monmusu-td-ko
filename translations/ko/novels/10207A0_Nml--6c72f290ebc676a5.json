    {
      "command": "",
      "draft_row_sha256": "d6f19c0c20df900d4fe972db63ae8ca9ebb33f60b608699b4ac0ce0e4c23ca0d",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そうそう！　ヒーローは悪党退治だけじゃないんだよね！\n困ってる人を助けてあげる事だってヒーロー活動だよ！\nさあさあ、僕に何でも言って！",
      "jp_sha256": "d54de181683eeca9f45fa4bb8efc857776be97ab3d427d2cb21b1ce2d1878b61",
      "kind": "dialogue",
      "ko": "맞아, 맞아!　히어로는 악당 퇴치만 하는 게 아니거든!\n곤란한 사람을 도와주는 것도 히어로 활동이야!\n자, 자, 나한테 뭐든 말해!",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 21,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
