      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それでね、ご主人さま。\nモンスター娘化した獣神を、もうひとり探して保護して欲しいの。",
      "jp_sha256": "95561d4d194b7b2708ad167e9c3f6b7da0cdf342bfdd10714800445dd539f480",
      "kind": "dialogue",
      "ko": "그래서 말인데, 주인님.\n몬스터 소녀가 된 수신을 한 명 더 찾아서 보호해 줬으면 해.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 36,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "1f843f061fd452d30be61ac2660c86f91a0d66910e799381dc3359c5b7e30851:000001_-1386789646088449064:g0:r35",
