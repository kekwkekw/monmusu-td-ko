      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "9c3465fa7994e826fed7b21ccc4da58ffd12f4eab9ea8bfee47b3c7e6e36992c",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "探して欲しいのは獣神パズズ娘シィール。\n正確な居場所は分からないけれど、\nビーチに１つ、山岳地帯の方からは２つの強い気配を感じるわ。",
      "jp_sha256": "b98d75d6155201582da8760a3063aa09248d703aae048ff4f1af63025960cf51",
