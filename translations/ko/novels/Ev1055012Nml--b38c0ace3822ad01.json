    {
      "command": "",
      "draft_row_sha256": "8d40ee3ddaf9834060de38bac65de9629213768fff36abf38ca52913111b6924",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "モンスター娘化した獣神って、超レアでしょう？\nさっきみたいな一攫千金を狙う密猟者に追われて、\nビクビクして過ごしてるみたいだから。",
      "jp_sha256": "e0d70cdb16f0cba90af89ece9911566f0edaada1695d2f0f7cb3f1af585583be",
      "kind": "dialogue",
      "ko": "몬스터 소녀가 된 수신은 엄청 희귀하잖아?\n아까처럼 일확천금을 노리는 밀렵꾼에게 쫓겨,\n벌벌 떨며 지내는 모양이거든.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 37,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
      "review_note": "",
      "review_status": "reviewed",
