      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "しばし逡巡した後、僕は仲間たちから離れ\nハギナさんが向かった方へと歩き出したのだった。",
      "jp_sha256": "164f4736a1fcc7be62144d87984eda4a637d7bea36f889d2deaf5e6e7aa68cb1",
      "kind": "dialogue",
      "ko": "잠시 망설인 뒤 나는 동료들 곁에서 벗어나\n하기나 씨가 향한 쪽으로 걸음을 옮겼다.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 26,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
