      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "1ac2c090eb76dd9f59049c5afe90cabee786abf972044f3aa66e0d849a452e06",
