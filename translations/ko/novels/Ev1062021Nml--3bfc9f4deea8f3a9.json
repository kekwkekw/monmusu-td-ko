      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "563203e0ad62156d6a3bc9a3a965918c60a6e93db4148713c67eb7c933fc0d2d",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あれ？　ご主人様？　こんな森の奥までどうしたんですか？",
      "jp_sha256": "1cb49b0492f5680d0d87ebed411b9c89e96da864630a214c5f92f22f88a0286b",
      "kind": "dialogue",
      "ko": "어라? 주인님? 이런 숲속 깊은 곳까지 무슨 일이세요?",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 30,
