      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ちょっ！？\n倒れた密猟者にハエがたかって……！？　やめさせなさいよ！",
      "jp_sha256": "cd7992945657677808741c665a713d7c5fefa01567ff7c7adb1878d7176780f5",
      "kind": "dialogue",
      "ko": "잠깐!?\n쓰러진 밀렵꾼에게 파리가 꼬이잖아……!? 멈추게 해!",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 19,
