      "grid_message_index_0based": 1,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ひぃぃっ！　なんなんだ、あの矢は！？\n撤退！　撤退だぁっ！\n倒れたヤツは捨てていけ！　逃げろぉぉっ！",
      "jp_sha256": "c471a28dcfe8ef6b06502ac8adc728991954923439c07f23bcde754f79b09a1d",
      "kind": "dialogue",
      "ko": "히이익! 뭐야, 저 화살은!?\n후퇴! 후퇴다!\n쓰러진 놈은 버리고 가! 도망쳐어어!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 50,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "b929afc4ee1184a338b5d628699d0f8c7429f58a244854edf72eaff517706757:000002_397562588412308338:g0:r49",
      "row_index_0based": 49,
      "serialized_row_index": 49,
      "source_cells": [
