      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "うわぁ……そう露骨だと逆に引いちゃいます……。\nそれに女なら何でもいいみたいな言い方も失礼ですね。\nこうなったら、もっとくすぐって情報を――。",
      "jp_sha256": "44decc1ef1e652c534b5eb5a9e84dec191b99849edc79f9998f5c137af6dfe1c",
      "kind": "dialogue",
      "ko": "우와…… 그렇게 노골적이면 오히려 정이 떨어져요…….\n게다가 여자라면 아무나 좋다는 식의 말도 실례네요.\n이렇게 된 이상 더 간질여서 정보를――.",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 30,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
