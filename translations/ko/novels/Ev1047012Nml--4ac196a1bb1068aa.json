      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "先程戦った精霊、ナス美ちゃんが主人公を見ていた。\n美しすぎる長い脚を組み替え、挑発的な視線を送ってる。",
      "jp_sha256": "6f51fbe02d24e64f9658a29efe4eda8fec050289ade012e1ee3bb59609bdf415",
      "kind": "dialogue",
      "ko": "방금 싸웠던 정령, 나스미가 주인공을 바라보고 있었다.\n너무나 아름다운 긴 다리를 바꿔 꼬며 도발적인 시선을 보냈다.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 11,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b015-20261109-3b84ed832b75",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "043050ecd37f7f9b9bd31e577f5be4b1751c714716b361ac06b46bd38d6b0363:000000_-5519160413950100450:g0:r10",
      "row_index_0based": 10,
      "serialized_row_index": 10,
      "source_cells": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
