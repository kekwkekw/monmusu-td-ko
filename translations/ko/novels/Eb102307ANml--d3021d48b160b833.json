    {
      "command": "",
      "draft_row_sha256": "251f100346eb83e3335442b3a222da765bf179ac20d2f6f20730827744f5ddca",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
