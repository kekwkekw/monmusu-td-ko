      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "4932b8b92680c6821d7122e26a3c14200720b0ae36543bc561e9fff250daa666",
