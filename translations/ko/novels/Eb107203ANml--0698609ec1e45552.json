      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "えっと……ありがとうございます。\nダムストーさんにそんな力があったなんて知りませんでした。",
      "jp_sha256": "357601fcd433dce0e67a95ea55cabf4246a8182cab0ecc64905f2a70f0736d42",
      "kind": "dialogue",
      "ko": "저기…… 감사합니다.\n담스토 씨에게 그런 힘이 있었을 줄은 몰랐어요.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 32,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
