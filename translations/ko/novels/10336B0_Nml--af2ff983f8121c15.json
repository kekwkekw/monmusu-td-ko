      "jp_sha256": "568e6214fffea207593ed8321dde5324d89f1f75ca86fc7430e8ae2ec799ab69",
      "kind": "dialogue",
      "ko": "보니 아즈레아 씨와 이야기하는 상대는,\n낯선 시 엘프 소녀라는 걸 알 수 있었다.",
      "message_index_0based": 2,
      "page_ctrl": "",
      "physical_line_1based": 12,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
