      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それが、私にもさっぱりなのだ。\nいつものように砂漠で\n『伝説のスフィンクス娘ちゃん人形』を探していたら……。",
      "jp_sha256": "b815704aab455279a55250e04e632a5b2ec7a2e2cd3d6e029011e11854e37aa7",
      "kind": "dialogue",
      "ko": "그게 나도 전혀 모르겠다.\n평소처럼 사막에서\n『전설의 스핑크스 소녀 인형』을 찾고 있었는데…….",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 8,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
