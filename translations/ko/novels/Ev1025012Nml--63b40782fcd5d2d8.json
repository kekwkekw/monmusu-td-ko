    {
      "command": "",
      "draft_row_sha256": "93a98f72b59ccf90f902b7791f2f849c2de9710ab0c69cc9aa914e1cb895ad5b",
      "grid_index": 0,
      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "本来はゴール間際にも設置しておいたんだよ。\nで、たどり着いた美少年が全裸で、\n服を取り戻して……うんぬんかんぬん。",
      "jp_sha256": "4e312eddec3f097f7ad72f6784957a6f134973950229033ec3e420368f146691",
      "kind": "dialogue",
      "ko": "원래는 결승점 근처에도 설치해 뒀어.\n그리고 도착한 미소년이 알몸으로\n옷을 되찾고…… 이러쿵저러쿵.",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 15,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
      "review_note": "",
      "review_status": "reviewed",
