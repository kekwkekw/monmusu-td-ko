      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "よし、完了。おらよ、受け取れ。\nこのスライムは溶かした服を再生する能力を持っててな。",
      "jp_sha256": "919379df0954e4ef86fa11760247ea70f203f0d4f197eb96e0bcafe7cad253c8",
      "kind": "dialogue",
      "ko": "좋아, 완료. 자, 받아.\n이 슬라임은 녹인 옷을 재생하는 능력이 있거든.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 14,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
