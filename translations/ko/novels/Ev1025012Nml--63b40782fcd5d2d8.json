      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "――ふぅ。ようやく落ち着けましたよ。\nシャツと短パンだけっていうのが、ちょっとアレですけど。",
      "jp_sha256": "a6c1b611117c0e0942fc2cba87081318a5fe8afae43d4e082eb7d82a9d9bae95",
      "kind": "dialogue",
      "ko": "――후우. 드디어 안심했어요.\n셔츠와 반바지만이라는 게 조금 그렇지만요.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 16,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
