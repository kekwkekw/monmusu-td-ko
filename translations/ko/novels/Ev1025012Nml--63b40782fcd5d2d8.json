        ""
      ],
      "speaker": "ベルティオ",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "37c9e120091078854737b49973865acc052d5d8657597148d86c7dd885884719",
