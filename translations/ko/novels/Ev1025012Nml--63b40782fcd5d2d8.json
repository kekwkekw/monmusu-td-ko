      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "61184f91cc1c841dde7e467ca89fb4fb3262b3bcfff040ad9d17a4250474e294",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "誰がドヘンタイ娘だ！　アタシはドヴェルグ娘だ！　馬鹿やろう！\nアタシの話を最後まで聞けよ、せっかくトラップについての\n素晴らしい仕組みについて聞かせてやってんのに！",
      "jp_sha256": "0fa1f75448f634a1e190fa2e5230c5da32dfadc680fec185b1819543818c5ca4",
      "kind": "dialogue",
      "ko": "누가 변태 소녀야! 나는 드베르그 소녀다! 바보야!\n내 이야기를 끝까지 들어, 모처럼 트랩의\n훌륭한 구조를 설명해 주고 있는데!",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 33,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b014-20261109-same-model-pass2-501bd9d2-hold15",
      "review_note": "",
      "review_status": "reviewed",
