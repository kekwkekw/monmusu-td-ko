      "inline_tags": [
        {
          "end": 54,
          "raw": "<interval=8>",
          "start": 42
        }
      ],
      "jp": "ぬしちゃんのために特別に調合したお茶だぞ。\n薬草や花、少しだけ果実の皮も入れておる。<interval=8>\nぬしちゃんが飲んだらどんな風になるのか考えながら作ったのだ。",
      "jp_sha256": "5b6346069ca66a3cc334ff7ace36d74d82562b98b3eeaa573728afb3f3761c69",
      "kind": "dialogue",
      "ko": "주인쨩을 위해 특별히 배합한 차다.\n약초와 꽃, 과일 껍질도 조금 넣었지.<interval=8>\n주인쨩이 마시면 어떻게 될지 생각하면서 만들었다.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 22,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "a07db9d01df6aaa74136dc9ec39b06eb9a3cd1f0e8562fb0c2e65f17e56b34e7:000002_1907978355731717370:g0:r21",
      "row_index_0based": 21,
