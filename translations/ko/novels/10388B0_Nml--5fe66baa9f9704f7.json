    {
      "command": "",
      "draft_row_sha256": "ba4d2a081ccc5055ffcd8fa9ed86ae1f8e99e38cc670e898ca41b8fc665b6eb2",
      "grid_index": 0,
      "grid_message_index_0based": 8,
