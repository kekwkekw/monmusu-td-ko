    {
      "command": "",
      "draft_row_sha256": "3dea9fff414f50a697e6c8ab7f629caef593e32b9a1e06b0d0d0d3bad211aafc",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そんな風に優雅に言われて、どきりとした。\nまるで僕のことをよく知っているとでもいうような、\n艶のある声音だった。",
