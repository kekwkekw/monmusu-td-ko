    {
      "command": "",
      "draft_row_sha256": "2dad9b087049388819d513115b63b1328d463390f19362a3771c301fb5ea86c2",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ほのかに花や果実が薫るなか、\n妖しい香りがわずかに混ざっているのはそのせいだ。",
      "jp_sha256": "818d651a8199e0d830e6fe19d32f4ae2f3294d448319dfb1bfacafc16e87f3d7",
      "kind": "dialogue",
      "ko": "은은한 꽃과 과일 향기 속에,\n요사스러운 향이 살짝 섞인 건 그 때문이다.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 23,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
