    },
    {
      "command": "",
      "draft_row_sha256": "fbf61ac6cbd2ac7db7093a71d1068cadfa6a7c2e0f26d6ba0930cf675ef62b33",
      "grid_index": 0,
      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あはは……すみません、驚いたのでつい。\nでも、本当にありがとうございます。\nロトーナさんが一緒じゃなきゃ危ないところでした。",
      "jp_sha256": "271519e7b13ec0f5b68350d1983661e1b6c906e53f55743b3448a99180a125f7",
      "kind": "dialogue",
      "ko": "아하하…… 죄송해요, 놀라서 저도 모르게.\n하지만 정말 감사합니다.\n로토나 씨가 함께 아니었다면 위험할 뻔했어요.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 20,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
