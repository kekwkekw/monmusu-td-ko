      "grid_message_index_0based": 0,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "島を巡回していた僕は、偶然現れた\nモンスターの一団と遭遇してしまった。\nしかし、幸運なことにロトーナさんが同行しており……。",
      "jp_sha256": "5e159fb6d0899cc5efa8049702849093998dd8fe54ef1384438d8bbb35303a8b",
      "kind": "dialogue",
      "ko": "섬을 순찰하던 나는 우연히 나타난\n몬스터 무리와 마주치고 말았다.\n하지만 다행히도 로토나 씨가 동행하고 있었고…….",
      "message_index_0based": 0,
      "page_ctrl": "",
      "physical_line_1based": 8,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b003-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
