      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "50e2ee30a8c4da63a402c20df04f7dc3a42efa760be6a9852e9da1d47ad767bc",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "それは、そうなのだが……。\nうーむ、私はご主人様の手足となって働くこと\n自体は受け入れているのだ。",
