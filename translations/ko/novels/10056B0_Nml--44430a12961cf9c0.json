    {
      "command": "",
      "draft_row_sha256": "592bc33ab6306cdec279c810d9df8c80d7841fa061f0c646c13c330a93232fa5",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そ、それはどうも……。\nでも、そこまで認めてくれるのなら、\nなんでいつも「裏切るぞー！」って言っているんですか？",
