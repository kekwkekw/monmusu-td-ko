    {
      "command": "",
      "draft_row_sha256": "151f49ad7ff21ded35c33014b625d9bfc6f76ffc23224898a14aba17a1965ff8",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "お前は優しく、知略に優れ、器が大きい。\nしかも、可愛いしな。……いや、とても可愛いしな。\n主人としては申し分のない男だ。",
      "jp_sha256": "864d204453b8f3ace49c1a4f2bb76384b9e8e053708a31bae5802b00ab535955",
      "kind": "dialogue",
      "ko": "너는 상냥하고 지략이 뛰어나며 그릇도 크다.\n게다가 귀엽고. ……아니, 아주 귀엽고.\n주인으로서는 나무랄 데 없는 남자다.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 47,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
