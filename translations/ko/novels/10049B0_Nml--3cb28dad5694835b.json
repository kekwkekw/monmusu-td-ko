    {
      "command": "",
      "draft_row_sha256": "0a1bd373de9ec369a4e0f6128d0f7fe1adee0a4f04de7f32a07058edef0aad90",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "まさか、昼前に出発して到着が夜になるとは\n思いませんでしたけどね……。\nフェニックス娘って、こういう高い場所が好きなんですか？",
      "jp_sha256": "360cf65ed1611581a77385d0cbe9f9bff0ab6ed9c659d7d3e25404290d68a5b9",
      "kind": "dialogue",
      "ko": "설마 낮 전에 출발했는데 도착하니 밤이 될 줄은\n몰랐지만요…….\n피닉스 소녀는 이런 높은 곳을 좋아하나요?",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 35,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b002-20261105-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "022dde28a756f4774266eeb1f054efe00cb5373585c61f41af0cfa0ed23b6dc5:000001_-1445154555871993978:g0:r34",
      "row_index_0based": 34,
