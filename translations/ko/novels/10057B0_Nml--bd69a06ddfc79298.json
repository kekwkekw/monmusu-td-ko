    {
      "command": "",
      "draft_row_sha256": "5cd3e669f4ccb37c6ada563817928c46636728385bc68e191d39075c7e0bebe9",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ああ、そういうことね！\nせっかく湖に来たんだし……、\nご主人くんに見せるならこれかしら！",
      "jp_sha256": "4d22b1dde2df19ec8ada964c7d65e7b8d3c4b8d0b1723fe1cfda7dd751a4ab40",
      "kind": "dialogue",
      "ko": "아아, 그런 뜻이구나!\n모처럼 호수에 왔으니까……,\n주인 군에게 보여 줄 거라면 이거겠네!",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 58,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
