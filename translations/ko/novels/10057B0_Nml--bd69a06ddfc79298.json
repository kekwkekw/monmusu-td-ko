      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "0272a20e16995bd12b98ed9d4b3898fc5348e87b7a1fff8e4b495c0eaa96da99",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "自分で言い出しておいてなんだけど、\nたしかに具体性に欠ける要望ではある。\nしかし、そんな僕の言葉にサウラさんはぱっと笑顔を浮かべた。",
      "jp_sha256": "3cca12ba56ee2ee984ef67a03e0395d85a61afd819cae5f70f33c9163ba0d5ba",
      "kind": "dialogue",
      "ko": "내가 먼저 말해 놓고도,\n확실히 구체성이 부족한 부탁이다.\n하지만 그런 내 말에 사우라 씨는 활짝 웃었다.",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 45,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
