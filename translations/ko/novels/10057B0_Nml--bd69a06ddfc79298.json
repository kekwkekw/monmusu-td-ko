    {
      "command": "",
      "draft_row_sha256": "f7bb42de5b02f801854dedb4127b43d468976bb12ffbd9af30b2bb22ca976b82",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "そうですね……好きなことをしたり、得意なことをしたり……。\n僕がまだ見たことのない一面を見たいな……なんて。",
      "jp_sha256": "feed9902bb943dab1e719559bb1e8a625a4bd3bcc56f9fe071add124146aa552",
      "kind": "dialogue",
      "ko": "그렇네요…… 좋아하는 일을 하거나, 잘하는 일을 하거나…….\n제가 아직 못 본 면을 보고 싶다……랄까요.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 44,
