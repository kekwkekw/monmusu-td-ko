    {
      "command": "",
      "draft_row_sha256": "08bc0e9aefa3fd6ab21b3958971b5f676f60712d32ef309c3d8386b32fb6f289",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "意外っていうと失礼かもしれないですが、\nマギーさんがこうやって、１人で静かに星を眺めているなんて、\nちょっと珍しいと言うか、僕、正直驚きました。",
      "jp_sha256": "cd2bdf9eb60415bf548098b9ceb9ff4eaf4352270ac1788d4410fb8070586055",
      "kind": "dialogue",
      "ko": "의외라고 하면 실례일지도 모르지만\n매기 씨가 이렇게 혼자 조용히 별을 바라보다니\n조금 드문 일이라고 해야 하나, 솔직히 놀랐어요.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 34,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b006-20261106-same-model-pass2-r1",
