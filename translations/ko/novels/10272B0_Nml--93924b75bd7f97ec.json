    {
      "command": "",
      "draft_row_sha256": "5fe14cb36f6d0454cd246a9de12f0afca2f7bfc8bd60a8e1942d2507fa8cd5f8",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ふふ。いいのよ、ご主人。\nポルターガイスト娘がそう呼ばれているのは事実だから。",
      "jp_sha256": "a8728ecfbe8b2b90ae06f926889bc57b642a8b986ecda7a2d3b9046224e33e90",
      "kind": "dialogue",
      "ko": "후후. 괜찮아, 주인님.\n폴터가이스트 소녀가 그렇게 불리는 건 사실이니까.",
