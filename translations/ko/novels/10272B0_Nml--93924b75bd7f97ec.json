    {
      "command": "",
      "draft_row_sha256": "935b0b39c4e5254afcc911eb3cd0a812b3821964d4e70868ef94f25b41518c5e",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なんていうか……すごく、ゆったりとした気持ちになるの。\n心が落ち着いて……リラックスできて……、\nこういう時間も、私はすごく好きなんだ……。",
      "jp_sha256": "9366ec3862506aa3add5f216c027c0fdc78cd606f492f1db3dc313030b2adaf1",
      "kind": "dialogue",
      "ko": "뭐랄까……아주 느긋한 기분이 들어.\n마음이 차분해지고……긴장이 풀리고……\n이런 시간도 나는 정말 좋아해…….",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 33,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
