      "draft_row_sha256": "0cf460f454df7de77ca52741ba69b0d6483aa94afeb420fac7e570766b0600cc",
      "grid_index": 0,
      "grid_message_index_0based": 7,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ポデルさんの優しさに甘えすぎてしまっていいのだろうか。\nしかし、そんな僕の逡巡を見透かしたように、\nポデルさんはにかっと笑みを浮かべた。",
      "jp_sha256": "10ba05c10b57f6550d61f92771f5b5e2838eee9a4b435205b4871e0209a27b38",
      "kind": "dialogue",
      "ko": "포델 씨의 친절에 너무 기대도 되는 걸까.\n하지만 그런 내 망설임을 꿰뚫어 본 듯,\n포델 씨는 활짝 웃었다.",
      "message_index_0based": 7,
      "page_ctrl": "",
      "physical_line_1based": 15,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
