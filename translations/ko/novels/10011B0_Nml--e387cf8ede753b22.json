    {
      "command": "",
      "draft_row_sha256": "f62e0c824328930595628e8e6eb8c21c5d5f07fc78e21c41fa72d1f78d895b80",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ちゃちゃっと料理するくらい、文字通り朝飯前よ！\nそれに、オス共は狩りに行ってて誰も居ねぇからさ。\nほら行くぞ！　さーて、どう料理してやろうかなー♪",
      "jp_sha256": "0d6d801260cf5704702169656268ea1dc34ad418e35438047ea4dc9361fdfa53",
      "kind": "dialogue",
      "ko": "후딱 요리하는 것쯤 말 그대로 식은 죽 먹기지!\n게다가 수컷들은 사냥하러 가서 아무도 없어.\n자, 가자! 어떻게 요리해줄까나♪",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 44,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b001-20261105-same-model-pass2-r1",
