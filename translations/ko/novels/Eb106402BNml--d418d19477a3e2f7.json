      "kind": "dialogue",
      "ko": "하하, 마물이 도망쳐 돌아가는군.\n내 논파력에 겁을 먹은 모양이야.",
      "message_index_0based": 0,
      "page_ctrl": "",
      "physical_line_1based": 4,
