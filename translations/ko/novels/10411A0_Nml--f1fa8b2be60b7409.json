    {
      "command": "",
      "draft_row_sha256": "babea42846111c3599f81d5110b8b45c700f08684d49d6bb6274147374b444bb",
      "grid_index": 0,
      "grid_message_index_0based": 6,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ズカキナさんは口ではちょっと冷たく言いつつ、\n僕を追い返そうとはしない。\nほっとしつつ、僕は本を読んだりして過ごしていて――。",
      "jp_sha256": "789e6eaf065c8f4e8382bc227464029d16f2b3cdc0a8dbda9a60b5bc03e766d5",
      "kind": "dialogue",
      "ko": "즈카키나 씨는 말로는 조금 차갑게 말하면서도,\n나를 쫓아내려 하지는 않는다.\n안도하면서 나는 책을 읽으며 시간을 보내다가――.",
      "message_index_0based": 6,
      "page_ctrl": "",
      "physical_line_1based": 32,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
      "review_note": "",
      "review_status": "reviewed",
