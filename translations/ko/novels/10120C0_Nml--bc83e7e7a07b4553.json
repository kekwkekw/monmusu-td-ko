      "kind": "dialogue",
      "ko": "잔꾀 많은 상대와 말싸움을 해 줄 필요는 없었다.\n하지만 곁에 있는 더러운 존재――\n내 딸은 그런 것도 모르는 모양이다.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 39,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
