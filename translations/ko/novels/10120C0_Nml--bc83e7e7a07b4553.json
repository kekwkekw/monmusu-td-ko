      ],
      "speaker": "",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "b265b72682b81b8a45b66d3f1bf988dcacbd5930502c47ab7919948bf9518fae",
