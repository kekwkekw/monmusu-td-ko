      ],
      "speaker": "",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "d97e8f4dd374bd3f8658d7fb4a82516d6304982c2d63e6d1a60ba345b454e89c",
