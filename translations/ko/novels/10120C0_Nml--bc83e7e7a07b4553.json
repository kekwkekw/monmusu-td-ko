      "review_status": "reviewed",
      "row_id": "93f7c1b83c7590ea91ab0b4a0065b1399acac33987cc926339abcc2da2ef0c33:000000_-5477027996146502178:g0:r28",
      "row_index_0based": 28,
      "serialized_row_index": 28,
      "source_cells": [
        "",
        "",
        "",
        "",
        "",
        "",
