        "ch_10336/R18/10336A0_10336_Nml/10336A0_10336_001",
        ""
      ],
      "speaker": "アズレア",
      "translation_status": "translated",
      "voice": "ch_10336/R18/10336A0_10336_Nml/10336A0_10336_001"
