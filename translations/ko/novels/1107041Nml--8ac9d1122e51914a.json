      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "うげげっ……どうしてオマエらがここにいるのさ！？\nしかもボクが送った先発隊までボコボコにしちゃうなんてさ！",
      "jp_sha256": "cc0d96e903a561f4d5bd63861420b49a6bd2e557f7233954150eea225866e9f3",
      "kind": "dialogue",
      "ko": "우게엑…… 왜 너희가 여기에 있는 거야!?\n게다가 내가 보낸 선발대까지 흠씬 두들겨 패다니!",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 15,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b010-20261107-same-model-pass2-r1",
