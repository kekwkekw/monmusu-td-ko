      "draft_row_sha256": "e1fdac2bfd386e27e619e0a9473a48dfafb532cc601326a9a74ca0b9ae82569a",
      "grid_index": 0,
      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "ふ、ふーんだ！　ふんぞり返っていられるのも今のうちだからな！\nその最強兵器が、この先の樹氷宮殿に眠ってるなんて\nジョウホウはボクしか知らないコトなんだからさ。",
      "jp_sha256": "92c97f2cb3c44d4cb5fb3dac44addc17906ab6fee11f8f2d81dd84747e94b889",
      "kind": "dialogue",
      "ko": "흐, 흥이다! 그렇게 거들먹거릴 수 있는 것도 지금뿐이야!\n그 최강 병기가 이 앞의 수빙 궁전에 잠들어 있다는\n정보는 나만 아는 거니까.",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 26,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b010-20261107-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "115516f8c751a8aaff810c74876ea9945909641b2f4b32bb652d551b0b26ffe5:000002_1603762357333773477:g0:r25",
      "row_index_0based": 25,
