    {
      "command": "",
      "draft_row_sha256": "f788500fe56a97040c853ca12e8ce259739bace53333ab944f0f09f5c005047f",
      "grid_index": 0,
      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
