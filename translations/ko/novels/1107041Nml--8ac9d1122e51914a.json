    {
      "command": "",
      "draft_row_sha256": "b38591ed3df563600c1beb4005f36f153952367a005522c38ac1c61198a49452",
      "grid_index": 0,
      "grid_message_index_0based": 9,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "なるほど、最強兵器が樹氷宮殿に……。\nだからカティナさんやリンデンハートさんは、\n僕らが樹氷宮殿に入ることを禁じていたんですね。",
      "jp_sha256": "8a18f607d3b905cfd82ed3d79e8027750c643cc61f3f4fbae2280c3abd46ff9d",
      "kind": "dialogue",
      "ko": "그렇군요, 최강 병기가 수빙 궁전에…….\n그래서 카티나 씨와 린덴하트 씨가\n저희가 수빙 궁전에 들어가는 걸 금지했군요.",
      "message_index_0based": 9,
      "page_ctrl": "",
      "physical_line_1based": 27,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b010-20261107-same-model-pass2-r1",
