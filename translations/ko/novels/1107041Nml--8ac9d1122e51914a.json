      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "お前こそ、なんで大陸にいるんだよ。また良からぬことでも\n企んでるんだろ？　どうせ失敗してソレイアに\nお説教されるだけなんだからやめとけって、な？",
      "jp_sha256": "981dae9bc59ac993c8e6a0bcc18529b9c13f172330d1474bdfaea05177e003c4",
      "kind": "dialogue",
      "ko": "너야말로 왜 대륙에 있는 거야. 또 못된 일이라도\n꾸미고 있지? 어차피 실패해서 소레이아한테\n설교만 들을 테니까 그만두라고, 응?",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 20,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "monmusu-pro-b010-20261107-same-model-pass2-r1",
      "review_note": "",
      "review_status": "reviewed",
