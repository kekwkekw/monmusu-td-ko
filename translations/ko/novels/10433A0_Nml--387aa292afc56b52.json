        "",
        "",
        "",
        "",
        "",
        "",
        "というかムイさんも宴会に参加してたんですか、意外ですね。"
      ],
      "speaker": "主人公",
      "translation_status": "translated",
      "voice": ""
    },
    {
      "command": "",
      "draft_row_sha256": "230bf0290baa5d5899ae0a373de8de1cac7e53720008098a07c1cb41c2b4e52b",
      "grid_index": 0,
      "grid_message_index_0based": 11,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "あっ、私、ホヅキの遠い親戚なんです。\nだからお酒も大好きで……えへへ。",
