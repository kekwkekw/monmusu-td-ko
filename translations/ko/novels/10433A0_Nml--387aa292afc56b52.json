      "grid_message_index_0based": 4,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "いえ、気にしないでください。\n掃除くらいならいつもやってますし……でもなんで牢屋にこんな。",
      "jp_sha256": "d7b01a084bb64ee74674c9cb1b5953d55693ca3d35d7c1157caeee6af164a960",
      "kind": "dialogue",
      "ko": "아니요, 신경 쓰지 마세요.\n청소 정도는 늘 하니까요…… 그런데 왜 감옥에 이런 게.",
      "message_index_0based": 4,
      "page_ctrl": "",
      "physical_line_1based": 15,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
