      "grid_message_index_0based": 8,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "朝まで盛り上がって、はしゃいでしまって。\nその結果、このような惨状に……本当に申し訳ないです……。",
      "jp_sha256": "f5827b97379db536b7e07581e10df6ae02baaee3947eebb6e7a604e39789980c",
      "kind": "dialogue",
      "ko": "아침까지 들떠서 놀아 버렸습니다.\n그 결과 이런 참상이…… 정말 죄송합니다…….",
      "message_index_0based": 8,
      "page_ctrl": "",
      "physical_line_1based": 31,
