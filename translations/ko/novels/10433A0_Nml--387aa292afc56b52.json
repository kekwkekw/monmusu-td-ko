      "grid_message_index_0based": 5,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "この場所を選んだのは、\n「牢屋で飲むの面白いだち！」というある方の意見で……。",
      "jp_sha256": "08ebeadb3a7066fcb1a087900f462d4eeb30bb9acd5ba6f55afbe3e158a039b6",
      "kind": "dialogue",
      "ko": "이곳을 고른 건,\n‘감옥에서 마시면 재미있다치!’라는 어느 분의 의견으로…….",
      "message_index_0based": 5,
      "page_ctrl": "",
      "physical_line_1based": 17,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
