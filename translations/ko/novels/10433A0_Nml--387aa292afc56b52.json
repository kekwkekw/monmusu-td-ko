      "grid_message_index_0based": 10,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "というかムイさんも宴会に参加してたんですか、意外ですね。",
      "jp_sha256": "6f6d5cb3cd1bd5dde84fa993fb606a99e066ba83e59729f45ea5e351c41a7a8d",
      "kind": "dialogue",
      "ko": "그보다 무이 씨도 연회에 참가했군요, 의외네요.",
      "message_index_0based": 10,
      "page_ctrl": "",
      "physical_line_1based": 41,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
