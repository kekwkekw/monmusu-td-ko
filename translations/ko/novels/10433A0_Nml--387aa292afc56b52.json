      "grid_message_index_0based": 3,
      "header_row_index_0based": 0,
      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "お疲れさまです、主さま。\nすみません、このような些事をお願いしてしまって……。",
      "jp_sha256": "d017b511a4957bb179fe8efe59e5dbffa59307bf0e91caffb6a935b2e3372862",
      "kind": "dialogue",
      "ko": "수고가 많으십니다, 주인님.\n죄송합니다, 이런 사소한 일을 부탁드려서…….",
      "message_index_0based": 3,
      "page_ctrl": "",
      "physical_line_1based": 13,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
      "review_note": "",
      "review_status": "reviewed",
