      "hold": false,
      "hold_placeholder": null,
      "inline_tags": [],
      "jp": "おアホのご主人様へ\n雪山にクリスマスイルミネーションができました。",
      "jp_sha256": "c64c1356e45442658565387422faad1ed00f45903b9e9aafa3a91051c882222d",
      "kind": "dialogue",
      "ko": "바보 주인님께\n설산에 크리스마스 일루미네이션이 생겼습니다.",
      "message_index_0based": 1,
      "page_ctrl": "",
      "physical_line_1based": 28,
      "policy_sha256": "b5e7fd3e9caca00c1d40cf24880559ba1b79d6fec6b53af3006698eb26c34f6b",
      "reason": "",
      "review_id": "pro-b009-20261106-99345c75ed114c6d",
      "review_note": "",
      "review_status": "reviewed",
      "row_id": "7553b35e22cb8939055a4e9037d18258bf0659bf45e9591f768ccc640bda9230:000002_8821179463597851136:g0:r27",
      "row_index_0based": 27,
      "serialized_row_index": 27,
      "source_cells": [
        "",
        "",
        "ニホ",
        "Emt1_Nor",
        "layer_中",
        "",
        "",
        "0.3",
        "",
        "おアホのご主人様へ\n雪山にクリスマスイルミネーションができました。",
        "",
        "ch_10387/R18/10387A0_10387_Nml/10387A0_10387_001",
        ""
      ],
      "speaker": "ニホ",
      "translation_status": "translated",
      "voice": "ch_10387/R18/10387A0_10387_Nml/10387A0_10387_001"
    },
    {
      "command": "",
      "draft_row_sha256": "e1d9032fec0a7812e5169740e0c9eecdc73f733ce59c96539ee6c6866af88d23",
